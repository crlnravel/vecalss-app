// LEARNING MODULES
// ─────────────────────────────────────────────

model Module {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId          String        @map("topic_id") @db.Uuid
  code             String        @unique @db.VarChar(80)
  title            String        @db.VarChar(220)
  summary          String?       @db.Text
  sequenceNo       Int           @map("sequence_no")
  estimatedMinutes Int?          @map("estimated_minutes")
  status           ContentStatus @default(draft)
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz
  createdByUserId  String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?       @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  topic     Topic         @relation(fields: [topicId], references: [id])
  createdBy User?         @relation("ModuleCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy User?         @relation("ModuleUpdatedBy", fields: [updatedByUserId], references: [id])
  assets    ModuleAsset[]

  // Explicit self many-to-many configurations
  prerequisites ModulePrerequisite[] @relation("DependentModules")
  requiredBy    ModulePrerequisite[] @relation("PrerequisiteModules")

  progressions            ModuleProgress[]
  quiz                    ModuleQuiz?
  learningRecommendations LearningRecommendation[]
  weaknessAnalysisTopics  WeaknessAnalysisTopic[]
  interventions           Intervention[]

  @@unique([topicId, sequenceNo])
  @@index([status])
  @@map("modules")
}

model ModuleAsset {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId        String                 @map("module_id") @db.Uuid
  assetType       ModuleAssetType        @map("asset_type")
  sourceKind      ModuleAssetSourceKind? @map("source_kind")
  managedAssetId  String?                @map("managed_asset_id") @db.Uuid
  title           String?                @db.VarChar(220)
  bodyText        String?                @map("body_text") @db.Text
  mediaUrl        String?                @map("media_url") @db.Text
  mimeType        String?                @map("mime_type") @db.VarChar(120)
  originalName    String?                @map("original_name") @db.VarChar(255)
  durationSeconds Int?                   @map("duration_seconds")
  sortOrder       Int                    @default(0) @map("sort_order")
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz

  module       Module @relation(fields: [moduleId], references: [id])
  managedAsset Asset? @relation("ModuleAssetManagedAsset", fields: [managedAssetId], references: [id], onDelete: Restrict)

  @@unique([moduleId, sortOrder])
  @@index([managedAssetId])
  @@index([moduleId, assetType])
  @@map("module_assets")
}

model ModulePrerequisite {
  moduleId             String @map("module_id") @db.Uuid
  prerequisiteModuleId String @map("prerequisite_module_id") @db.Uuid

  module             Module @relation("DependentModules", fields: [moduleId], references: [id])
  prerequisiteModule Module @relation("PrerequisiteModules", fields: [prerequisiteModuleId], references: [id])

  @@id([moduleId, prerequisiteModuleId])
  @@map("module_prerequisites")
}

model ModuleProgress {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String         @map("student_id") @db.Uuid
  moduleId             String         @map("module_id") @db.Uuid
  status               ProgressStatus @default(locked)
  percentComplete      Decimal        @default(0) @map("percent_complete") @db.Decimal(5, 2)
  videoPositionSeconds Int            @default(0) @map("video_position_seconds")
  scrollPosition       Int            @default(0) @map("scroll_position")
  unlockedAt           DateTime?      @map("unlocked_at") @db.Timestamptz
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz
  lastOpenedAt         DateTime?      @map("last_opened_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student User   @relation(fields: [studentId], references: [id])
  module  Module @relation(fields: [moduleId], references: [id])

  @@unique([studentId, moduleId])
  @@index([status])
  @@map("module_progress")
}

// ─────────────────────────────────────────────
// QUESTION BANKS
// ─────────────────────────────────────────────

model QuestionBank {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String              @unique @db.VarChar(100)
  name            String              @db.VarChar(200)
  description     String?             @db.Text
  folderId        String?             @map("folder_id") @db.Uuid
  mediaFolderId   String?             @unique @map("media_folder_id") @db.Uuid
  purpose         QuestionBankPurpose
  status          ContentStatus       @default(published)
  revision        Int                 @default(1)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  updatedByUserId String              @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz

  createdBy                                User                                      @relation("QuestionBankCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                                User                                      @relation("QuestionBankUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  folder                                   QuestionBankFolder?                       @relation(fields: [folderId, purpose], references: [id, purpose], onDelete: Restrict)
  mediaFolder                              MediaFolder?                              @relation("QuestionBankMediaFolder", fields: [mediaFolderId], references: [id], onDelete: Restrict)
  mediaFolderReservation                   QuestionBankMediaFolderReservation?       @relation("QuestionBankMediaFolderReservationBank")
  categories                               QuestionBankCategoryAssignment[]
  questions                                Question[]
  sourceQuizzes                            StandaloneQuiz[]
  sourceQuizVersions                       StandaloneQuizVersion[]                   @relation("StandaloneQuizVersionSourceBank")
  reusableQuestionPackages                 ReusableQuestionPackage[]                 @relation("ReusablePackageSourceBank")
  reusableQuestionPackageVersions          ReusableQuestionPackageVersion[]          @relation("ReusablePackageVersionSourceBank")
  reusableQuestionPackageVersionBankScopes ReusableQuestionPackageVersionBankScope[]

  @@index([folderId])
  @@index([folderId, purpose])
  @@index([purpose, status])
  @@map("question_banks")
}

model QuestionBankMediaFolderReservation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  mediaFolderId   String   @unique @map("media_folder_id") @db.Uuid
  provisionalName String   @map("provisional_name") @db.VarChar(160)
  adoptedBankId   String?  @unique @map("adopted_bank_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner       User          @relation("QuestionBankMediaFolderReservationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  mediaFolder MediaFolder   @relation("QuestionBankMediaFolderReservationFolder", fields: [mediaFolderId], references: [id], onDelete: Restrict)
  adoptedBank QuestionBank? @relation("QuestionBankMediaFolderReservationBank", fields: [adoptedBankId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, adoptedBankId])
  @@map("question_bank_media_folder_reservations")
}

model QuestionBankXlsxImportAttempt {
  id                         String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId                String                             @map("owner_user_id") @db.Uuid
  state                      QuestionBankXlsxImportAttemptState @default(upload_pending)
  originalFileName           String                             @map("original_file_name") @db.VarChar(255)
  uploadObjectKey            String                             @unique @map("upload_object_key") @db.VarChar(512)
  stagingPrefix              String                             @map("staging_prefix") @db.VarChar(512)
  multipartUploadId          String?                            @map("multipart_upload_id") @db.VarChar(1024)
  expectedWorkbookSizeBytes  Int?                               @map("expected_workbook_size_bytes")
  expectedMultipartPartCount Int?                               @map("expected_multipart_part_count")
  cancelRequestedAt          DateTime?                          @map("cancel_requested_at") @db.Timestamptz
  operationLeaseExpiresAt    DateTime?                          @map("operation_lease_expires_at") @db.Timestamptz
  manifestObjectKey          String?                            @unique @map("manifest_object_key") @db.VarChar(512)
  stagedObjectKeys           Json                               @default("[]") @map("staged_object_keys") @db.JsonB
  previewImageIndex          Json                               @default("[]") @map("preview_image_index") @db.JsonB
  workbookSha256             String?                            @map("workbook_sha256") @db.VarChar(64)
  workbookSizeBytes          Int?                               @map("workbook_size_bytes")
  manifestSha256             String?                            @map("manifest_sha256") @db.VarChar(64)
  questionCount              Int                                @default(0) @map("question_count")
  imageCount                 Int                                @default(0) @map("image_count")
  targetBankId               String?                            @map("target_bank_id") @db.Uuid
  targetMode                 String?                            @map("target_mode") @db.VarChar(16)
  mediaFolderReservationId   String?                            @map("media_folder_reservation_id") @db.Uuid
  result                     Json?                              @db.JsonB
  lastErrorCode              String?                            @map("last_error_code") @db.VarChar(80)
  uploadExpiresAt            DateTime                           @map("upload_expires_at") @db.Timestamptz
  previewExpiresAt           DateTime?                          @map("preview_expires_at") @db.Timestamptz
  expiresAt                  DateTime                           @map("expires_at") @db.Timestamptz
  completedAt                DateTime?                          @map("completed_at") @db.Timestamptz
  createdAt                  DateTime                           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner  User                                 @relation("QuestionBankXlsxImportAttemptOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  assets QuestionBankXlsxImportAttemptAsset[]

  @@index([ownerUserId, expiresAt])
  @@index([state, expiresAt])
  @@index([targetBankId])
  @@map("question_bank_xlsx_import_attempts")
}

model QuestionBankXlsxImportAttemptAsset {
  id            String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId     String                           @map("attempt_id") @db.Uuid
  assetId       String                           @unique @map("asset_id") @db.Uuid
  contentSha256 String                           @map("content_sha256") @db.VarChar(64)
  objectKey     String                           @unique @map("object_key") @db.VarChar(512)
  mimeType      String                           @map("mime_type") @db.VarChar(120)
  sizeBytes     Int                              @map("size_bytes")
  width         Int
  height        Int
  state         QuestionBankXlsxImportAssetState @default(pending)
  createdAt     DateTime                         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  attempt QuestionBankXlsxImportAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  asset   Asset                         @relation("QuestionBankXlsxImportAttemptAsset", fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([attemptId, contentSha256])
  @@index([attemptId, state])
  @@map("question_bank_xlsx_import_attempt_assets")
}

model Question {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String          @unique @db.VarChar(120)
  questionBankId     String?         @map("question_bank_id") @db.Uuid
  materi             String?         @db.VarChar(200)
  subtestId          String?         @map("subtest_id") @db.Uuid
  topicId            String?         @map("topic_id") @db.Uuid
  stem               String          @db.Text
  questionType       QuestionType    @default(single_choice) @map("question_type")
  difficulty         DifficultyLevel @default(medium)
  explanation        String?         @db.Text
  promptAssetId      String?         @map("prompt_asset_id") @db.Uuid
  explanationAssetId String?         @map("explanation_asset_id") @db.Uuid
  status             ContentStatus   @default(draft)
  source             String?         @db.VarChar(120)
  revision           Int             @default(1)
  currentRevisionId  String          @unique @map("current_revision_id") @db.Uuid
  createdByUserId    String          @map("created_by_user_id") @db.Uuid
  updatedByUserId    String          @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  questionBank                QuestionBank?                        @relation(fields: [questionBankId], references: [id], onDelete: Restrict)
  subtest                     Subtest?                             @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  topic                       Topic?                               @relation(fields: [topicId], references: [id])
  promptAsset                 Asset?                               @relation("QuestionPromptAsset", fields: [promptAssetId], references: [id], onDelete: Restrict)
  explanationAsset            Asset?                               @relation("QuestionExplanationAsset", fields: [explanationAssetId], references: [id], onDelete: Restrict)
  createdBy                   User                                 @relation("QuestionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                   User                                 @relation("QuestionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  currentRevision             QuestionRevision                     @relation("QuestionCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  revisions                   QuestionRevision[]                   @relation("QuestionRevisions")
  options                     QuestionOption[]
  quizItems                   QuizItem[]
  standaloneQuizItems         StandaloneQuizItem[]                 @relation("StandaloneQuizItemSourceQuestion")
  tryoutItems                 TryoutItem[]
  quizAnswers                 QuizAttemptAnswer[]
  dailyMissionQuestion        DailyMissionQuestion[]
  reusablePackageItems        ReusableQuestionPackageItem[]        @relation("ReusablePackageItemSourceQuestion")
  reusablePackageVersionItems ReusableQuestionPackageVersionItem[] @relation("ReusablePackageVersionItemSourceQuestion")

  @@index([topicId])
  @@index([questionBankId])
  @@index([subtestId])
  @@index([status])
  @@map("questions")
}

model QuestionRevision {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId         String                     @map("question_id") @db.Uuid
  revisionNo         Int                        @map("revision_no")
  status             QuestionRevisionStatus     @default(draft)
  provenance         QuestionRevisionProvenance @default(authored)
  materi             String?                    @db.VarChar(200)
  stem               String                     @db.Text
  questionType       QuestionType               @default(single_choice) @map("question_type")
  difficulty         DifficultyLevel            @default(medium)
  explanation        String?                    @db.Text
  promptAssetId      String?                    @map("prompt_asset_id") @db.Uuid
  explanationAssetId String?                    @map("explanation_asset_id") @db.Uuid
  contentDigest      String                     @map("content_digest") @db.VarChar(128)
  createdByUserId    String                     @map("created_by_user_id") @db.Uuid
  updatedByUserId    String                     @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  readyAt            DateTime?                  @map("ready_at") @db.Timestamptz
  retiredAt          DateTime?                  @map("retired_at") @db.Timestamptz

  question                    Question                             @relation("QuestionRevisions", fields: [questionId], references: [id], onDelete: Restrict)
  currentForQuestion          Question?                            @relation("QuestionCurrentRevision")
  promptAsset                 Asset?                               @relation("QuestionRevisionPromptAsset", fields: [promptAssetId], references: [id], onDelete: Restrict)
  explanationAsset            Asset?                               @relation("QuestionRevisionExplanationAsset", fields: [explanationAssetId], references: [id], onDelete: Restrict)
  createdBy                   User                                 @relation("QuestionRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                   User                                 @relation("QuestionRevisionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  options                     QuestionRevisionOption[]
  standaloneQuizItems         StandaloneQuizItem[]                 @relation("StandaloneQuizItemSourceQuestionRevision")
  reusablePackageItems        ReusableQuestionPackageItem[]        @relation("ReusablePackageItemSourceQuestionRevision")
  reusablePackageVersionItems ReusableQuestionPackageVersionItem[] @relation("ReusablePackageVersionItemSourceQuestionRevision")
  tryoutItems                 TryoutItem[]                         @relation("TryoutItemSourceQuestionRevision")

  @@unique([questionId, revisionNo])
  @@index([questionId, status])
  @@index([status, contentDigest])
  @@map("question_revisions")
}

model QuestionRevisionOption {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionRevisionId String  @map("question_revision_id") @db.Uuid
  label              String  @db.VarChar(8)
  content            String  @db.Text
  isCorrect          Boolean @default(false) @map("is_correct")
  sortOrder          Int     @default(0) @map("sort_order")
  assetId            String? @map("asset_id") @db.Uuid

  questionRevision                  QuestionRevision                           @relation(fields: [questionRevisionId], references: [id], onDelete: Cascade)
  asset                             Asset?                                     @relation("QuestionRevisionOptionAsset", fields: [assetId], references: [id], onDelete: Restrict)
  standaloneQuizItemOptions         StandaloneQuizItemOption[]                 @relation("StandaloneQuizItemOptionSourceRevisionOption")
  reusablePackageVersionItemOptions ReusableQuestionPackageVersionItemOption[] @relation("ReusablePackageVersionItemOptionSourceRevisionOption")
  tryoutItemOptions                 TryoutItemOption[]                         @relation("TryoutItemOptionSourceRevisionOption")

  @@unique([questionRevisionId, label])
  @@unique([questionRevisionId, sortOrder])
  @@map("question_revision_options")
}

model QuestionOption {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String  @db.VarChar(8)
  content    String  @db.Text
  isCorrect  Boolean @default(false) @map("is_correct")
  sortOrder  Int     @default(0) @map("sort_order")
  assetId    String? @map("asset_id") @db.Uuid

  question                      Question                                   @relation(fields: [questionId], references: [id])
  asset                         Asset?                                     @relation("QuestionOptionAsset", fields: [assetId], references: [id], onDelete: Restrict)
  quizAnswers                   QuizAttemptAnswer[]
  standaloneQuizItemOptions     StandaloneQuizItemOption[]
  tryoutItemOptions             TryoutItemOption[]
  reusablePackageVersionOptions ReusableQuestionPackageVersionItemOption[]

  @@unique([questionId, label])
  @@unique([questionId, sortOrder])
  @@map("question_options")
}

model QuestionBankFolder {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId        String?             @map("parent_id") @db.Uuid
  purpose         QuestionBankPurpose
  name            String              @db.VarChar(160)
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  updatedByUserId String              @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent                                     QuestionBankFolder?                         @relation("QuestionBankFolderTree", fields: [parentId, purpose], references: [id, purpose], onDelete: Restrict)
  children                                   QuestionBankFolder[]                        @relation("QuestionBankFolderTree")
  banks                                      QuestionBank[]
  reusableQuestionPackageVersionFolderScopes ReusableQuestionPackageVersionFolderScope[]
  createdBy                                  User                                        @relation("QuestionBankFolderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                                  User                                        @relation("QuestionBankFolderUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, purpose], map: "question_bank_folders_id_purpose_key")
  @@index([parentId, name])
  @@index([purpose, parentId, name])
  @@map("question_bank_folders")
}

model QuestionBankCategory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(120)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  createdBy                                    User                                          @relation("QuestionBankCategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                                    User                                          @relation("QuestionBankCategoryUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  banks                                        QuestionBankCategoryAssignment[]
  reusableQuestionPackageVersionCategoryScopes ReusableQuestionPackageVersionCategoryScope[]

  @@index([name])
  @@map("question_bank_categories")
}

model QuestionBankCategoryAssignment {
  questionBankId   String   @map("question_bank_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  assignedByUserId String?  @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  questionBank QuestionBank         @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  category     QuestionBankCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedBy   User?                @relation("QuestionBankCategoryAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([questionBankId, categoryId])
  @@index([categoryId, questionBankId])
  @@map("question_bank_category_assignments")
}

// ─────────────────────────────────────────────
// MODULE QUIZZES
// ─────────────────────────────────────────────

model ModuleQuiz {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId     String        @unique @map("module_id") @db.Uuid
  title        String        @db.VarChar(220)
  passingScore Decimal?      @map("passing_score") @db.Decimal(5, 2)
  status       ContentStatus @default(draft)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  module   Module        @relation(fields: [moduleId], references: [id])
  items    QuizItem[]
  attempts QuizAttempt[]

  @@map("module_quizzes")
}

// Standalone quizzes authored by tutors. These are intentionally independent
// from ModuleQuiz, which remains the one-to-one assessment for a learning module.
model StandaloneQuiz {
  id                       String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String                                @unique @db.VarChar(240)
  title                    String                                @db.VarChar(220)
  description              String?                               @db.Text
  subtestId                String                                @map("subtest_id") @db.Uuid
  sourceBankId             String?                               @map("source_bank_id") @db.Uuid
  status                   ContentStatus                         @default(published)
  isHidden                 Boolean                               @default(false) @map("is_hidden")
  opensAt                  DateTime?                             @map("opens_at") @db.Timestamptz
  closesAt                 DateTime?                             @map("closes_at") @db.Timestamptz
  durationSeconds          Int?                                  @map("duration_seconds")
  attemptsAllowed          Int?                                  @default(1) @map("attempts_allowed")
  scorePolicy              StandaloneQuizScorePolicy             @default(latest) @map("score_policy")
  retryDelaySeconds        Int?                                  @map("retry_delay_seconds")
  formBehavior             StandaloneQuizFormBehavior            @default(same) @map("form_behavior")
  reviewTiming             StandaloneQuizReviewTiming            @default(immediate) @map("review_timing")
  correctAnswerVisibility  StandaloneQuizCorrectAnswerVisibility @default(show) @map("correct_answer_visibility")
  assemblyMode             ReusableQuestionPackageMode?          @map("assembly_mode")
  assemblyPackageVersionId String?                               @map("assembly_package_version_id") @db.Uuid
  assemblyDefinitionDigest String?                               @map("assembly_definition_digest") @db.VarChar(128)
  assemblySeed             String?                               @map("assembly_seed") @db.VarChar(128)
  revision                 Int                                   @default(1)
  idempotencyKey           String?                               @unique @map("idempotency_key") @db.VarChar(120)
  createdByUserId          String                                @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  createdBy              User                            @relation("StandaloneQuizAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  subtest                Subtest                         @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  sourceBank             QuestionBank?                   @relation(fields: [sourceBankId], references: [id], onDelete: Restrict)
  assemblyPackageVersion ReusableQuestionPackageVersion? @relation("StandaloneQuizAssemblyVersion", fields: [assemblyPackageVersionId], references: [id], onDelete: Restrict)
  items                  StandaloneQuizItem[]
  participations         StandaloneQuizParticipation[]
  versions               StandaloneQuizVersion[]
  startCommands          StandaloneQuizStartCommand[]

  @@index([status, opensAt, closesAt])
  @@index([subtestId, status])
  @@index([assemblyPackageVersionId])
  @@map("standalone_quizzes")
}

/// Versioned Kuis definition. The stable StandaloneQuiz row remains the
/// catalogue/ownership identity while this aggregate becomes the future
/// draft/publication boundary. Nullable links on existing child rows keep the
/// migration additive until the application cutover ticket is implemented.
model StandaloneQuizVersion {
  id                       String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                   String                                @map("quiz_id") @db.Uuid
  baseVersionId            String?                               @map("base_version_id") @db.Uuid
  state                    StandaloneQuizVersionState            @default(draft)
  versionNo                Int?                                  @map("version_no")
  title                    String                                @db.VarChar(220)
  description              String?                               @db.Text
  attemptsAllowed          Int?                                  @map("attempts_allowed")
  scorePolicy              StandaloneQuizScorePolicy             @default(latest) @map("score_policy")
  retryDelaySeconds        Int?                                  @map("retry_delay_seconds")
  formBehavior             StandaloneQuizFormBehavior            @default(same) @map("form_behavior")
  reviewTiming             StandaloneQuizReviewTiming            @default(immediate) @map("review_timing")
  correctAnswerVisibility  StandaloneQuizCorrectAnswerVisibility @default(show) @map("correct_answer_visibility")
  sourceBankId             String?                               @map("source_bank_id") @db.Uuid
  assemblyMode             ReusableQuestionPackageMode?          @map("assembly_mode")
  assemblyPackageVersionId String?                               @map("assembly_package_version_id") @db.Uuid
  assemblyDefinitionDigest String?                               @map("assembly_definition_digest") @db.VarChar(128)
  assemblySeed             String?                               @map("assembly_seed") @db.VarChar(128)
  definitionVersion        String                                @default("kuis-assessment-definition-v1") @map("definition_version") @db.VarChar(120)
  definitionDigest         String?                               @map("definition_digest") @db.VarChar(128)
  draftRevision            Int?                                  @map("draft_revision")
  publishRequestId         String?                               @unique @map("publish_request_id") @db.Uuid
  publishedAt              DateTime?                             @map("published_at") @db.Timestamptz
  publishedByUserId        String?                               @map("published_by_user_id") @db.Uuid
  provenance               StandaloneQuizVersionProvenance       @default(runtime)
  opensAt                  DateTime?                             @map("opens_at") @db.Timestamptz
  closesAt                 DateTime?                             @map("closes_at") @db.Timestamptz
  durationSeconds          Int?                                  @map("duration_seconds")
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quiz                   StandaloneQuiz                  @relation(fields: [quizId], references: [id], onDelete: Restrict)
  baseVersion            StandaloneQuizVersion?          @relation("StandaloneQuizVersionBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  derivedVersions        StandaloneQuizVersion[]         @relation("StandaloneQuizVersionBase")
  sourceBank             QuestionBank?                   @relation("StandaloneQuizVersionSourceBank", fields: [sourceBankId], references: [id], onDelete: Restrict)
  assemblyPackageVersion ReusableQuestionPackageVersion? @relation("StandaloneQuizVersionAssemblyVersion", fields: [assemblyPackageVersionId], references: [id], onDelete: Restrict)
  publishedBy            User?                           @relation("StandaloneQuizVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  items                  StandaloneQuizItem[]
  participations         StandaloneQuizParticipation[]
  startCommands          StandaloneQuizStartCommand[]

  @@unique([quizId, versionNo])
  @@index([quizId, state])
  @@index([sourceBankId])
  @@index([assemblyPackageVersionId])
  @@map("standalone_quiz_versions")
}

model StandaloneQuizItem {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                   String                      @map("quiz_id") @db.Uuid
  quizVersionId            String?                     @map("quiz_version_id") @db.Uuid
  sortOrder                Int                         @map("sort_order")
  prompt                   String                      @db.Text
  explanation              String?                     @db.Text
  difficulty               DifficultyLevel             @default(medium)
  questionType             QuestionType                @default(single_choice) @map("question_type")
  subtestId                String                      @map("subtest_id") @db.Uuid
  sourceQuestionId         String?                     @map("source_question_id") @db.Uuid
  sourceQuestionRevisionId String?                     @map("source_question_revision_id") @db.Uuid
  sourceContentDigest      String?                     @map("source_content_digest") @db.VarChar(128)
  sourceRevisionProvenance QuestionRevisionProvenance? @map("source_revision_provenance")
  promptAssetId            String?                     @map("prompt_asset_id") @db.Uuid
  explanationAssetId       String?                     @map("explanation_asset_id") @db.Uuid
  idempotencyKey           String?                     @map("idempotency_key") @db.VarChar(120)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  quiz                   StandaloneQuiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizVersion            StandaloneQuizVersion?     @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  subtest                Subtest                    @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  sourceQuestion         Question?                  @relation("StandaloneQuizItemSourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  sourceQuestionRevision QuestionRevision?          @relation("StandaloneQuizItemSourceQuestionRevision", fields: [sourceQuestionRevisionId], references: [id], onDelete: Restrict)
  promptAsset            Asset?                     @relation("StandaloneQuizItemPromptAsset", fields: [promptAssetId], references: [id], onDelete: Restrict)
  explanationAsset       Asset?                     @relation("StandaloneQuizItemExplanationAsset", fields: [explanationAssetId], references: [id], onDelete: Restrict)
  options                StandaloneQuizItemOption[]
  answers                StandaloneQuizAnswer[]

  @@unique([quizId, idempotencyKey])
  // Versioned Kuis drafts and active snapshots share the stable quiz identity.
  // The forward migration installs scoped partial unique indexes so legacy
  // unversioned rows remain ordered while multiple version snapshots coexist.
  @@index([quizId, sortOrder])
  @@index([quizVersionId, sortOrder])
  @@map("standalone_quiz_items")
}

