  standaloneQuizVersions       StandaloneQuizVersion[]                       @relation("StandaloneQuizVersionAssemblyVersion")

  @@unique([packageId, versionNo])
  @@index([packageId, status])
  @@index([subtestId, mode, status])
  @@map("reusable_question_package_versions")
}

/// Version-owned Bank scope. Multiple rows form a union; folder and category
