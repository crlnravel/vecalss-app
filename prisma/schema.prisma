  @@index([studentId])
  @@index([topicId])
  @@index([status])
  @@map("adaptive_practice_sessions")
}

model AdaptivePracticeAnswer {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adaptiveSessionId String                  @map("adaptive_session_id") @db.Uuid
  questionId        String?                 @map("question_id") @db.Uuid
  generatedItemRef  String?                 @map("generated_item_ref") @db.VarChar(80)
  answerText        String?                 @map("answer_text") @db.Text
  isCorrect         Boolean?                @map("is_correct")
  answeredAt        DateTime                @default(now()) @map("answered_at") @db.Timestamptz

  adaptiveSession   AdaptivePracticeSession @relation(fields: [adaptiveSessionId], references: [id])
  question          Question?              @relation(fields: [questionId], references: [id])

  @@map("adaptive_practice_answers")
}

model PtnStrategySession {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String          @map("student_id") @db.Uuid
  universityId       String?         @map("university_id") @db.Uuid
  majorId            String?         @map("major_id") @db.Uuid
  conversationId     String?         @map("conversation_id") @db.Uuid
  tryoutAverageScore Decimal?        @map("tryout_average_score") @db.Decimal(7, 2)
  disclaimerShown    Boolean         @default(false) @map("disclaimer_shown")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz

  student            User            @relation(fields: [studentId], references: [id])
  university         University?     @relation(fields: [universityId], references: [id])
  major              Major?          @relation(fields: [majorId], references: [id])
  conversation       AiConversation? @relation(fields: [conversationId], references: [id])

  @@map("ptn_strategy_sessions")
