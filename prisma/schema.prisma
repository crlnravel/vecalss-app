  availableUntil            DateTime                    @map("available_until") @db.Timestamptz
  resultReleasePolicy       TryoutResultReleasePolicy   @default(inherit) @map("result_release_policy")
  scheduledReleaseAt        DateTime?                   @map("scheduled_release_at") @db.Timestamptz
  rankingRule               TryoutRankingRule           @default(none) @map("ranking_rule")
  isDefaultOpenRegistration Boolean                     @default(false) @map("is_default_open_registration")
  fullscreenPrompt          Boolean                     @default(false) @map("fullscreen_prompt")
  status                    TryoutDeliverySessionStatus @default(draft)
