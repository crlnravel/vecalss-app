model ModuleQuiz {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId     String        @unique @map("module_id") @db.Uuid
  title        String        @db.VarChar(220)
  passingScore Decimal?      @map("passing_score") @db.Decimal(5, 2)
  status       ContentStatus @default(draft)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  module   Module        @relation(fields: [moduleId], references: [id])
  items    QuizItem[]
  attempts QuizAttempt[]

  @@map("module_quizzes")
}

// Standalone quizzes authored by tutors. These are intentionally independent
// from ModuleQuiz, which remains the one-to-one assessment for a learning module.
model StandaloneQuiz {
  id                       String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String                                @unique @db.VarChar(240)
  title                    String                                @db.VarChar(220)
  description              String?                               @db.Text
  subtestId                String                                @map("subtest_id") @db.Uuid
  sourceBankId             String?                               @map("source_bank_id") @db.Uuid
  status                   ContentStatus                         @default(published)
  isHidden                 Boolean                               @default(false) @map("is_hidden")
  opensAt                  DateTime?                             @map("opens_at") @db.Timestamptz
  closesAt                 DateTime?                             @map("closes_at") @db.Timestamptz
  durationSeconds          Int?                                  @map("duration_seconds")
  attemptsAllowed          Int?                                  @default(1) @map("attempts_allowed")
  scorePolicy              StandaloneQuizScorePolicy             @default(latest) @map("score_policy")
  retryDelaySeconds        Int?                                  @map("retry_delay_seconds")
  formBehavior             StandaloneQuizFormBehavior            @default(same) @map("form_behavior")
  reviewTiming             StandaloneQuizReviewTiming            @default(immediate) @map("review_timing")
  correctAnswerVisibility  StandaloneQuizCorrectAnswerVisibility @default(show) @map("correct_answer_visibility")
  assemblyMode             ReusableQuestionPackageMode?          @map("assembly_mode")
  assemblyPackageVersionId String?                               @map("assembly_package_version_id") @db.Uuid
  assemblyDefinitionDigest String?                               @map("assembly_definition_digest") @db.VarChar(128)
  assemblySeed             String?                               @map("assembly_seed") @db.VarChar(128)
  revision                 Int                                   @default(1)
  idempotencyKey           String?                               @unique @map("idempotency_key") @db.VarChar(120)
  createdByUserId          String                                @map("created_by_user_id") @db.Uuid
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  createdBy              User                            @relation("StandaloneQuizAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  subtest                Subtest                         @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  sourceBank             QuestionBank?                   @relation(fields: [sourceBankId], references: [id], onDelete: Restrict)
  assemblyPackageVersion ReusableQuestionPackageVersion? @relation("StandaloneQuizAssemblyVersion", fields: [assemblyPackageVersionId], references: [id], onDelete: Restrict)
  items                  StandaloneQuizItem[]
  participations         StandaloneQuizParticipation[]
  versions               StandaloneQuizVersion[]
  startCommands          StandaloneQuizStartCommand[]

  @@index([status, opensAt, closesAt])
  @@index([subtestId, status])
  @@index([assemblyPackageVersionId])
  @@map("standalone_quizzes")
}

/// Versioned Kuis definition. The stable StandaloneQuiz row remains the
/// catalogue/ownership identity while this aggregate becomes the future
/// draft/publication boundary. Nullable links on existing child rows keep the
/// migration additive until the application cutover ticket is implemented.
model StandaloneQuizVersion {
  id                       String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                   String                                @map("quiz_id") @db.Uuid
  baseVersionId            String?                               @map("base_version_id") @db.Uuid
  state                    StandaloneQuizVersionState            @default(draft)
  versionNo                Int?                                  @map("version_no")
  title                    String                                @db.VarChar(220)
  description              String?                               @db.Text
  attemptsAllowed          Int?                                  @map("attempts_allowed")
  scorePolicy              StandaloneQuizScorePolicy             @default(latest) @map("score_policy")
  retryDelaySeconds        Int?                                  @map("retry_delay_seconds")
  formBehavior             StandaloneQuizFormBehavior            @default(same) @map("form_behavior")
  reviewTiming             StandaloneQuizReviewTiming            @default(immediate) @map("review_timing")
  correctAnswerVisibility  StandaloneQuizCorrectAnswerVisibility @default(show) @map("correct_answer_visibility")
  sourceBankId             String?                               @map("source_bank_id") @db.Uuid
  assemblyMode             ReusableQuestionPackageMode?          @map("assembly_mode")
  assemblyPackageVersionId String?                               @map("assembly_package_version_id") @db.Uuid
  assemblyDefinitionDigest String?                               @map("assembly_definition_digest") @db.VarChar(128)
  assemblySeed             String?                               @map("assembly_seed") @db.VarChar(128)
  definitionVersion        String                                @default("kuis-assessment-definition-v1") @map("definition_version") @db.VarChar(120)
  definitionDigest         String?                               @map("definition_digest") @db.VarChar(128)
  draftRevision            Int?                                  @map("draft_revision")
  publishRequestId         String?                               @unique @map("publish_request_id") @db.Uuid
  publishedAt              DateTime?                             @map("published_at") @db.Timestamptz
  publishedByUserId        String?                               @map("published_by_user_id") @db.Uuid
  provenance               StandaloneQuizVersionProvenance       @default(runtime)
  opensAt                  DateTime?                             @map("opens_at") @db.Timestamptz
  closesAt                 DateTime?                             @map("closes_at") @db.Timestamptz
  durationSeconds          Int?                                  @map("duration_seconds")
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quiz                   StandaloneQuiz                  @relation(fields: [quizId], references: [id], onDelete: Restrict)
  baseVersion            StandaloneQuizVersion?          @relation("StandaloneQuizVersionBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  derivedVersions        StandaloneQuizVersion[]         @relation("StandaloneQuizVersionBase")
  sourceBank             QuestionBank?                   @relation("StandaloneQuizVersionSourceBank", fields: [sourceBankId], references: [id], onDelete: Restrict)
  assemblyPackageVersion ReusableQuestionPackageVersion? @relation("StandaloneQuizVersionAssemblyVersion", fields: [assemblyPackageVersionId], references: [id], onDelete: Restrict)
  publishedBy            User?                           @relation("StandaloneQuizVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  items                  StandaloneQuizItem[]
  participations         StandaloneQuizParticipation[]
  startCommands          StandaloneQuizStartCommand[]

  @@unique([quizId, versionNo])
  @@index([quizId, state])
  @@index([sourceBankId])
  @@index([assemblyPackageVersionId])
  @@map("standalone_quiz_versions")
}

model StandaloneQuizItem {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                   String                      @map("quiz_id") @db.Uuid
  quizVersionId            String?                     @map("quiz_version_id") @db.Uuid
  sortOrder                Int                         @map("sort_order")
  prompt                   String                      @db.Text
  explanation              String?                     @db.Text
  difficulty               DifficultyLevel             @default(medium)
  questionType             QuestionType                @default(single_choice) @map("question_type")
  subtestId                String                      @map("subtest_id") @db.Uuid
  sourceQuestionId         String?                     @map("source_question_id") @db.Uuid
  sourceQuestionRevisionId String?                     @map("source_question_revision_id") @db.Uuid
  sourceContentDigest      String?                     @map("source_content_digest") @db.VarChar(128)
  sourceRevisionProvenance QuestionRevisionProvenance? @map("source_revision_provenance")
  promptAssetId            String?                     @map("prompt_asset_id") @db.Uuid
  explanationAssetId       String?                     @map("explanation_asset_id") @db.Uuid
  idempotencyKey           String?                     @map("idempotency_key") @db.VarChar(120)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  quiz                   StandaloneQuiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizVersion            StandaloneQuizVersion?     @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  subtest                Subtest                    @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  sourceQuestion         Question?                  @relation("StandaloneQuizItemSourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  sourceQuestionRevision QuestionRevision?          @relation("StandaloneQuizItemSourceQuestionRevision", fields: [sourceQuestionRevisionId], references: [id], onDelete: Restrict)
  promptAsset            Asset?                     @relation("StandaloneQuizItemPromptAsset", fields: [promptAssetId], references: [id], onDelete: Restrict)
  explanationAsset       Asset?                     @relation("StandaloneQuizItemExplanationAsset", fields: [explanationAssetId], references: [id], onDelete: Restrict)
  options                StandaloneQuizItemOption[]
  answers                StandaloneQuizAnswer[]

  @@unique([quizId, idempotencyKey])
  // Versioned Kuis drafts and active snapshots share the stable quiz identity.
  // The forward migration installs scoped partial unique indexes so legacy
  // unversioned rows remain ordered while multiple version snapshots coexist.
  @@index([quizId, sortOrder])
  @@index([quizVersionId, sortOrder])
  @@map("standalone_quiz_items")
}

model StandaloneQuizItemOption {
  id                             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizItemId                     String                  @map("quiz_item_id") @db.Uuid
  choiceKey                      String                  @map("choice_key") @db.VarChar(64)
  content                        String                  @db.Text
  isCorrect                      Boolean                 @default(false) @map("is_correct")
  sortOrder                      Int                     @map("sort_order")
  sourceQuestionOptionId         String?                 @map("source_question_option_id") @db.Uuid
  sourceQuestionRevisionOptionId String?                 @map("source_question_revision_option_id") @db.Uuid
  assetId                        String?                 @map("asset_id") @db.Uuid
  quizItem                       StandaloneQuizItem      @relation(fields: [quizItemId], references: [id], onDelete: Cascade)
  sourceQuestionOption           QuestionOption?         @relation(fields: [sourceQuestionOptionId], references: [id], onDelete: Restrict)
  sourceQuestionRevisionOption   QuestionRevisionOption? @relation("StandaloneQuizItemOptionSourceRevisionOption", fields: [sourceQuestionRevisionOptionId], references: [id], onDelete: Restrict)
  asset                          Asset?                  @relation("StandaloneQuizItemOptionAsset", fields: [assetId], references: [id], onDelete: Restrict)
  selectedInAnswers              StandaloneQuizAnswer[]

  @@unique([quizItemId, choiceKey])
  @@unique([quizItemId, sortOrder])
  @@map("standalone_quiz_item_options")
}

model StandaloneQuizParticipation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId         String   @map("quiz_id") @db.Uuid
  quizVersionId  String?  @map("quiz_version_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  policySnapshot Json     @map("policy_snapshot") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quiz        StandaloneQuiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizVersion StandaloneQuizVersion?  @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  student     User                    @relation(fields: [studentId], references: [id])
  attempts    StandaloneQuizAttempt[]

  // A student may have one participation per immutable quiz snapshot. This
  // lets a later assessment edit allocate a fresh participation/version while
  // preserving every prior attempt's pinned snapshot.
  @@unique([quizVersionId, studentId])
  @@index([quizVersionId, studentId])
  @@index([studentId])
  @@map("standalone_quiz_participations")
}

model StandaloneQuizAttempt {
  id                      String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participationId         String                       @map("participation_id") @db.Uuid
  attemptNo               Int                          @map("attempt_no")
  status                  AttemptStatus                @default(in_progress)
  attemptState            AssessmentAttemptState       @default(in_progress) @map("attempt_state")
  scoringState            AssessmentScoringState       @default(pending) @map("scoring_state")
  releaseState            AssessmentResultReleaseState @default(hidden) @map("release_state")
  startRequestId          String?                      @map("start_request_id") @db.Uuid
  policySnapshot          Json                         @map("policy_snapshot") @db.JsonB
  durationSecondsSnapshot Int?                         @map("duration_seconds_snapshot")
  startedAt               DateTime?                    @map("started_at") @db.Timestamptz
  deadlineAt              DateTime?                    @map("deadline_at") @db.Timestamptz
  formItemOrder           Json                         @map("form_item_order") @db.JsonB
  formSnapshot            Json?                        @map("form_snapshot") @db.JsonB
  correctCount            Int?                         @map("correct_count")
  wrongCount              Int?                         @map("wrong_count")
  unansweredCount         Int?                         @map("unanswered_count")
  maxPoints               Decimal?                     @map("max_points") @db.Decimal(8, 2)
  earnedPoints            Decimal?                     @map("earned_points") @db.Decimal(8, 2)
  score                   Int?
  scoringVersion          String?                      @map("scoring_version") @db.VarChar(120)
  scoringProvenance       AssessmentScoringProvenance  @default(runtime) @map("scoring_provenance")
  scoringReviewReason     String?                      @map("scoring_review_reason") @db.Text
  releaseAt               DateTime?                    @map("release_at") @db.Timestamptz
  submittedAt             DateTime?                    @map("submitted_at") @db.Timestamptz
  createdAt               DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  participation StandaloneQuizParticipation  @relation(fields: [participationId], references: [id], onDelete: Cascade)
  answers       StandaloneQuizAnswer[]
  startCommands StandaloneQuizStartCommand[] @relation("StandaloneQuizStartCommandAttempt")

  @@unique([participationId, attemptNo])
  @@unique([participationId, startRequestId])
  @@index([participationId, status])
  @@map("standalone_quiz_attempts")
}

model StandaloneQuizAnswer {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String                     @map("attempt_id") @db.Uuid
  quizItemId        String                     @map("quiz_item_id") @db.Uuid
  selectedOptionId  String                     @map("selected_option_id") @db.Uuid
  selectedOptionIds Json?                      @map("selected_option_ids") @db.JsonB
  answerFormat      StandaloneQuizAnswerFormat @default(legacy_scalar) @map("answer_format")
  isCorrect         Boolean?                   @map("is_correct")
  pointsAwarded     Decimal?                   @map("points_awarded") @db.Decimal(8, 2)
  scoringVersion    String?                    @map("scoring_version") @db.VarChar(120)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  attempt        StandaloneQuizAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizItem       StandaloneQuizItem       @relation(fields: [quizItemId], references: [id], onDelete: Cascade)
  selectedOption StandaloneQuizItemOption @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, quizItemId])
  @@index([attemptId])
  @@map("standalone_quiz_answers")
}

/// Idempotency authority for starts that race a Kuis publication. The legacy
/// attempt.startRequestId remains available for audit and old readers.
model StandaloneQuizStartCommand {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId        String   @map("quiz_id") @db.Uuid
  quizVersionId String?  @map("quiz_version_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  requestId     String   @map("request_id") @db.Uuid
  attemptId     String?  @map("attempt_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  quiz        StandaloneQuiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  quizVersion StandaloneQuizVersion? @relation(fields: [quizVersionId], references: [id], onDelete: Restrict)
  student     User                   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attempt     StandaloneQuizAttempt? @relation("StandaloneQuizStartCommandAttempt", fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([quizId, studentId, requestId])
  @@index([attemptId])
  @@index([quizId, studentId, createdAt])
  @@map("standalone_quiz_start_commands")
}

model QuizItem {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId     String  @map("quiz_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  sortOrder  Int     @map("sort_order")
  points     Decimal @default(1) @db.Decimal(6, 2)

  quiz     ModuleQuiz @relation(fields: [quizId], references: [id])
  question Question   @relation(fields: [questionId], references: [id])

  @@unique([quizId, questionId])
  @@unique([quizId, sortOrder])
  @@map("quiz_items")
}

model QuizAttempt {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId       String        @map("quiz_id") @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  status       AttemptStatus @default(in_progress)
  started_at   DateTime      @default(now()) @map("started_at") @db.Timestamptz
  submittedAt  DateTime?     @map("submitted_at") @db.Timestamptz
  score        Decimal?      @db.Decimal(6, 2)
  maxScore     Decimal?      @map("max_score") @db.Decimal(6, 2)
  masteryDelta Decimal?      @map("mastery_delta") @db.Decimal(6, 2)
  draftPayload Json?         @map("draft_payload") @db.JsonB
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quiz    ModuleQuiz          @relation(fields: [quizId], references: [id])
  student User                @relation(fields: [studentId], references: [id])
  answers QuizAttemptAnswer[]

  @@index([quizId])
  @@index([studentId])
  @@index([status])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  answerText       String?  @map("answer_text") @db.Text
  isCorrect        Boolean? @map("is_correct")
  pointsAwarded    Decimal? @map("points_awarded") @db.Decimal(6, 2)
  answeredAt       DateTime @default(now()) @map("answered_at") @db.Timestamptz

  attempt        QuizAttempt     @relation(fields: [attemptId], references: [id])
  question       Question        @relation(fields: [questionId], references: [id])
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("quiz_attempt_answers")
}

// ─────────────────────────────────────────────
// TRYOUTS
// ─────────────────────────────────────────────

model ReusableQuestionPackage {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String                      @unique @db.VarChar(100)
  title           String                      @db.VarChar(220)
  description     String?                     @db.Text
  sourceBankId    String                      @map("source_bank_id") @db.Uuid
  subtestId       String                      @map("subtest_id") @db.Uuid
  mode            ReusableQuestionPackageMode @default(fixed_set)
  status          ContentStatus               @default(draft)
  revision        Int                         @default(1)
  createdByUserId String                      @map("created_by_user_id") @db.Uuid
  updatedByUserId String                      @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subtest                      Subtest                          @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  sourceBank                   QuestionBank                     @relation("ReusablePackageSourceBank", fields: [sourceBankId], references: [id], onDelete: Restrict)
  createdBy                    User                             @relation("ReusableQuestionPackageCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedBy                    User                             @relation("ReusableQuestionPackageUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  items                        ReusableQuestionPackageItem[]
  versions                     ReusableQuestionPackageVersion[]
  assessmentReleasesByAssembly AssessmentRelease[]              @relation("AssessmentReleaseAssemblyPackage")

  @@index([subtestId, status])
  @@index([mode, status])
  @@map("reusable_question_packages")
}

model ReusableQuestionPackageItem {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId                String                      @map("package_id") @db.Uuid
  sourceQuestionId         String                      @map("source_question_id") @db.Uuid
  sourceQuestionRevisionId String?                     @map("source_question_revision_id") @db.Uuid
  sourceContentDigest      String?                     @map("source_content_digest") @db.VarChar(128)
  sourceRevisionProvenance QuestionRevisionProvenance? @map("source_revision_provenance")
  sortOrder                Int                         @map("sort_order")
  pointValue               Decimal                     @map("point_value") @db.Decimal(6, 2)
  createdAt                DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  package                ReusableQuestionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sourceQuestion         Question                @relation("ReusablePackageItemSourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  sourceQuestionRevision QuestionRevision?       @relation("ReusablePackageItemSourceQuestionRevision", fields: [sourceQuestionRevisionId], references: [id], onDelete: Restrict)

  @@unique([packageId, sourceQuestionId])
  @@unique([packageId, sortOrder])
  @@map("reusable_question_package_items")
}

model ReusableQuestionPackageVersion {
  id               String                                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId        String                                   @map("package_id") @db.Uuid
  sourceBankId     String                                   @map("source_bank_id") @db.Uuid
  subtestId        String?                                  @map("subtest_id") @db.Uuid
  versionNo        Int                                      @map("version_no")
  mode             ReusableQuestionPackageMode              @default(fixed_set)
  definitionDigest String?                                  @map("definition_digest") @db.VarChar(128)
  provenance       ReusableQuestionPackageVersionProvenance @default(authored)
  status           ContentStatus                            @default(draft)
  readyAt          DateTime?                                @map("ready_at") @db.Timestamptz
  createdByUserId  String                                   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                                 @default(now()) @map("created_at") @db.Timestamptz

  package                      ReusableQuestionPackage                       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  sourceBank                   QuestionBank                                  @relation("ReusablePackageVersionSourceBank", fields: [sourceBankId], references: [id], onDelete: Restrict)
  subtest                      Subtest?                                      @relation("ReusablePackageVersionSubtest", fields: [subtestId], references: [id], onDelete: Restrict)
  createdBy                    User                                          @relation("ReusableQuestionPackageVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                        ReusableQuestionPackageVersionItem[]
  bankScopes                   ReusableQuestionPackageVersionBankScope[]
  folderScopes                 ReusableQuestionPackageVersionFolderScope[]
  categoryScopes               ReusableQuestionPackageVersionCategoryScope[]
  rule                         ReusableQuestionPackageVersionRule?
  tryoutSections               TryoutSection[]
  tryoutItems                  TryoutItem[]
  assessmentReleasesByAssembly AssessmentRelease[]                           @relation("AssessmentReleaseAssemblyPackageVersion")
  standaloneQuizzes            StandaloneQuiz[]                              @relation("StandaloneQuizAssemblyVersion")
  standaloneQuizVersions       StandaloneQuizVersion[]                       @relation("StandaloneQuizVersionAssemblyVersion")

  @@unique([packageId, versionNo])
  @@index([packageId, status])
  @@index([subtestId, mode, status])
  @@map("reusable_question_package_versions")
}

/// Version-owned Bank scope. Multiple rows form a union; folder and category
/// scope rows narrow that union without replacing the active Subtest rule.
model ReusableQuestionPackageVersionBankScope {
  packageVersionId String   @map("package_version_id") @db.Uuid
  questionBankId   String   @map("question_bank_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  packageVersion ReusableQuestionPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank                   @relation(fields: [questionBankId], references: [id], onDelete: Restrict)

  @@id([packageVersionId, questionBankId])
  @@index([questionBankId, packageVersionId])
  @@map("reusable_question_package_version_bank_scopes")
}

model ReusableQuestionPackageVersionFolderScope {
  packageVersionId String   @map("package_version_id") @db.Uuid
  folderId         String   @map("folder_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  packageVersion ReusableQuestionPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  folder         QuestionBankFolder             @relation(fields: [folderId], references: [id], onDelete: Restrict)

  @@id([packageVersionId, folderId])
  @@index([folderId, packageVersionId])
  @@map("reusable_question_package_version_folder_scopes")
}

model ReusableQuestionPackageVersionCategoryScope {
  packageVersionId String   @map("package_version_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  packageVersion ReusableQuestionPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  category       QuestionBankCategory           @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([packageVersionId, categoryId])
  @@index([categoryId, packageVersionId])
  @@map("reusable_question_package_version_category_scopes")
}

/// A mode-specific rule. Pool/CAT use requestedCount as the draw/delivery
/// count; Blueprint uses it as the total and requires the exact difficulty
/// quota sum. Fixed Sets do not need a rule row.
model ReusableQuestionPackageVersionRule {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageVersionId String   @unique @map("package_version_id") @db.Uuid
  requestedCount   Int      @map("requested_count")
  easyCount        Int      @default(0) @map("easy_count")
  mediumCount      Int      @default(0) @map("medium_count")
  hardCount        Int      @default(0) @map("hard_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  packageVersion ReusableQuestionPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)

  @@index([requestedCount])
  @@map("reusable_question_package_version_rules")
}

model ReusableQuestionPackageVersionItem {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageVersionId         String                      @map("package_version_id") @db.Uuid
  sourceQuestionId         String                      @map("source_question_id") @db.Uuid
  sourceQuestionRevisionId String?                     @map("source_question_revision_id") @db.Uuid
  sourceContentDigest      String?                     @map("source_content_digest") @db.VarChar(128)
  sourceRevisionProvenance QuestionRevisionProvenance? @map("source_revision_provenance")
  sortOrder                Int                         @map("sort_order")
  pointValue               Decimal                     @map("point_value") @db.Decimal(6, 2)
  prompt                   String                      @db.Text
  explanation              String?                     @db.Text
  difficulty               DifficultyLevel             @default(medium)
  subtestId                String                      @map("subtest_id") @db.Uuid
  promptAssetId            String?                     @map("prompt_asset_id") @db.Uuid
  explanationAssetId       String?                     @map("explanation_asset_id") @db.Uuid

  packageVersion         ReusableQuestionPackageVersion             @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  sourceQuestion         Question                                   @relation("ReusablePackageVersionItemSourceQuestion", fields: [sourceQuestionId], references: [id], onDelete: Restrict)
  sourceQuestionRevision QuestionRevision?                          @relation("ReusablePackageVersionItemSourceQuestionRevision", fields: [sourceQuestionRevisionId], references: [id], onDelete: Restrict)
  subtest                Subtest                                    @relation(fields: [subtestId], references: [id], onDelete: Restrict)
  promptAsset            Asset?                                     @relation("ReusablePackageVersionItemPromptAsset", fields: [promptAssetId], references: [id], onDelete: Restrict)
  explanationAsset       Asset?                                     @relation("ReusablePackageVersionItemExplanationAsset", fields: [explanationAssetId], references: [id], onDelete: Restrict)
  options                ReusableQuestionPackageVersionItemOption[]

  @@unique([packageVersionId, sourceQuestionId], map: "reusable_package_version_item_source_key")
  @@unique([packageVersionId, sortOrder], map: "reusable_package_version_item_order_key")
  @@map("reusable_question_package_version_items")
}

model ReusableQuestionPackageVersionItemOption {
  id                             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageVersionItemId           String  @map("package_version_item_id") @db.Uuid
  choiceKey                      String  @map("choice_key") @db.VarChar(64)
  content                        String  @db.Text
  isCorrect                      Boolean @default(false) @map("is_correct")
  sortOrder                      Int     @map("sort_order")
  sourceQuestionOptionId         String? @map("source_question_option_id") @db.Uuid
  sourceQuestionRevisionOptionId String? @map("source_question_revision_option_id") @db.Uuid
  assetId                        String? @map("asset_id") @db.Uuid

  item                         ReusableQuestionPackageVersionItem @relation(fields: [packageVersionItemId], references: [id], onDelete: Cascade)
  sourceQuestionOption         QuestionOption?                    @relation(fields: [sourceQuestionOptionId], references: [id], onDelete: Restrict)
  sourceQuestionRevisionOption QuestionRevisionOption?            @relation("ReusablePackageVersionItemOptionSourceRevisionOption", fields: [sourceQuestionRevisionOptionId], references: [id], onDelete: Restrict, map: "rqpvio_source_revision_option_fkey")
  asset                        Asset?                             @relation("ReusablePackageVersionItemOptionAsset", fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([packageVersionItemId, choiceKey], map: "reusable_package_version_option_key")
  @@unique([packageVersionItemId, sortOrder], map: "reusable_package_version_option_order_key")
  @@map("reusable_question_package_version_item_options")
}

model TryoutPackage {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examEventId                String?                   @map("exam_event_id") @db.Uuid
  code                       String                    @unique @db.VarChar(80)
  title                      String                    @db.VarChar(220)
  description                String?                   @db.Text
  bannerMediaId              String?                   @map("banner_media_id") @db.Uuid
  assessmentType             TryoutPackageType         @default(tryout) @map("assessment_type")
  status                     ContentStatus             @default(draft)
  isHidden                   Boolean                   @default(false) @map("is_hidden")
  publishedAt                DateTime?                 @map("published_at") @db.Timestamptz
  revision                   Int                       @default(1)
  idempotencyKey             String?                   @unique @map("idempotency_key") @db.VarChar(120)
  admissionMode              TryoutAdmissionMode       @default(open) @map("admission_mode")
  defaultResultReleasePolicy TryoutResultReleasePolicy @default(automatic_at_end) @map("default_result_release_policy")
  createdByUserId            String                    @map("created_by_user_id") @db.Uuid
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  examEvent            ExamEvent?              @relation(fields: [examEventId], references: [id])
  bannerMedia          Asset?                  @relation("TryoutPackageBannerMedia", fields: [bannerMediaId], references: [id], onDelete: Restrict)
  createdBy            User                    @relation("TryoutCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sections             TryoutSection[]
  items                TryoutItem[]
  attempts             TryoutAttempt[]
  assessmentReleases   AssessmentRelease[]
  deliverySessions     TryoutDeliverySession[]
  admissions           TryoutAdmission[]
  tryoutDeliveryAudits TryoutDeliveryAudit[]

  @@index([examEventId])
  @@index([bannerMediaId])
  @@map("tryout_packages")
}

/// Immutable publication identity for one resolved Tryout form and scoring
/// policy.  The payload is the logical AssessmentRevision projection over the
/// existing package-version/TryoutItem snapshot bridge; physical snapshot
/// deduplication remains intentionally out of scope.
model AssessmentRelease {
  id                              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tryoutId                        String                       @map("tryout_id") @db.Uuid
  releaseNumber                   Int                          @map("release_number")
  contentDigest                   String                       @map("content_digest") @db.VarChar(128)
  payload                         Json                         @db.JsonB
  assemblyMode                    ReusableQuestionPackageMode? @map("assembly_mode")
  assemblyPackageId               String?                      @map("assembly_package_id") @db.Uuid
  assemblyPackageVersionId        String?                      @map("assembly_package_version_id") @db.Uuid
  resolverVersion                 String?                      @map("resolver_version") @db.VarChar(120)
  assemblySeed                    String?                      @map("assembly_seed") @db.VarChar(128)
  assemblyRequestedCount          Int?                         @map("assembly_requested_count")
  assemblyCandidateCount          Int?                         @map("assembly_candidate_count")
  assemblyQuotas                  Json?                        @map("assembly_quotas") @db.JsonB
  assemblyScopeSummary            Json?                        @map("assembly_scope_summary") @db.JsonB
  assemblyResolvedSourceIds       Json?                        @map("assembly_resolved_source_ids") @db.JsonB
  assemblyResolvedRevisionDigests Json?                        @map("assembly_resolved_revision_digests") @db.JsonB
  publishedAt                     DateTime                     @map("published_at") @db.Timestamptz
  createdByUserId                 String                       @map("created_by_user_id") @db.Uuid
  createdAt                       DateTime                     @default(now()) @map("created_at") @db.Timestamptz

  tryout                 TryoutPackage                   @relation(fields: [tryoutId], references: [id], onDelete: Restrict)
  assemblyPackage        ReusableQuestionPackage?        @relation("AssessmentReleaseAssemblyPackage", fields: [assemblyPackageId], references: [id], onDelete: Restrict)
  assemblyPackageVersion ReusableQuestionPackageVersion? @relation("AssessmentReleaseAssemblyPackageVersion", fields: [assemblyPackageVersionId], references: [id], onDelete: Restrict)
  createdBy              User                            @relation("AssessmentReleaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  deliverySessions       TryoutDeliverySession[]
  attempts               TryoutAttempt[]
  testRuns               TryoutAttemptTestRun[]

  @@unique([tryoutId, releaseNumber])
  @@unique([tryoutId, contentDigest])
  @@index([assemblyPackageId])
  @@index([assemblyPackageVersionId])
  @@index([tryoutId, createdAt])
  @@map("assessment_releases")
}

model TryoutDeliverySession {
