  moduleId        String                 @map("module_id") @db.Uuid
  assetType       ModuleAssetType        @map("asset_type")
  sourceKind      ModuleAssetSourceKind? @map("source_kind")
  managedAssetId  String?                @map("managed_asset_id") @db.Uuid
