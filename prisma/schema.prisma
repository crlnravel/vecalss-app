  approvedBy       User              @relation("TwoPlCalibrationApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@unique([questionRevisionId, modelVersion])
  @@index([questionId, modelVersion])
  @@index([modelVersion, approvalState])
  @@map("two_pl_question_calibrations")
}

model QuestionOption {
