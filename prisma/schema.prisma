/// Unified account table. Credential fields folded directly here to eliminate auth_identities table bloat.
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique
  fullName           String     @map("full_name") @db.VarChar(160)
  passwordHash       String     @map("password_hash") @db.Text
  passwordUpdatedAt  DateTime?  @map("password_updated_at") @db.Timestamptz
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  /// Non-null only for managed system subjects such as the admin student
  /// preview fixture. The value is unique so a purpose can never be claimed
  /// by more than one account.
  previewPurpose     String?    @unique @map("preview_purpose") @db.VarChar(80)
  avatarUrl          String?    @map("avatar_url") @db.Text
  phone              String?    @db.VarChar(40)
  status             UserStatus @default(active)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  softDeletedAt      DateTime?  @map("soft_deleted_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  authSessions                           AuthSession[]
  passwordResetTokens                    PasswordResetToken[]
  loginAttempts                          LoginAttempt[]
  roleAssignments                        RoleAssignment[]                     @relation("UserRoles")
  assignedRolesBy                        RoleAssignment[]                     @relation("RolesAssignedBy")
  mentorReports                          MentorReport[]
  studentProfile                         StudentProfile?                      @relation("StudentProfileAccount")
  enrolledStudents                       StudentProfile[]                     @relation("EnrolledBy")
  tutorProfile                           TutorProfile?
  kaptenVideos                           KaptenVideo[]                        @relation("KaptenVideoAuthor")
  createdModules                         Module[]                             @relation("ModuleCreatedBy")
  updatedModules                         Module[]                             @relation("ModuleUpdatedBy")
  moduleProgressions                     ModuleProgress[]
  createdQuestionBanks                   QuestionBank[]                       @relation("QuestionBankCreatedBy")
  updatedQuestionBanks                   QuestionBank[]                       @relation("QuestionBankUpdatedBy")
  questionBankMediaFolderReservations    QuestionBankMediaFolderReservation[] @relation("QuestionBankMediaFolderReservationOwner")
  questionBankXlsxImportAttempts         QuestionBankXlsxImportAttempt[]      @relation("QuestionBankXlsxImportAttemptOwner")
  createdQuestionBankFolders             QuestionBankFolder[]                 @relation("QuestionBankFolderCreatedBy")
  updatedQuestionBankFolders             QuestionBankFolder[]                 @relation("QuestionBankFolderUpdatedBy")
  createdQuestionBankCategories          QuestionBankCategory[]               @relation("QuestionBankCategoryCreatedBy")
  updatedQuestionBankCategories          QuestionBankCategory[]               @relation("QuestionBankCategoryUpdatedBy")
  assignedQuestionBankCategories         QuestionBankCategoryAssignment[]     @relation("QuestionBankCategoryAssignedBy")
  createdQuestions                       Question[]                           @relation("QuestionCreatedBy")
  updatedQuestions                       Question[]                           @relation("QuestionUpdatedBy")
  authoredQuestionRevisions              QuestionRevision[]                   @relation("QuestionRevisionCreatedBy")
  modifiedQuestionRevisions              QuestionRevision[]                   @relation("QuestionRevisionUpdatedBy")
  authoredStandaloneQuizzes              StandaloneQuiz[]                     @relation("StandaloneQuizAuthor")
  publishedStandaloneQuizVersions        StandaloneQuizVersion[]              @relation("StandaloneQuizVersionPublishedBy")
  standaloneQuizParticipations           StandaloneQuizParticipation[]
  standaloneQuizStartCommands            StandaloneQuizStartCommand[]
  quizAttempts                           QuizAttempt[]
  createdTryoutPackages                  TryoutPackage[]                      @relation("TryoutCreatedBy")
  assessmentReleasesCreated              AssessmentRelease[]                  @relation("AssessmentReleaseCreatedBy")
  createdReusableQuestionPackages        ReusableQuestionPackage[]            @relation("ReusableQuestionPackageCreatedBy")
  updatedReusableQuestionPackages        ReusableQuestionPackage[]            @relation("ReusableQuestionPackageUpdatedBy")
  createdReusableQuestionPackageVersions ReusableQuestionPackageVersion[]     @relation("ReusableQuestionPackageVersionCreatedBy")
  tryoutAttempts                         TryoutAttempt[]
  tryoutAdmissions                       TryoutAdmission[]
  tryoutDeliveryAssignmentsCreated       TryoutDeliveryAssignment[]           @relation("TryoutAssignmentCreatedBy")
  tryoutDeliverySessionsCreated          TryoutDeliverySession[]              @relation("TryoutDeliverySessionCreatedBy")
  tryoutDeliverySessionsUpdated          TryoutDeliverySession[]              @relation("TryoutDeliverySessionUpdatedBy")
  tryoutDeliverySessionsReleased         TryoutDeliverySession[]              @relation("TryoutDeliverySessionReleasedBy")
  tryoutDeliveryAudits                   TryoutDeliveryAudit[]
  topicPerformances                      StudentTopicPerformance[]
  subtestPerformances                    StudentSubtestPerformance[]
  learningRecommendations                LearningRecommendation[]
  analyticsEvents                        AnalyticsEvent[]
  missionAssignments                     DailyMissionAssignment[]
  streakFreezes                          StreakFreeze[]
  badges                                 StudentBadge[]
  weaknessAnalyses                       WeaknessAnalysis[]
  ptnStrategySessions                    PtnStrategySession[]
  uploadedAssets                         Asset[]                              @relation("UploadedBy")
  createdMediaFolders                    MediaFolder[]                        @relation("MediaFolderCreatedBy")
  createdAnnouncements                   Announcement[]                       @relation("AnnouncementCreatedBy")
  updatedAnnouncements                   Announcement[]                       @relation("AnnouncementUpdatedBy")
  updatedLandingSections                 LandingPageSection[]                 @relation("LandingSectionUpdatedBy")
  cohortMemberships                      CohortStudent[]
  assignedTutorCohorts                   TutorCohortAssignment[]              @relation("TutorAssigned")
  assignedCohortsBy                      TutorCohortAssignment[]              @relation("CohortAssignedBy")
  riskFlags                              RiskFlag[]
  tutorInterventions                     Intervention[]                       @relation("TutorIntervention")
  studentInterventions                   Intervention[]                       @relation("StudentIntervention")
  notificationPreferences                NotificationPreference?
  notificationsReceived                  Notification[]
