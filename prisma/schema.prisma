  @@index([expiresAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           AiMessageRole
  contentMarkdown String        @map("content_markdown") @db.Text
  tokenCount     Int            @default(0) @map("token_count")
  metadata       Json?          @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  conversation   AiConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AiRequest {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String             @map("student_id") @db.Uuid
  conversationId  String?            @map("conversation_id") @db.Uuid
  requestType     AiConversationType @map("request_type")
  promptTemplate  String?            @map("prompt_template") @db.VarChar(120)
  model           String?            @db.VarChar(120)
  inputTokens     Int                @default(0) @map("input_tokens")
  outputTokens    Int                @default(0) @map("output_tokens")
  status          AiRequestStatus    @default(pending)
