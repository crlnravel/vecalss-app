  student         User               @relation(fields: [studentId], references: [id])
  conversation    AiConversation?    @relation(fields: [conversationId], references: [id])

  @@index([studentId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([status])
  @@map("ai_requests")
}

model AiUsageDaily {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String   @map("student_id") @db.Uuid
  usageDate        DateTime @map("usage_date") @db.Date
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  requestCount     Int      @default(0) @map("request_count")
  limitTokens      Int      @map("limit_tokens")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  student          User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, usageDate])
  @@map("ai_usage_daily")
}

model WeaknessAnalysis {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  conversationId    String?         @map("conversation_id") @db.Uuid
  status            AiRequestStatus @default(pending)
  summaryMarkdown   String?         @map("summary_markdown") @db.Text
  tryoutSessionIds  Json?           @map("tryout_session_ids") @db.JsonB
  fallbackUsed      Boolean         @default(false) @map("fallback_used")
  generatedAt       DateTime        @default(now()) @map("generated_at") @db.Timestamptz

  student           User            @relation(fields: [studentId], references: [id])
  conversation      AiConversation? @relation(fields: [conversationId], references: [id])
  topics            WeaknessAnalysisTopic[]

  @@index([studentId])
  @@index([generatedAt])
  @@map("weakness_analyses")
}

model WeaknessAnalysisTopic {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weaknessAnalysisId String    @map("weakness_analysis_id") @db.Uuid
  topicId            String    @map("topic_id") @db.Uuid
  moduleId           String?   @map("module_id") @db.Uuid
  rank               Int
  weaknessScore      Decimal?  @map("weakness_score") @db.Decimal(6, 2)
  recommendationText String?   @map("recommendation_text") @db.Text

  weaknessAnalysis   WeaknessAnalysis @relation(fields: [weaknessAnalysisId], references: [id])
  topic              Topic            @relation(fields: [topicId], references: [id])
  module             Module?          @relation(fields: [moduleId], references: [id])

  @@unique([weaknessAnalysisId, topicId])
  @@index([rank])
  @@map("weakness_analysis_topics")
}

model AdaptivePracticeSession {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId               String          @map("student_id") @db.Uuid
  topicId                 String          @map("topic_id") @db.Uuid
