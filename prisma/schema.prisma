/// Versioned Kuis definition. The stable StandaloneQuiz row remains the
/// catalogue/ownership identity while this aggregate becomes the future
/// draft/publication boundary. Nullable links on existing child rows keep the
/// migration additive until the application cutover ticket is implemented.
model StandaloneQuizVersion {
  id                       String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                   String                                @map("quiz_id") @db.Uuid
  baseVersionId            String?                               @map("base_version_id") @db.Uuid
  state                    StandaloneQuizVersionState            @default(draft)
  versionNo                Int?                                  @map("version_no")
  title                    String                                @db.VarChar(220)
  description              String?                               @db.Text
  attemptsAllowed          Int?                                  @map("attempts_allowed")
  scorePolicy              StandaloneQuizScorePolicy              @default(latest) @map("score_policy")
  retryDelaySeconds        Int?                                  @map("retry_delay_seconds")
  formBehavior             StandaloneQuizFormBehavior             @default(same) @map("form_behavior")
  reviewTiming             StandaloneQuizReviewTiming              @default(immediate) @map("review_timing")
  correctAnswerVisibility  StandaloneQuizCorrectAnswerVisibility  @default(show) @map("correct_answer_visibility")
  sourceBankId             String?                               @map("source_bank_id") @db.Uuid
  assemblyMode             ReusableQuestionPackageMode?          @map("assembly_mode")
  assemblyPackageVersionId String?                               @map("assembly_package_version_id") @db.Uuid
  assemblyDefinitionDigest String?                               @map("assembly_definition_digest") @db.VarChar(128)
  assemblySeed             String?                               @map("assembly_seed") @db.VarChar(128)
  definitionVersion        String                                @default("kuis-assessment-definition-v1") @map("definition_version") @db.VarChar(120)
  definitionDigest         String?                               @map("definition_digest") @db.VarChar(128)
  draftRevision             Int?                                  @map("draft_revision")
  publishRequestId          String?                               @unique @map("publish_request_id") @db.Uuid
  publishedAt              DateTime?                             @map("published_at") @db.Timestamptz
  publishedByUserId        String?                               @map("published_by_user_id") @db.Uuid
  provenance               StandaloneQuizVersionProvenance       @default(runtime)
  opensAt                  DateTime?                             @map("opens_at") @db.Timestamptz
  closesAt                 DateTime?                             @map("closes_at") @db.Timestamptz
  durationSeconds          Int?                                  @map("duration_seconds")
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  quiz                     StandaloneQuiz                         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  baseVersion              StandaloneQuizVersion?                  @relation("StandaloneQuizVersionBase", fields: [baseVersionId], references: [id], onDelete: Restrict)
  derivedVersions          StandaloneQuizVersion[]                 @relation("StandaloneQuizVersionBase")
  sourceBank               QuestionBank?                           @relation("StandaloneQuizVersionSourceBank", fields: [sourceBankId], references: [id], onDelete: Restrict)
  assemblyPackageVersion   ReusableQuestionPackageVersion?          @relation("StandaloneQuizVersionAssemblyVersion", fields: [assemblyPackageVersionId], references: [id], onDelete: Restrict)
  publishedBy              User?                                   @relation("StandaloneQuizVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)
  items                    StandaloneQuizItem[]
  participations           StandaloneQuizParticipation[]
  startCommands            StandaloneQuizStartCommand[]

  @@unique([quizId, versionNo])
  @@index([quizId, state])
  @@index([sourceBankId])
  @@index([assemblyPackageVersionId])
  @@map("standalone_quiz_versions")
}

model StandaloneQuizItem {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quizId                   String                      @map("quiz_id") @db.Uuid
  quizVersionId            String?                     @map("quiz_version_id") @db.Uuid
