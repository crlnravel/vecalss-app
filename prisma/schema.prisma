  requestCount     Int      @default(0) @map("request_count")
  limitTokens      Int      @map("limit_tokens")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  student User @relation(fields: [studentId], references: [id])

  @@unique([studentId, usageDate])
  @@map("ai_usage_daily")
}

model WeaknessAnalysis {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String          @map("student_id") @db.Uuid
  conversationId   String?         @map("conversation_id") @db.Uuid
  status           AiRequestStatus @default(pending)
  summaryMarkdown  String?         @map("summary_markdown") @db.Text
  tryoutSessionIds Json?           @map("tryout_session_ids") @db.JsonB
  fallbackUsed     Boolean         @default(false) @map("fallback_used")
  generatedAt      DateTime        @default(now()) @map("generated_at") @db.Timestamptz

  student      User                    @relation(fields: [studentId], references: [id])
  conversation AiConversation?         @relation(fields: [conversationId], references: [id])
  topics       WeaknessAnalysisTopic[]

  @@index([studentId])
  @@index([generatedAt])
  @@map("weakness_analyses")
}

model WeaknessAnalysisTopic {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  weaknessAnalysisId String   @map("weakness_analysis_id") @db.Uuid
  topicId            String   @map("topic_id") @db.Uuid
  moduleId           String?  @map("module_id") @db.Uuid
  rank               Int
  weaknessScore      Decimal? @map("weakness_score") @db.Decimal(6, 2)
  recommendationText String?  @map("recommendation_text") @db.Text

  weaknessAnalysis WeaknessAnalysis @relation(fields: [weaknessAnalysisId], references: [id])
  topic            Topic            @relation(fields: [topicId], references: [id])
  module           Module?          @relation(fields: [moduleId], references: [id])

  @@unique([weaknessAnalysisId, topicId])
  @@index([rank])
  @@map("weakness_analysis_topics")
}

model AdaptivePracticeSession {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId               String          @map("student_id") @db.Uuid
  topicId                 String          @map("topic_id") @db.Uuid
  sourceConversationId    String?         @map("source_conversation_id") @db.Uuid
  difficulty              DifficultyLevel @default(adaptive)
  status                  AttemptStatus   @default(in_progress)
  fallbackQuestionBankId  String?         @map("fallback_question_bank_id") @db.Uuid
  aiGenerationDiscardedAt DateTime?       @map("ai_generation_discarded_at") @db.Timestamptz
  startedAt               DateTime        @default(now()) @map("started_at") @db.Timestamptz
  submittedAt             DateTime?       @map("submitted_at") @db.Timestamptz
  score                   Decimal?        @db.Decimal(6, 2)

  student              User                     @relation(fields: [studentId], references: [id])
  topic                Topic                    @relation(fields: [topicId], references: [id])
  sourceConversation   AiConversation?          @relation(fields: [sourceConversationId], references: [id])
  fallbackQuestionBank QuestionBank?            @relation(fields: [fallbackQuestionBankId], references: [id])
  answers              AdaptivePracticeAnswer[]

  @@index([studentId])
  @@index([topicId])
  @@index([status])
  @@map("adaptive_practice_sessions")
}

model AdaptivePracticeAnswer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adaptiveSessionId String   @map("adaptive_session_id") @db.Uuid
  questionId        String?  @map("question_id") @db.Uuid
  generatedItemRef  String?  @map("generated_item_ref") @db.VarChar(80)
  answerText        String?  @map("answer_text") @db.Text
  isCorrect         Boolean? @map("is_correct")
  answeredAt        DateTime @default(now()) @map("answered_at") @db.Timestamptz

  adaptiveSession AdaptivePracticeSession @relation(fields: [adaptiveSessionId], references: [id])
  question        Question?               @relation(fields: [questionId], references: [id])

  @@map("adaptive_practice_answers")
}

model PtnStrategySession {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String   @map("student_id") @db.Uuid
  universityId       String?  @map("university_id") @db.Uuid
  majorId            String?  @map("major_id") @db.Uuid
  conversationId     String?  @map("conversation_id") @db.Uuid
  tryoutAverageScore Decimal? @map("tryout_average_score") @db.Decimal(7, 2)
  disclaimerShown    Boolean  @default(false) @map("disclaimer_shown")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  student      User            @relation(fields: [studentId], references: [id])
  university   University?     @relation(fields: [universityId], references: [id])
  major        Major?          @relation(fields: [majorId], references: [id])
  conversation AiConversation? @relation(fields: [conversationId], references: [id])

  @@map("ptn_strategy_sessions")
}

// ─────────────────────────────────────────────
// CMS & ANNOUNCEMENTS (Unified Banners)
// ─────────────────────────────────────────────

model Asset {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedByUserId String?           @map("uploaded_by_user_id") @db.Uuid
  folderId         String?           @map("folder_id") @db.Uuid
  libraryScope     MediaLibraryScope @default(admin) @map("library_scope")
  state            MediaAssetState   @default(ready)
  objectKey        String?           @unique @map("object_key") @db.VarChar(512)
  originalName     String?           @map("original_name") @db.VarChar(255)
  url              String?           @db.Text
  mimeType         String            @map("mime_type") @db.VarChar(120)
  sizeBytes        Int               @map("size_bytes")
  width            Int?
  height           Int?
  checksum         String?           @db.VarChar(128)
  trashedAt        DateTime?         @map("trashed_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  uploadedBy                                  User?                                      @relation("UploadedBy", fields: [uploadedByUserId], references: [id])
  folder                                      MediaFolder?                               @relation(fields: [folderId], references: [id], onDelete: Restrict)
  announcements                               Announcement[]
  landingSections                             LandingPageSection[]
  questionPromptAssets                        Question[]                                 @relation("QuestionPromptAsset")
  questionExplanationAssets                   Question[]                                 @relation("QuestionExplanationAsset")
  questionOptionAssets                        QuestionOption[]                           @relation("QuestionOptionAsset")
  questionRevisionPromptAssets                QuestionRevision[]                          @relation("QuestionRevisionPromptAsset")
  questionRevisionExplanationAssets           QuestionRevision[]                          @relation("QuestionRevisionExplanationAsset")
  questionRevisionOptionAssets                QuestionRevisionOption[]                    @relation("QuestionRevisionOptionAsset")
  standaloneQuizItemPromptAssets              StandaloneQuizItem[]                       @relation("StandaloneQuizItemPromptAsset")
  standaloneQuizItemExplanationAssets         StandaloneQuizItem[]                       @relation("StandaloneQuizItemExplanationAsset")
  standaloneQuizItemOptionAssets              StandaloneQuizItemOption[]                 @relation("StandaloneQuizItemOptionAsset")
  tryoutItemPromptAssets                      TryoutItem[]                               @relation("TryoutItemPromptAsset")
  tryoutItemExplanationAssets                 TryoutItem[]                               @relation("TryoutItemExplanationAsset")
  tryoutItemOptionAssets                      TryoutItemOption[]                         @relation("TryoutItemOptionAsset")
  reusablePackageVersionItemPromptAssets      ReusableQuestionPackageVersionItem[]       @relation("ReusablePackageVersionItemPromptAsset")
  reusablePackageVersionItemExplanationAssets ReusableQuestionPackageVersionItem[]       @relation("ReusablePackageVersionItemExplanationAsset")
  reusablePackageVersionItemOptionAssets      ReusableQuestionPackageVersionItemOption[] @relation("ReusablePackageVersionItemOptionAsset")
  moduleAssets                                ModuleAsset[]                               @relation("ModuleAssetManagedAsset")

  @@index([checksum])
  @@index([libraryScope, folderId, state])
  @@index([libraryScope, originalName])
  @@map("assets")
}

model MediaFolder {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libraryScope    MediaLibraryScope @map("library_scope")
  parentId        String?           @map("parent_id") @db.Uuid
  name            String            @db.VarChar(160)
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  trashedAt       DateTime?         @map("trashed_at") @db.Timestamptz
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  MediaFolder[] @relation("MediaFolderTree")
  assets    Asset[]
  createdBy User?         @relation("MediaFolderCreatedBy", fields: [createdByUserId], references: [id])

  @@index([libraryScope, parentId, trashedAt])
  @@map("media_folders")
}

/// Unified system for banners and announcements to keep rendering pipelines clean.
model Announcement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String                @db.VarChar(180)
  body            String                @db.Text
  imageAssetId    String?               @map("image_asset_id") @db.Uuid
  ctaLabel        String?               @map("cta_label") @db.VarChar(80)
  ctaUrl          String?               @map("cta_url") @db.Text
  placement       AnnouncementPlacement @default(dashboard)
  status          ContentStatus         @default(draft)
  startsAt        DateTime?             @map("starts_at") @db.Timestamptz
  endsAt          DateTime?             @map("ends_at") @db.Timestamptz
  createdByUserId String?               @map("created_by_user_id") @db.Uuid
  updatedByUserId String?               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  imageAsset Asset? @relation(fields: [imageAssetId], references: [id])
  createdBy  User?  @relation("AnnouncementCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy  User?  @relation("AnnouncementUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("announcements")
}

model LandingPageSection {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionKey      String        @unique @map("section_key") @db.VarChar(80)
  title           String        @db.VarChar(180)
  body            String?       @db.Text
  ctaLabel        String?       @map("cta_label") @db.VarChar(80)
  ctaUrl          String?       @map("cta_url") @db.Text
  imageAssetId    String?       @map("image_asset_id") @db.Uuid
  status          ContentStatus @default(draft)
  sortOrder       Int           @default(0) @map("sort_order")
  updatedByUserId String?       @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  imageAsset Asset? @relation(fields: [imageAssetId], references: [id])
  updatedBy  User?  @relation("LandingSectionUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("landing_page_sections")
}

// ─────────────────────────────────────────────
// COHORTS & TUTOR MONITORING
// ─────────────────────────────────────────────

model Cohort {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examEventId String?   @map("exam_event_id") @db.Uuid
  name        String    @db.VarChar(180)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  examEvent        ExamEvent?              @relation(fields: [examEventId], references: [id])
  students         CohortStudent[]
  tutorAssignments TutorCohortAssignment[]
  riskFlags        RiskFlag[]
  interventions    Intervention[]

  @@map("cohorts")
}

model CohortStudent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId  String    @map("cohort_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz

  cohort  Cohort @relation(fields: [cohortId], references: [id])
  student User   @relation(fields: [studentId], references: [id])

  @@index([cohortId, studentId])
  @@index([studentId])
  @@map("cohort_students")
}

model TutorCohortAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId          String    @map("tutor_id") @db.Uuid
  cohortId         String    @map("cohort_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  tutor      User   @relation("TutorAssigned", fields: [tutorId], references: [id])
  cohort     Cohort @relation(fields: [cohortId], references: [id])
  assignedBy User?  @relation("CohortAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([tutorId, cohortId])
  @@map("tutor_cohort_assignments")
}

model RiskFlag {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String         @map("student_id") @db.Uuid
  cohortId   String?        @map("cohort_id") @db.Uuid
  flagType   String         @map("flag_type") @db.VarChar(80)
  severity   Int            @default(1)
  reason     String?        @db.Text
  status     RiskFlagStatus @default(open)
  detectedAt DateTime       @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz

  student       User           @relation(fields: [studentId], references: [id])
  cohort        Cohort?        @relation(fields: [cohortId], references: [id])
  interventions Intervention[]

  @@index([studentId])
  @@index([cohortId])
  @@index([status])
  @@index([severity])
  @@map("risk_flags")
}

model Intervention {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId             String             @map("tutor_id") @db.Uuid
  studentId           String             @map("student_id") @db.Uuid
  cohortId            String?            @map("cohort_id") @db.Uuid
  riskFlagId          String?            @map("risk_flag_id") @db.Uuid
  recommendedModuleId String?            @map("recommended_module_id") @db.Uuid
  message             String             @db.Text
  status              InterventionStatus @default(drafted)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  sentAt              DateTime?          @map("sent_at") @db.Timestamptz
  readAt              DateTime?          @map("read_at") @db.Timestamptz

  tutor             User      @relation("TutorIntervention", fields: [tutorId], references: [id])
  student           User      @relation("StudentIntervention", fields: [studentId], references: [id])
  cohort            Cohort?   @relation(fields: [cohortId], references: [id])
  riskFlag          RiskFlag? @relation(fields: [riskFlagId], references: [id])
  recommendedModule Module?   @relation(fields: [recommendedModuleId], references: [id])

  @@index([tutorId])
  @@index([studentId])
  @@index([status])
  @@map("interventions")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model NotificationPreference {
  userId                String   @id @map("user_id") @db.Uuid
  inAppEnabled          Boolean  @default(true) @map("in_app_enabled")
  emailEnabled          Boolean  @default(true) @map("email_enabled")
  pushEnabled           Boolean  @default(false) @map("push_enabled")
  smsEnabled            Boolean  @default(false) @map("sms_enabled")
  marketingEmailEnabled Boolean  @default(true) @map("marketing_email_enabled")
  smsAlertsEnabled      Boolean  @default(false) @map("sms_alerts_enabled")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model Notification {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId  String                @map("recipient_user_id") @db.Uuid
  eventType        NotificationEventType @map("event_type")
  title            String                @db.VarChar(180)
  body             String                @db.Text
  deepLink         String?               @map("deep_link") @db.Text
  priority         Int                   @default(0)
  sourceEntityType String?               @map("source_entity_type") @db.VarChar(80)
  sourceEntityId   String?               @map("source_entity_id") @db.Uuid
  readAt           DateTime?             @map("read_at") @db.Timestamptz
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime?             @map("expires_at") @db.Timestamptz

  recipient  User                   @relation(fields: [recipientUserId], references: [id])
  deliveries NotificationDelivery[]

  @@index([recipientUserId])
  @@index([eventType])
  @@index([readAt])
  @@index([createdAt])
  @@index([sourceEntityType, sourceEntityId])
  @@map("notifications")
}

model NotificationDelivery {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId    String              @map("notification_id") @db.Uuid
  channel           NotificationChannel
  status            NotificationStatus  @default(queued)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  queuedAt          DateTime            @default(now()) @map("queued_at") @db.Timestamptz
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz
  retryCount        Int                 @default(0) @map("retry_count")
  lastError         String?             @map("last_error") @db.Text

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@map("notification_deliveries")
}

// ─────────────────────────────────────────────
// BILLING & SYSTEM
// ─────────────────────────────────────────────

model BillingAccount {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String        @unique @map("student_id") @db.Uuid
  status           BillingStatus @default(trial)
  planCode         String?       @map("plan_code") @db.VarChar(80)
  accessStartsAt   DateTime?     @map("access_starts_at") @db.Timestamptz
  accessExpiresAt  DateTime?     @map("access_expires_at") @db.Timestamptz
  extendedByUserId String?       @map("extended_by_user_id") @db.Uuid
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  student    User  @relation("StudentBilling", fields: [studentId], references: [id])
  extendedBy User? @relation("BillingExtendedBy", fields: [extendedByUserId], references: [id])

  @@map("billing_accounts")
}

model SystemConfig {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey             String   @unique @map("config_key") @db.VarChar(120)
  configValue           Json     @map("config_value") @db.JsonB
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz
  draftValue            Json?    @map("draft_value") @db.JsonB
  draftUpdatedByUserId  String?  @map("draft_updated_by_user_id") @db.Uuid
  draftUpdatedAt        DateTime? @map("draft_updated_at") @db.Timestamptz
  publishedByUserId     String?  @map("published_by_user_id") @db.Uuid
  publishedAt           DateTime? @map("published_at") @db.Timestamptz

  updatedBy       User? @relation("SystemConfigUpdatedBy", fields: [updatedByUserId], references: [id])
  draftUpdatedBy  User? @relation("SystemConfigDraftUpdatedBy", fields: [draftUpdatedByUserId], references: [id])
  publishedBy     User? @relation("SystemConfigPublishedBy", fields: [publishedByUserId], references: [id])

  @@map("system_configs")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String?  @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent") @db.Text
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
