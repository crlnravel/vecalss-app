  settledUsdMicros  BigInt             @default(0) @map("settled_usd_micros")
  unknownUsdMicros  BigInt             @default(0) @map("unknown_usd_micros")
  releasedUsdMicros BigInt             @default(0) @map("released_usd_micros")
