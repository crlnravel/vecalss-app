model ReusableQuestionPackageItem {
  id                       String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId                String                      @map("package_id") @db.Uuid
  sourceQuestionId         String                      @map("source_question_id") @db.Uuid
