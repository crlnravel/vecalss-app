generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserStatus {
  active
  locked
  disabled
  soft_deleted

  @@map("user_status")
}

enum RoleName {
  student
  tutor
  admin

  @@map("role_name")
}

enum SessionStatus {
  active
  revoked
  expired

  @@map("session_status")
}

enum LoginAttemptResult {
  success
  failed
  locked
  service_unavailable

  @@map("login_attempt_result")
}

enum OnboardingStatus {
  not_started
  completed
  skipped

  @@map("onboarding_status")
}

enum UniversityType {
  ptn
  private
  other

  @@map("university_type")
}

enum ContentStatus {
  draft
  scheduled
  published
  archived

  @@map("content_status")
}

enum MediaLibraryScope {
  kapten
  admin

  @@map("media_library_scope")
}

enum MediaAssetState {
  pending
  ready
  trashed
  failed

  @@map("media_asset_state")
}

enum ModuleAssetType {
  text
  video
  example
  attachment

  @@map("module_asset_type")
}

enum ProgressStatus {
  locked
  not_started
  in_progress
  completed

  @@map("progress_status")
}

enum QuestionType {
  single_choice
  multiple_choice
  free_text

  @@map("question_type")
}

enum DifficultyLevel {
  easy
  medium
  hard
  adaptive

  @@map("difficulty_level")
}

enum TryoutPackageType {
  tryout
  diagnostic

  @@map("tryout_package_type")
}

enum MissionTaskType {
  daily_mission
  smart_drill

  @@map("mission_task_type")
}

enum AttemptStatus {
  in_progress
  submitted
  auto_submitted
  expired
  abandoned
  scored

  @@map("attempt_status")
}

enum AnswerSource {
  server
  client
  client_offline_buffer

  @@map("answer_source")
}

enum SyncStatus {
  pending
  synced
  failed
  discarded

  @@map("sync_status")
}

enum MissionStatus {
  assigned
  in_progress
  verifying
  completed
  failed
  expired

  @@map("mission_status")
}

enum BadgeStatus {
  earned
  revoked

  @@map("badge_status")
}

enum StreakFreezeStatus {
  available
  consumed
  expired

  @@map("streak_freeze_status")
}

enum AiConversationType {
  vera_chat
  weakness_analysis
  ptn_strategy
  smart_drill

  @@map("ai_conversation_type")
}

enum AiMessageRole {
  system
  user
  assistant
  tool

  @@map("ai_message_role")
}

enum AiRequestStatus {
  pending
  succeeded
  failed
  fallback

  @@map("ai_request_status")
}

enum RecommendationStatus {
  active
  clicked
  dismissed
  completed
  expired

  @@map("recommendation_status")
}

enum AnnouncementPlacement {
  landing_top
  dashboard
  sidebar
  breaking

  @@map("announcement_placement")
}

enum NotificationChannel {
  in_app
  email
  push
  sms

  @@map("notification_channel")
}

enum NotificationStatus {
  queued
  delivered
  failed
  dropped
  read

  @@map("notification_status")
}

enum NotificationEventType {
  daily_mission
  tryout_graded
  tutor_intervention
  announcement
  password_reset
  purchase_receipt
  inactivity
  custom

  @@map("notification_event_type")
}

enum AnalyticsEventType {
  page_view
  dashboard_view
  recommendation_click
  module_open
  quiz_submit
  tryout_submit
  ai_interaction
  notification_click
  admin_action

  @@map("analytics_event_type")
}

enum BillingStatus {
  trial
  active
  expired
  suspended
  cancelled

  @@map("billing_status")
}

enum RiskFlagStatus {
  open
  acknowledged
  resolved
  dismissed

  @@map("risk_flag_status")
}

enum InterventionStatus {
  drafted
  queued
  sent
  read
  failed

  @@map("intervention_status")
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

/// Unified account table. Credential fields folded directly here to eliminate auth_identities table bloat.
model User {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String      @unique
  fullName             String      @map("full_name") @db.VarChar(160)
  passwordHash         String      @map("password_hash") @db.Text
  passwordUpdatedAt    DateTime?   @map("password_updated_at") @db.Timestamptz
  mustChangePassword   Boolean     @default(false) @map("must_change_password")
  avatarUrl            String?     @map("avatar_url") @db.Text
  phone                String?     @db.VarChar(40)
  status               UserStatus  @default(active)
  lastLoginAt          DateTime?   @map("last_login_at") @db.Timestamptz
  failedLoginCount     Int         @default(0) @map("failed_login_count")
  lockedUntil          DateTime?   @map("locked_until") @db.Timestamptz
  softDeletedAt        DateTime?   @map("soft_deleted_at") @db.Timestamptz
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  authSessions              AuthSession[]
  passwordResetTokens       PasswordResetToken[]
  loginAttempts             LoginAttempt[]
  roleAssignments           RoleAssignment[]           @relation("UserRoles")
  assignedRolesBy           RoleAssignment[]           @relation("RolesAssignedBy")
  studentProfile            StudentProfile?            @relation("StudentProfileAccount")
  enrolledStudents          StudentProfile[]           @relation("EnrolledBy")
  tutorProfile              TutorProfile?
  createdModules            Module[]                   @relation("ModuleCreatedBy")
  updatedModules            Module[]                   @relation("ModuleUpdatedBy")
  moduleProgressions        ModuleProgress[]
  createdQuestionBanks      QuestionBank[]             @relation("QuestionBankCreatedBy")
  updatedQuestionBanks      QuestionBank[]             @relation("QuestionBankUpdatedBy")
  createdQuestions          Question[]                 @relation("QuestionCreatedBy")
  updatedQuestions          Question[]                 @relation("QuestionUpdatedBy")
  authoredStandaloneQuizzes StandaloneQuiz[]           @relation("StandaloneQuizAuthor")
  standaloneQuizAttempts   StandaloneQuizAttempt[]
  quizAttempts              QuizAttempt[]
  createdTryoutPackages     TryoutPackage[]            @relation("TryoutCreatedBy")
  tryoutSessions            TryoutSession[]
  offlineAnswerBuffers      OfflineAnswerBuffer[]
  topicPerformances         StudentTopicPerformance[]
  subtestPerformances       StudentSubtestPerformance[]
  learningRecommendations   LearningRecommendation[]
  analyticsEvents           AnalyticsEvent[]
  missionAssignments        DailyMissionAssignment[]
  streakFreezes             StreakFreeze[]
  badges                    StudentBadge[]
  aiConversations           AiConversation[]
  aiRequests                AiRequest[]
  aiUsageDaily              AiUsageDaily[]
  weaknessAnalyses          WeaknessAnalysis[]
  adaptivePracticeSessions  AdaptivePracticeSession[]
  ptnStrategySessions       PtnStrategySession[]
  uploadedAssets            Asset[]                    @relation("UploadedBy")
  createdMediaFolders       MediaFolder[]              @relation("MediaFolderCreatedBy")
  createdAnnouncements      Announcement[]             @relation("AnnouncementCreatedBy")
  updatedAnnouncements      Announcement[]             @relation("AnnouncementUpdatedBy")
  updatedLandingSections    LandingPageSection[]       @relation("LandingSectionUpdatedBy")
  cohortMemberships         CohortStudent[]
  assignedTutorCohorts      TutorCohortAssignment[]    @relation("TutorAssigned")
  assignedCohortsBy         TutorCohortAssignment[]    @relation("CohortAssignedBy")
  riskFlags                 RiskFlag[]
  tutorInterventions        Intervention[]             @relation("TutorIntervention")
  studentInterventions      Intervention[]             @relation("StudentIntervention")
  notificationPreferences   NotificationPreference?
  notificationsReceived     Notification[]
  billingAccounts           BillingAccount[]           @relation("StudentBilling")
  extendedBillingAccounts   BillingAccount[]           @relation("BillingExtendedBy")
  updatedSystemConfigs      SystemConfig[]
  auditLogs                 AuditLog[]

  @@map("users")
}

model AuthSession {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @map("refresh_token_hash") @db.Text
  status           SessionStatus @default(active)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz
  lastSeenAt       DateTime?     @map("last_seen_at") @db.Timestamptz
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.Text

  user             User          @relation(fields: [userId], references: [id])

  @@unique([refreshTokenHash])
  @@index([userId])
  @@map("auth_sessions")
}

/// Handles self-service resets and first-login credential overrides.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  ipAddress   String?   @map("ip_address") @db.Inet

  user        User      @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @db.Text // Note: maps logically to citext compatibility
  userId        String?            @map("user_id") @db.Uuid
  result        LoginAttemptResult
  failureReason String?            @map("failure_reason") @db.Text
  attemptedAt   DateTime           @default(now()) @map("attempted_at") @db.Timestamptz
  ipAddress     String?            @map("ip_address") @db.Inet
  userAgent     String?            @map("user_agent") @db.Text

  user          User?              @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([attemptedAt])
  @@map("login_attempts")
}

model RoleAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  role             RoleName
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  user             User      @relation("UserRoles", fields: [userId], references: [id])
  assignedBy       User?     @relation("RolesAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([userId, role])
  @@map("role_assignments")
}

// ─────────────────────────────────────────────
// PROFILES
// ─────────────────────────────────────────────

model StudentProfile {
  userId             String           @id @map("user_id") @db.Uuid
  displayName        String?          @map("display_name") @db.VarChar(120)
  onboardingStatus   OnboardingStatus @default(not_started) @map("onboarding_status")
  targetExamEventId  String?          @map("target_exam_event_id") @db.Uuid
  targetUniversityId String?          @map("target_university_id") @db.Uuid
  targetMajorId      String?          @map("target_major_id") @db.Uuid
  currentStreak      Int              @default(0) @map("current_streak")
  longestStreak      Int              @default(0) @map("longest_streak")
  lastStreakDate     DateTime?        @map("last_streak_date") @db.Date
  dailyAiTokenLimit  Int              @default(10000) @map("daily_ai_token_limit")
  timezone           String           @default("Asia/Jakarta") @db.VarChar(64)
  enrolledByUserId   String?          @map("enrolled_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User             @relation("StudentProfileAccount", fields: [userId], references: [id])
  targetExamEvent    ExamEvent?       @relation(fields: [targetExamEventId], references: [id])
  targetUniversity   University?      @relation(fields: [targetUniversityId], references: [id])
  targetMajor        Major?           @relation(fields: [targetMajorId], references: [id])
  enrolledBy         User?            @relation("EnrolledBy", fields: [enrolledByUserId], references: [id])

  @@map("student_profiles")
}

model TutorProfile {
  userId    String   @id @map("user_id") @db.Uuid
  headline  String?  @db.VarChar(160)
  bio       String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id])

  @@map("tutor_profiles")
}

// ─────────────────────────────────────────────
// EXAM PROGRAMS & REFERENCES
// ─────────────────────────────────────────────

model ExamProgram {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique @db.VarChar(40)
  name        String      @db.VarChar(160)
  description String?     @db.Text
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  examEvents  ExamEvent[]

  @@map("exam_programs")
}

model ExamEvent {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examProgramId String           @map("exam_program_id") @db.Uuid
  name          String           @db.VarChar(160)
  examDate      DateTime?        @map("exam_date") @db.Date
  registrationUrl String?        @map("registration_url") @db.Text
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  examProgram   ExamProgram      @relation(fields: [examProgramId], references: [id])
  studentProfiles StudentProfile[]
  admissionStats AdmissionStat[]
  tryoutPackages TryoutPackage[]
  cohorts        Cohort[]

  @@index([examProgramId])
  @@index([examDate])
  @@map("exam_events")
}

model University {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(200)
  shortName       String?          @map("short_name") @db.VarChar(40)
  type            UniversityType   @default(ptn)
  city            String?          @db.VarChar(120)
  province        String?          @db.VarChar(120)
  officialUrl     String?          @map("official_url") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  studentProfiles StudentProfile[]
  majors          Major[]
  ptnStrategySessions PtnStrategySession[]

  @@index([name])
  @@map("universities")
}

model Major {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String         @map("university_id") @db.Uuid
  name         String         @db.VarChar(200)
  faculty      String?        @db.VarChar(160)
  degreeLevel  String?        @map("degree_level") @db.VarChar(40)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  university   University     @relation(fields: [universityId], references: [id])
  studentProfiles StudentProfile[]
  admissionStats AdmissionStat[]
  ptnStrategySessions PtnStrategySession[]

  @@unique([universityId, name])
  @@map("majors")
}

model AdmissionStat {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  majorId     String    @map("major_id") @db.Uuid
  examEventId String?   @map("exam_event_id") @db.Uuid
  year        Int
  passingGrade Decimal? @map("passing_grade") @db.Decimal(6, 2)
  quota       Int?
  applicants  Int?
  accepted    Int?
  sourceUrl   String?   @map("source_url") @db.Text
  auditedAt   DateTime? @map("audited_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  major       Major     @relation(fields: [majorId], references: [id])
  examEvent   ExamEvent? @relation(fields: [examEventId], references: [id])

  @@unique([majorId, year])
  @@index([examEventId])
  @@map("admission_stats")
}

// ─────────────────────────────────────────────
// TAXONOMY
// ─────────────────────────────────────────────

model Subtest {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String      @unique @db.VarChar(40)
  name        String      @db.VarChar(160)
  description String?     @db.Text
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  topics      Topic[]
  questionBanks QuestionBank[]
  tryoutSections TryoutSection[]
  tryoutScoreBreakdowns TryoutScoreBreakdown[]
  subtestPerformances StudentSubtestPerformance[]

  @@map("subtests")
}

model Topic {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subtestId     String    @map("subtest_id") @db.Uuid
  parentTopicId String?   @map("parent_topic_id") @db.Uuid
  code          String    @db.VarChar(80)
  name          String    @db.VarChar(200)
  description   String?   @db.Text
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subtest       Subtest   @relation(fields: [subtestId], references: [id])
  parentTopic   Topic?    @relation("TopicHierarchy", fields: [parentTopicId], references: [id])
  childTopics   Topic[]   @relation("TopicHierarchy")
  modules       Module[]
  questionBanks QuestionBank[]
  questions     Question[]
  tryoutScoreBreakdowns TryoutScoreBreakdown[]
  topicPerformances StudentTopicPerformance[]
  learningRecommendations LearningRecommendation[]
  missionTemplates MissionTemplate[]
  weaknessAnalysisTopics WeaknessAnalysisTopic[]
  adaptivePracticeSessions AdaptivePracticeSession[]

  @@unique([subtestId, code])
  @@index([parentTopicId])
  @@map("topics")
}

// ─────────────────────────────────────────────
// LEARNING MODULES
// ─────────────────────────────────────────────

model Module {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topicId          String        @map("topic_id") @db.Uuid
  code             String        @unique @db.VarChar(80)
  title            String        @db.VarChar(220)
  summary          String?       @db.Text
  sequenceNo       Int           @map("sequence_no")
  estimatedMinutes Int?          @map("estimated_minutes")
  status           ContentStatus @default(draft)
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz
  createdByUserId  String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId  String?       @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  topic            Topic         @relation(fields: [topicId], references: [id])
  createdBy        User?         @relation("ModuleCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy        User?         @relation("ModuleUpdatedBy", fields: [updatedByUserId], references: [id])
  assets           ModuleAsset[]
  
  // Explicit self many-to-many configurations
  prerequisites    ModulePrerequisite[] @relation("DependentModules")
  requiredBy       ModulePrerequisite[] @relation("PrerequisiteModules")
  
  progressions     ModuleProgress[]
  quiz             ModuleQuiz?
  learningRecommendations LearningRecommendation[]
  weaknessAnalysisTopics WeaknessAnalysisTopic[]
  interventions    Intervention[]

  @@unique([topicId, sequenceNo])
  @@index([status])
  @@map("modules")
}

model ModuleAsset {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId        String          @map("module_id") @db.Uuid
  assetType       ModuleAssetType @map("asset_type")
  title           String?         @db.VarChar(220)
  bodyText        String?         @map("body_text") @db.Text
  mediaUrl        String?         @map("media_url") @db.Text
  durationSeconds Int?            @map("duration_seconds")
  sortOrder       Int             @default(0) @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  module          Module          @relation(fields: [moduleId], references: [id])

  @@unique([moduleId, sortOrder])
  @@map("module_assets")
}

model ModulePrerequisite {
  moduleId               String @map("module_id") @db.Uuid
  prerequisiteModuleId   String @map("prerequisite_module_id") @db.Uuid

  module                 Module @relation("DependentModules", fields: [moduleId], references: [id])
  prerequisiteModule     Module @relation("PrerequisiteModules", fields: [prerequisiteModuleId], references: [id])

  @@id([moduleId, prerequisiteModuleId])
  @@map("module_prerequisites")
}

model ModuleProgress {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId           String         @map("student_id") @db.Uuid
  moduleId            String         @map("module_id") @db.Uuid
  status              ProgressStatus @default(locked)
  percentComplete     Decimal        @default(0) @map("percent_complete") @db.Decimal(5, 2)
  videoPositionSeconds Int           @default(0) @map("video_position_seconds")
  scrollPosition      Int            @default(0) @map("scroll_position")
  unlockedAt          DateTime?      @map("unlocked_at") @db.Timestamptz
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz
  lastOpenedAt        DateTime?      @map("last_opened_at") @db.Timestamptz
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student             User           @relation(fields: [studentId], references: [id])
  module              Module         @relation(fields: [moduleId], references: [id])

  @@unique([studentId, moduleId])
  @@index([status])
  @@map("module_progress")
}

// ─────────────────────────────────────────────
// QUESTION BANKS
// ─────────────────────────────────────────────

model QuestionBank {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String        @db.VarChar(200)
  description     String?       @db.Text
  subtestId       String?       @map("subtest_id") @db.Uuid
  topicId         String?       @map("topic_id") @db.Uuid
  status          ContentStatus @default(draft)
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId String?       @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subtest         Subtest?      @relation(fields: [subtestId], references: [id])
  topic           Topic?        @relation(fields: [topicId], references: [id])
  createdBy       User?         @relation("QuestionBankCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy       User?         @relation("QuestionBankUpdatedBy", fields: [updatedByUserId], references: [id])
  questions       Question[]
  adaptivePracticeSessions AdaptivePracticeSession[]

  @@map("question_banks")
}

model Question {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questionBankId  String?         @map("question_bank_id") @db.Uuid
  topicId         String          @map("topic_id") @db.Uuid
  stem            String          @db.Text
  questionType    QuestionType    @default(single_choice) @map("question_type")
  difficulty      DifficultyLevel @default(medium)
