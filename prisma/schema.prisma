// ─────────────────────────────────────────────

model BillingAccount {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId       String        @unique @map("student_id") @db.Uuid
  status          BillingStatus @default(trial)
  planCode        String?       @map("plan_code") @db.VarChar(80)
  accessStartsAt  DateTime?     @map("access_starts_at") @db.Timestamptz
  accessExpiresAt DateTime?     @map("access_expires_at") @db.Timestamptz
  extendedByUserId String?      @map("extended_by_user_id") @db.Uuid
  updatedAt       DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  student         User          @relation("StudentBilling", fields: [studentId], references: [id])
  extendedBy      User?         @relation("BillingExtendedBy", fields: [extendedByUserId], references: [id])

  @@map("billing_accounts")
}

model SystemConfig {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey       String   @unique @map("config_key") @db.VarChar(120)
  configValue     Json     @map("config_value") @db.JsonB
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  updatedBy       User?    @relation(fields: [updatedByUserId], references: [id])

  @@map("system_configs")
}

model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  action       String    @db.VarChar(120)
  targetType   String?   @map("target_type") @db.VarChar(80)
  targetId     String?   @map("target_id") @db.Uuid
  metadata     Json?     @db.JsonB
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent") @db.Text
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz

  actor        User?     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
