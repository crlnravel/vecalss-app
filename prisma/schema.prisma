  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  queuedAt          DateTime            @default(now()) @map("queued_at") @db.Timestamptz
  deliveredAt       DateTime?           @map("delivered_at") @db.Timestamptz
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz
  retryCount        Int                 @default(0) @map("retry_count")
  lastError         String?             @map("last_error") @db.Text

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@map("notification_deliveries")
}

// ─────────────────────────────────────────────
// BILLING & SYSTEM
// ─────────────────────────────────────────────

model BillingAccount {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId        String        @unique @map("student_id") @db.Uuid
  status           BillingStatus @default(trial)
  planCode         String?       @map("plan_code") @db.VarChar(80)
  accessStartsAt   DateTime?     @map("access_starts_at") @db.Timestamptz
  accessExpiresAt  DateTime?     @map("access_expires_at") @db.Timestamptz
  extendedByUserId String?       @map("extended_by_user_id") @db.Uuid
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  student    User                 @relation("StudentBilling", fields: [studentId], references: [id])
  extendedBy User?                @relation("BillingExtendedBy", fields: [extendedByUserId], references: [id])
  events     BillingAccessEvent[]

  @@map("billing_accounts")
}

/// Append-only history of every change to a student's paid access. The row in
/// `billing_accounts` is the current state; this table says how it got there.
/// Updates and deletes are rejected by a trigger, like `audit_logs`.
model BillingAccessEvent {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingAccountId String                 @map("billing_account_id") @db.Uuid
  studentId        String                 @map("student_id") @db.Uuid
  kind             BillingAccessEventKind
  source           BillingAccessSource
  /// Null only for a payment source (MS-08), which names its payment in `idempotencyKey`.
  actorUserId      String?                @map("actor_user_id") @db.Uuid
  reason           String                 @db.VarChar(500)
  planCode         String?                @map("plan_code") @db.VarChar(80)
  /// The access window and status the account had right after this event.
  startsAt         DateTime?              @map("starts_at") @db.Timestamptz
  endsAt           DateTime?              @map("ends_at") @db.Timestamptz
  resultingStatus  BillingStatus          @map("resulting_status")
  /// Repeating an operation with the same key is a no-op.
  idempotencyKey   String                 @unique @map("idempotency_key") @db.VarChar(120)
  occurredAt       DateTime               @default(now()) @map("occurred_at") @db.Timestamptz

  account BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  student User           @relation("BillingAccessEventStudent", fields: [studentId], references: [id], onDelete: Restrict)
  actor   User?          @relation("BillingAccessEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  receipt         PaymentReceipt?
  usageEvents     FulfillmentUsageEvent[]

  @@index([studentId, occurredAt])
  @@map("billing_access_events")
}

/// One admin-assigned referral identity for an affiliator. The code may be
/// rotated by replacing this value; purchase rows keep their own immutable
/// code snapshot for historical reporting.
model AffiliatorProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  referralCode String   @unique @map("referral_code") @db.VarChar(40)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  packagePurchases PackagePurchase[]
  paymentOrders    PaymentOrder[]

  @@index([isActive, referralCode])
  @@map("affiliator_profiles")
}

enum PackagePurchaseStatus {
  pending
  succeeded
  failed
  refunded
  cancelled

  @@map("package_purchase_status")
}

/// Where a purchase summary came from. `incomplete` rows predate trusted
/// orders (or arrive through the provisional callback): they carry no amount,
/// currency, buyer IP or provider evidence, and none is back-filled.
enum PackagePurchaseProvenance {
  incomplete
  order

  @@map("package_purchase_provenance")
}

/// First-party package purchase evidence. Package fields and the referral
/// code are snapshots because catalogues and codes can change later.
model PackagePurchase {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String                    @map("student_id") @db.Uuid
  packageCode          String                    @map("package_code") @db.VarChar(80)
  packageName          String                    @map("package_name") @db.VarChar(220)
  status               PackagePurchaseStatus     @default(pending)
  affiliatorProfileId  String?                   @map("affiliator_profile_id") @db.Uuid
  referralCodeSnapshot String?                   @map("referral_code_snapshot") @db.VarChar(40)
  providerReference    String                    @unique @map("provider_reference") @db.VarChar(160)
  completedAt          DateTime?                 @map("completed_at") @db.Timestamptz
  provenance           PackagePurchaseProvenance @default(incomplete)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student           User               @relation("PackagePurchaseStudent", fields: [studentId], references: [id], onDelete: Restrict)
  affiliatorProfile AffiliatorProfile? @relation(fields: [affiliatorProfileId], references: [id], onDelete: SetNull)
  paymentOrder      PaymentOrder?

  @@index([studentId, createdAt])
  @@index([affiliatorProfileId, status, completedAt])
  @@index([status, completedAt])
  @@map("package_purchases")
}

/// A buyer's server-recorded request to start checkout. The quote (month and
/// rupiah amount) is a snapshot taken at submission, and the referral is the
/// normalized active code. `idempotencyKey` is minted when the checkout page
/// renders, so a retried submission reuses one row. Rendering and GET/HEAD
/// never write here. It is not an order: it holds no reservation and no
/// provider session.
model CheckoutIntent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  plan           String   @db.VarChar(20)
  pricingMonth   String   @map("pricing_month") @db.VarChar(7)
  amountRupiah   Int      @map("amount_rupiah")
  referralCode   String?  @map("referral_code") @db.VarChar(40)
  /// The version of the "Syarat Pembelian" the buyer ticked on the checkout
  /// form. Null only on intents made before MS-08; the database refuses an
  /// order whose intent has none.
  termsVersion   String?  @map("terms_version") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// A retry may reuse this intent (and its quote) only before this time;
  /// afterwards the buyer must confirm the current price on a fresh page.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  buyer User          @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  order PaymentOrder?

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt])
  @@map("checkout_intents")
}

enum PaymentOrderStatus {
  pending
  paid
  failed
  expired
  review

  @@map("payment_order_status")
}

enum PaymentEventType {
  succeeded
  failed
  expired

  @@map("payment_event_type")
}

enum PaymentEventSource {
  webhook
  reconciliation

  @@map("payment_event_source")
}

enum PaymentEventOutcome {
  accepted
  declined
  expired
  review
  quarantined
  ignored

  @@map("payment_event_outcome")
}

enum PaymentOutboxKind {
  receipt_email
  critical_alert
  access_grant

  @@map("payment_outbox_kind")
}

enum PaymentOutboxStatus {
  pending
  done
  dead

  @@map("payment_outbox_status")
}

/// The trusted record of one checkout: a snapshot of the quote taken from the
/// buyer's intent, plus the payment state. Everything except the columns that
/// move with the payment is frozen, and `status` only follows the transitions
/// the database trigger allows (pending to paid, failed or expired; failed or
/// expired to review). Rows are never deleted. One intent leads to at most one
/// order, and an order has at most one payable provider session.
model PaymentOrder {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intentId            String   @unique @map("intent_id") @db.Uuid
  buyerId             String   @map("buyer_id") @db.Uuid
  /// Opaque token shared with the provider (its idempotency key for session
  /// creation) and used in the browser's status link. Not the order id.
  reference           String   @unique @db.VarChar(64)
  plan                String   @db.VarChar(20)
  pricingMonth        String   @map("pricing_month") @db.VarChar(7)
  quoteVersion        Int      @default(1) @map("quote_version")
  packageCode         String   @map("package_code") @db.VarChar(80)
  packageName         String   @map("package_name") @db.VarChar(220)
  amountRupiah        Int      @map("amount_rupiah")
  currency            String   @default("IDR") @db.VarChar(3)
  referralCode        String?  @map("referral_code") @db.VarChar(40)
  affiliatorProfileId String?  @map("affiliator_profile_id") @db.Uuid
  buyerIp             String?  @map("buyer_ip") @db.Inet
  /// How `buyerIp` was obtained, for example `trusted-proxy:1` or `unavailable`.
  buyerIpSource       String   @map("buyer_ip_source") @db.VarChar(40)
  /// Why an order exists without a buyer IP (the local stand-in has no trusted
  /// proxy). Null on every order that carries an IP; the database refuses a new
  /// order that has neither.
  buyerIpExemption    String?  @map("buyer_ip_exemption") @db.VarChar(60)
  /// HMAC lookup token of the first-party device cookie at checkout. The cookie
  /// value itself is never stored. Null when the order had no device cookie.
  deviceLookupToken   String?  @map("device_lookup_token") @db.VarChar(64)
  /// The "Syarat Pembelian" version the buyer agreed to; frozen at creation.
  /// Legacy orders (made before MS-08) have none.
  termsVersion        String?  @map("terms_version") @db.VarChar(40)
  provider            String   @db.VarChar(40)
  providerEnvironment String   @map("provider_environment") @db.VarChar(40)
  providerAccount     String   @map("provider_account") @db.VarChar(80)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt           DateTime @map("expires_at") @db.Timestamptz

  status             PaymentOrderStatus @default(pending)
  statusChangedAt    DateTime           @default(now()) @map("status_changed_at") @db.Timestamptz
  statusReason       String?            @map("status_reason") @db.VarChar(120)
  paidAt             DateTime?          @map("paid_at") @db.Timestamptz
  /// The provider's own payment id. Set once, from the session or an early event.
  providerReference  String?            @map("provider_reference") @db.VarChar(160)
  sessionUrl         String?            @map("session_url") @db.Text
  sessionAttempts    Int                @default(0) @map("session_attempts")
  sessionRequestedAt DateTime?          @map("session_requested_at") @db.Timestamptz
  packagePurchaseId  String?            @unique @map("package_purchase_id") @db.Uuid
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz

  intent          CheckoutIntent     @relation(fields: [intentId], references: [id], onDelete: Restrict)
  buyer           User               @relation("PaymentOrderBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  affiliator      AffiliatorProfile? @relation(fields: [affiliatorProfileId], references: [id], onDelete: Restrict)
  packagePurchase PackagePurchase?   @relation(fields: [packagePurchaseId], references: [id], onDelete: Restrict)
  events          PaymentEvent[]
  reservation     RiskReservation?
  fraudCases      FraudCase[]
  receipt         PaymentReceipt?
  usageEvents     FulfillmentUsageEvent[]
  disputeExports  DisputeExport[]

  @@unique([provider, providerEnvironment, providerAccount, providerReference])
  @@index([status, expiresAt])
  @@index([buyerId, createdAt])
  @@index([buyerIp, createdAt])
  @@index([deviceLookupToken, createdAt])
  @@map("payment_orders")
}

/// Every verified provider event or reconciled status, with the decision taken.
/// Append-only: the outcome is decided before the row is written. Events that
/// fail signature or freshness checks never reach this table.
model PaymentEvent {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider            String              @db.VarChar(40)
  providerEnvironment String              @map("provider_environment") @db.VarChar(40)
  providerAccount     String              @map("provider_account") @db.VarChar(80)
  eventId             String              @map("event_id") @db.VarChar(160)
  type                PaymentEventType
  source              PaymentEventSource
  providerPaymentId   String?             @map("provider_payment_id") @db.VarChar(160)
  merchantReference   String              @map("merchant_reference") @db.VarChar(120)
  orderId             String?             @map("order_id") @db.Uuid
  amountRupiah        Int?                @map("amount_rupiah")
  currency            String?             @db.VarChar(3)
  buyerId             String?             @map("buyer_id") @db.VarChar(80)
  packageCode         String?             @map("package_code") @db.VarChar(80)
  outcome             PaymentEventOutcome
  reason              String?             @db.VarChar(160)
  bodySha256          String?             @map("body_sha256") @db.VarChar(64)
  callerIp            String?             @map("caller_ip") @db.Inet
  providerOccurredAt  DateTime            @map("provider_occurred_at") @db.Timestamptz
  receivedAt          DateTime            @default(now()) @map("received_at") @db.Timestamptz

  order      PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  fraudCases FraudCase[]

  @@unique([provider, providerEnvironment, providerAccount, eventId])
  @@index([orderId, receivedAt])
  @@index([outcome, receivedAt])
  @@map("payment_events")
}

/// Work to do after a payment decision commits (receipt email, critical alert).
/// Rows are enqueued inside the same transaction as the decision, claimed with
/// a lease, retried with backoff, and drained after the request and by the
/// daily maintenance job.
model PaymentOutbox {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        PaymentOutboxKind
  /// One job per business fact, so a repeated decision enqueues nothing new.
  dedupeKey   String              @unique @map("dedupe_key") @db.VarChar(200)
  orderId     String?             @map("order_id") @db.Uuid
  payload     Json                @default("{}") @db.JsonB
  status      PaymentOutboxStatus @default(pending)
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(8) @map("max_attempts")
  nextRunAt   DateTime            @default(now()) @map("next_run_at") @db.Timestamptz
  leasedUntil DateTime?           @map("leased_until") @db.Timestamptz
  leaseOwner  String?             @map("lease_owner") @db.VarChar(64)
  lastError   String?             @map("last_error") @db.VarChar(200)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime?           @map("completed_at") @db.Timestamptz

  @@index([status, nextRunAt])
  @@map("payment_outbox")
}

/// The dev-only stand-in provider's own payment state, kept apart from our
/// orders so status lookups and reconciliation talk to a separate source of
/// truth. It is only written when the stand-in is enabled (local database).
model StandInPayment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String    @unique @db.VarChar(120)
  providerPaymentId String    @unique @map("provider_payment_id") @db.VarChar(64)
  amountRupiah      Int       @map("amount_rupiah")
  currency          String    @db.VarChar(3)
  metadata          Json      @default("{}") @db.JsonB
  /// pending, succeeded, failed or expired.
  state             String    @default("pending") @db.VarChar(12)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  settledAt         DateTime? @map("settled_at") @db.Timestamptz

  @@map("stand_in_payments")
}

enum RiskTier {
  unverified
  verified

  @@map("risk_tier")
}

enum RiskReservationState {
  /// Counted: the order is open and may still be paid.
  pending
  /// Counted: the order was paid.
  paid
  /// Counted: a payment arrived after a confirmed failure or expiry. The money
  /// exists, so the exposure is held again until the case is resolved.
  review
  /// Not counted: the order failed or expired, and the provider confirmed it.
  released

  @@map("risk_reservation_state")
}

/// One version of the purchase limits. Append-only: a change is a new version,
/// never an edit. Which version applies is decided by `RiskPolicyActivation`.
model RiskPolicyVersion {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version                   Int      @unique
  /// New or unverified accounts, per Asia/Jakarta day.
  unverifiedDailyPurchases  Int      @map("unverified_daily_purchases")
  unverifiedDailyRupiah     Int      @map("unverified_daily_rupiah")
  /// Verified accounts, per Asia/Jakarta day.
  verifiedDailyPurchases    Int      @map("verified_daily_purchases")
  verifiedDailyRupiah       Int      @map("verified_daily_rupiah")
  /// A verified account is at least this old (and has a clean paid order).
  verifiedMinAccountAgeDays Int      @map("verified_min_account_age_days")
  maxOpenPayments           Int      @map("max_open_payments")
  maxUnpaidPerAccountHour   Int      @map("max_unpaid_per_account_hour")
  maxStartsPerIpHour        Int      @map("max_starts_per_ip_hour")
  note                      String   @db.Text
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  activations RiskPolicyActivation[]

  @@map("risk_policy_versions")
}

/// Which policy version is in force. Append-only: the newest row decides, and a
/// row with no version withdraws the policy (new checkouts are then refused).
model RiskPolicyActivation {
  id              BigInt   @id @default(autoincrement())
  policyVersionId String?  @map("policy_version_id") @db.Uuid
  reason          String   @db.VarChar(200)
  activatedAt     DateTime @default(now()) @map("activated_at") @db.Timestamptz

  policyVersion RiskPolicyVersion? @relation(fields: [policyVersionId], references: [id], onDelete: Restrict)

  @@map("risk_policy_activations")
}

/// An account's risk tier and what it was based on. The row is also the lock
/// that serialises every limit check for the account.
model RiskAccountTier {
  userId      String   @id @map("user_id") @db.Uuid
  tier        RiskTier @default(unverified)
  /// The facts behind the tier at the last evaluation.
  basis       Json     @default("{}") @db.JsonB
  evaluatedAt DateTime @default(now()) @map("evaluated_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("risk_account_tiers")
}

/// Exposure counted against one account on one Asia/Jakarta day. Maintained by
/// the database from the reservations, so the two cannot drift apart.
model RiskDayBucket {
  userId        String   @map("user_id") @db.Uuid
  bucketDate    DateTime @map("bucket_date") @db.Date
  purchaseCount Int      @default(0) @map("purchase_count")
  amountRupiah  Int      @default(0) @map("amount_rupiah")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, bucketDate])
  @@map("risk_day_buckets")
}

/// The exposure one order holds against its start day. It stays on that day
/// whatever happens later. One order has at most one reservation.
model RiskReservation {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String               @unique @map("order_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  bucketDate     DateTime             @map("bucket_date") @db.Date
  amountRupiah   Int                  @map("amount_rupiah")
  tier           RiskTier
  /// The facts behind the tier when the reservation was taken.
  tierBasis      Json                 @default("{}") @map("tier_basis") @db.JsonB
  policyVersion  Int                  @map("policy_version")
  state          RiskReservationState @default(pending)
  stateReason    String?              @map("state_reason") @db.VarChar(80)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  stateChangedAt DateTime             @default(now()) @map("state_changed_at") @db.Timestamptz

  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, bucketDate])
  @@map("risk_reservations")
}

model SystemConfig {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey            String    @unique @map("config_key") @db.VarChar(120)
  configValue          Json      @map("config_value") @db.JsonB
  updatedByUserId      String?   @map("updated_by_user_id") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  draftValue           Json?     @map("draft_value") @db.JsonB
  draftUpdatedByUserId String?   @map("draft_updated_by_user_id") @db.Uuid
  draftUpdatedAt       DateTime? @map("draft_updated_at") @db.Timestamptz
  publishedByUserId    String?   @map("published_by_user_id") @db.Uuid
  publishedAt          DateTime? @map("published_at") @db.Timestamptz

  updatedBy      User? @relation("SystemConfigUpdatedBy", fields: [updatedByUserId], references: [id])
  draftUpdatedBy User? @relation("SystemConfigDraftUpdatedBy", fields: [draftUpdatedByUserId], references: [id])
  publishedBy    User? @relation("SystemConfigPublishedBy", fields: [publishedByUserId], references: [id])

  @@map("system_configs")
}

model AuditLog {
  /// Audit rows are append-only. The database migration rejects UPDATE,
  /// DELETE, and TRUNCATE so historical evidence cannot be rewritten.
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String?  @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent") @db.Text
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
