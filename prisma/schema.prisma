/// Unified account table. Credential fields folded directly here to eliminate auth_identities table bloat.
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique
  fullName           String     @map("full_name") @db.VarChar(160)
  passwordHash       String     @map("password_hash") @db.Text
  passwordUpdatedAt  DateTime?  @map("password_updated_at") @db.Timestamptz
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  avatarUrl          String?    @map("avatar_url") @db.Text
  phone              String?    @db.VarChar(40)
  status             UserStatus @default(active)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  softDeletedAt      DateTime?  @map("soft_deleted_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  authSessions                           AuthSession[]
  passwordResetTokens                    PasswordResetToken[]
  loginAttempts                          LoginAttempt[]
  roleAssignments                        RoleAssignment[]                 @relation("UserRoles")
  assignedRolesBy                        RoleAssignment[]                 @relation("RolesAssignedBy")
  studentProfile                         StudentProfile?                  @relation("StudentProfileAccount")
  enrolledStudents                       StudentProfile[]                 @relation("EnrolledBy")
  tutorProfile                           TutorProfile?
  createdModules                         Module[]                         @relation("ModuleCreatedBy")
  updatedModules                         Module[]                         @relation("ModuleUpdatedBy")
  moduleProgressions                     ModuleProgress[]
  createdQuestionBanks                   QuestionBank[]                   @relation("QuestionBankCreatedBy")
  updatedQuestionBanks                   QuestionBank[]                   @relation("QuestionBankUpdatedBy")
  createdQuestionBankFolders              QuestionBankFolder[]             @relation("QuestionBankFolderCreatedBy")
  updatedQuestionBankFolders              QuestionBankFolder[]             @relation("QuestionBankFolderUpdatedBy")
  createdQuestionBankCategories           QuestionBankCategory[]            @relation("QuestionBankCategoryCreatedBy")
  updatedQuestionBankCategories           QuestionBankCategory[]            @relation("QuestionBankCategoryUpdatedBy")
  assignedQuestionBankCategories          QuestionBankCategoryAssignment[]  @relation("QuestionBankCategoryAssignedBy")
  createdQuestions                       Question[]                       @relation("QuestionCreatedBy")
  updatedQuestions                       Question[]                       @relation("QuestionUpdatedBy")
  authoredQuestionRevisions                QuestionRevision[]                @relation("QuestionRevisionCreatedBy")
  modifiedQuestionRevisions               QuestionRevision[]                @relation("QuestionRevisionUpdatedBy")
  authoredStandaloneQuizzes              StandaloneQuiz[]                 @relation("StandaloneQuizAuthor")
  standaloneQuizParticipations           StandaloneQuizParticipation[]
  quizAttempts                           QuizAttempt[]
  createdTryoutPackages                  TryoutPackage[]                  @relation("TryoutCreatedBy")
  createdReusableQuestionPackages        ReusableQuestionPackage[]        @relation("ReusableQuestionPackageCreatedBy")
  updatedReusableQuestionPackages        ReusableQuestionPackage[]        @relation("ReusableQuestionPackageUpdatedBy")
  createdReusableQuestionPackageVersions ReusableQuestionPackageVersion[] @relation("ReusableQuestionPackageVersionCreatedBy")
  tryoutAttempts                         TryoutAttempt[]
  tryoutAdmissions                       TryoutAdmission[]
  tryoutDeliveryAssignmentsCreated       TryoutDeliveryAssignment[]       @relation("TryoutAssignmentCreatedBy")
  tryoutDeliverySessionsCreated          TryoutDeliverySession[]          @relation("TryoutDeliverySessionCreatedBy")
  tryoutDeliverySessionsUpdated          TryoutDeliverySession[]          @relation("TryoutDeliverySessionUpdatedBy")
  tryoutDeliverySessionsReleased         TryoutDeliverySession[]          @relation("TryoutDeliverySessionReleasedBy")
  tryoutDeliveryAudits                   TryoutDeliveryAudit[]
  recordedTwoPlCalibrations              TwoPlQuestionCalibration[]       @relation("TwoPlCalibrationRecordedBy")
  approvedTwoPlCalibrations              TwoPlQuestionCalibration[]       @relation("TwoPlCalibrationApprovedBy")
  catResolutionAudits                    TryoutCatResolutionAudit[]
  topicPerformances                      StudentTopicPerformance[]
  subtestPerformances                    StudentSubtestPerformance[]
  learningRecommendations                LearningRecommendation[]
  analyticsEvents                        AnalyticsEvent[]
  missionAssignments                     DailyMissionAssignment[]
  streakFreezes                          StreakFreeze[]
  badges                                 StudentBadge[]
  aiConversations                        AiConversation[]
  aiRequests                             AiRequest[]
  aiUsageDaily                           AiUsageDaily[]
  weaknessAnalyses                       WeaknessAnalysis[]
  adaptivePracticeSessions               AdaptivePracticeSession[]
  ptnStrategySessions                    PtnStrategySession[]
  uploadedAssets                         Asset[]                          @relation("UploadedBy")
  createdMediaFolders                    MediaFolder[]                    @relation("MediaFolderCreatedBy")
  createdAnnouncements                   Announcement[]                   @relation("AnnouncementCreatedBy")
  updatedAnnouncements                   Announcement[]                   @relation("AnnouncementUpdatedBy")
  updatedLandingSections                 LandingPageSection[]             @relation("LandingSectionUpdatedBy")
  cohortMemberships                      CohortStudent[]
  assignedTutorCohorts                   TutorCohortAssignment[]          @relation("TutorAssigned")
  assignedCohortsBy                      TutorCohortAssignment[]          @relation("CohortAssignedBy")
  riskFlags                              RiskFlag[]
  tutorInterventions                     Intervention[]                   @relation("TutorIntervention")
  studentInterventions                   Intervention[]                   @relation("StudentIntervention")
  notificationPreferences                NotificationPreference?
  notificationsReceived                  Notification[]
  billingAccounts                        BillingAccount[]                 @relation("StudentBilling")
  extendedBillingAccounts                BillingAccount[]                 @relation("BillingExtendedBy")
  updatedSystemConfigs                   SystemConfig[]                 @relation("SystemConfigUpdatedBy")
  draftUpdatedSystemConfigs              SystemConfig[]                 @relation("SystemConfigDraftUpdatedBy")
  publishedSystemConfigs                 SystemConfig[]                 @relation("SystemConfigPublishedBy")
  auditLogs                              AuditLog[]
  enrollmentHandoffs                     EnrollmentHandoff[]              @relation("EnrollmentHandoffUser")
  createdEnrollmentHandoffs              EnrollmentHandoff[]              @relation("EnrollmentHandoffCreatedBy")
  createdEnrollmentImports               EnrollmentImport[]               @relation("EnrollmentImportCreatedBy")
  confirmedEnrollmentImports             EnrollmentImport[]               @relation("EnrollmentImportConfirmedBy")
  matchedEnrollmentImportRows            EnrollmentImportRow[]            @relation("EnrollmentImportRowMatchedUser")
  resultEnrollmentImportRows             EnrollmentImportRow[]            @relation("EnrollmentImportRowResultUser")

  @@index([fullName, id], map: "users_directory_full_name_id_idx")
  @@index([createdAt, id], map: "users_directory_created_at_id_idx")
  @@index([status, fullName, id], map: "users_directory_status_full_name_id_idx")
  @@map("users")
}

model AuthSession {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @map("refresh_token_hash") @db.Text
  status           SessionStatus @default(active)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz
  lastSeenAt       DateTime?     @map("last_seen_at") @db.Timestamptz
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.Text

  user User @relation(fields: [userId], references: [id])

  @@unique([refreshTokenHash])
  @@index([userId])
  @@map("auth_sessions")
}

/// Handles self-service resets and first-login credential overrides.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  ipAddress   String?   @map("ip_address") @db.Inet

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model LoginAttempt {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @db.Text // Note: maps logically to citext compatibility
  userId        String?            @map("user_id") @db.Uuid
  result        LoginAttemptResult
  failureReason String?            @map("failure_reason") @db.Text
  attemptedAt   DateTime           @default(now()) @map("attempted_at") @db.Timestamptz
  ipAddress     String?            @map("ip_address") @db.Inet
  userAgent     String?            @map("user_agent") @db.Text

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([attemptedAt])
  @@map("login_attempts")
}

model RoleAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  role             RoleName
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  user       User  @relation("UserRoles", fields: [userId], references: [id])
  assignedBy User? @relation("RolesAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([userId, role])
  @@index([role, revokedAt, userId], map: "role_assignments_directory_role_idx")
  @@map("role_assignments")
}

/// One-time invite or temporary-password handoff for an enrolled account.
/// The secret is only ever stored as a hash (invite links) or an encrypted
/// envelope that is crypto-shredded on release/completion.
model EnrollmentHandoff {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  createdByUserId   String?                 @map("created_by_user_id") @db.Uuid
  sourceImportRowId String?                 @map("source_import_row_id") @db.Uuid
  method            EnrollmentHandoffMethod
  status            EnrollmentHandoffStatus @default(pending)
  tokenHash         String?                 @unique @map("token_hash") @db.Text
  secretEnvelope    Json?                   @map("secret_envelope") @db.JsonB
  expiresAt         DateTime?               @map("expires_at") @db.Timestamptz
  releasedAt        DateTime?               @map("released_at") @db.Timestamptz
  acknowledgedAt    DateTime?               @map("acknowledged_at") @db.Timestamptz
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz
  revokedAt         DateTime?               @map("revoked_at") @db.Timestamptz
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User                 @relation("EnrollmentHandoffUser", fields: [userId], references: [id], onDelete: Restrict)
  createdByUser   User?                @relation("EnrollmentHandoffCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sourceImportRow EnrollmentImportRow? @relation("EnrollmentHandoffSourceRow", fields: [sourceImportRowId], references: [id], onDelete: SetNull)
  rowLink         EnrollmentImportRow? @relation("EnrollmentImportRowHandoff")

  @@index([userId, status, expiresAt])
  @@index([sourceImportRowId])
  @@index([status, expiresAt])
  @@map("enrollment_handoffs")
}

model EnrollmentImport {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role               EnrollmentImportRole
  status             EnrollmentImportStatus   @default(draft)
  sourceFilename     String                   @map("source_filename") @db.VarChar(120)
  contentHash        String                   @map("content_hash") @db.Text
  templateVersion    String                   @map("template_version") @db.VarChar(40)
  rowCount           Int                      @map("row_count")
  handoffMethod      EnrollmentHandoffMethod? @map("handoff_method")
  createdByUserId    String                   @map("created_by_user_id") @db.Uuid
  confirmedByUserId  String?                  @map("confirmed_by_user_id") @db.Uuid
  dispatchGeneration Int                      @default(0) @map("dispatch_generation")
  lastErrorCode      String?                  @map("last_error_code") @db.VarChar(80)
  lastErrorMessage   String?                  @map("last_error_message") @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt        DateTime?                @map("confirmed_at") @db.Timestamptz
  startedAt          DateTime?                @map("started_at") @db.Timestamptz
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastHeartbeatAt    DateTime?                @map("last_heartbeat_at") @db.Timestamptz

  createdByUser   User                       @relation("EnrollmentImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser User?                      @relation("EnrollmentImportConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  rows            EnrollmentImportRow[]
  dispatches      EnrollmentImportDispatch[]

  @@index([status, updatedAt])
  @@map("enrollment_imports")
}

model EnrollmentImportRow {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId             String                    @map("import_id") @db.Uuid
  rowNumber            Int                       @map("row_number")
  normalizedEmail      String                    @map("normalized_email") @db.Text
  operation            EnrollmentImportOperation @default(none)
  status               EnrollmentImportRowStatus @default(invalid)
  inputJson            Json                      @map("input_json") @db.JsonB
  matchedUserId        String?                   @map("matched_user_id") @db.Uuid
  matchedUserUpdatedAt DateTime?                 @map("matched_user_updated_at") @db.Timestamptz
  resultUserId         String?                   @map("result_user_id") @db.Uuid
  handoffId            String?                   @unique @map("handoff_id") @db.Uuid
  errorCode            String?                   @map("error_code") @db.VarChar(80)
  errorMessage         String?                   @map("error_message") @db.Text
  attemptCount         Int                       @default(0) @map("attempt_count")
  claimToken           String?                   @map("claim_token") @db.Uuid
  claimExpiresAt       DateTime?                 @map("claim_expires_at") @db.Timestamptz
  claimedBy            String?                   @map("claimed_by") @db.VarChar(120)
  processedAt          DateTime?                 @map("processed_at") @db.Timestamptz
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  import        EnrollmentImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedUser   User?              @relation("EnrollmentImportRowMatchedUser", fields: [matchedUserId], references: [id], onDelete: SetNull)
  resultUser    User?              @relation("EnrollmentImportRowResultUser", fields: [resultUserId], references: [id], onDelete: SetNull)
  handoff       EnrollmentHandoff? @relation("EnrollmentImportRowHandoff", fields: [handoffId], references: [id], onDelete: SetNull)
  sourceHandoffs EnrollmentHandoff[] @relation("EnrollmentHandoffSourceRow")

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@index([importId, normalizedEmail])
  @@index([claimExpiresAt])
  @@map("enrollment_import_rows")
}

model EnrollmentImportDispatch {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId         String                         @map("import_id") @db.Uuid
  generation       Int
  status           EnrollmentImportDispatchStatus @default(pending)
  queueJobId       String                         @map("queue_job_id") @db.VarChar(200)
  attemptCount     Int                            @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?                      @map("next_attempt_at") @db.Timestamptz
  claimToken       String?                        @map("claim_token") @db.Uuid
  claimExpiresAt   DateTime?                      @map("claim_expires_at") @db.Timestamptz
  claimedBy        String?                        @map("claimed_by") @db.VarChar(120)
  enqueuedAt       DateTime?                      @map("enqueued_at") @db.Timestamptz
  lastErrorCode    String?                        @map("last_error_code") @db.VarChar(80)
  lastErrorMessage String?                        @map("last_error_message") @db.Text
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  import EnrollmentImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, generation])
  @@unique([queueJobId])
  @@index([status, nextAttemptAt, claimExpiresAt])
  @@map("enrollment_import_dispatches")
}

