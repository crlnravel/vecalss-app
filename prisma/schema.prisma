  packageVersion ReusableQuestionPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)

  @@index([requestedCount])
  @@map("reusable_question_package_version_rules")
}

model ReusableQuestionPackageVersionItem {
