  subtestId     String   @map("subtest_id") @db.Uuid
  parentTopicId String?  @map("parent_topic_id") @db.Uuid
  code          String   @db.VarChar(80)
  name          String   @db.VarChar(200)
  description   String?  @db.Text
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subtest                 Subtest                   @relation(fields: [subtestId], references: [id])
  parentTopic             Topic?                    @relation("TopicHierarchy", fields: [parentTopicId], references: [id])
  childTopics             Topic[]                   @relation("TopicHierarchy")
  modules                 Module[]
