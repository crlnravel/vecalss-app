/// Immutable publication identity for one resolved Tryout form and scoring
/// policy.  The payload is the logical AssessmentRevision projection over the
/// existing package-version/TryoutItem snapshot bridge; physical snapshot
/// deduplication remains intentionally out of scope.
model AssessmentRelease {
  id                              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tryoutId                        String                       @map("tryout_id") @db.Uuid
  releaseNumber                   Int                          @map("release_number")
  contentDigest                   String                       @map("content_digest") @db.VarChar(128)
  payload                         Json                         @db.JsonB
  assemblyMode                    ReusableQuestionPackageMode? @map("assembly_mode")
  assemblyPackageId               String?                      @map("assembly_package_id") @db.Uuid
