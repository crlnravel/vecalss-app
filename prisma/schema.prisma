  tutorId          String    @map("tutor_id") @db.Uuid
  cohortId         String    @map("cohort_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  tutor      User   @relation("TutorAssigned", fields: [tutorId], references: [id])
  cohort     Cohort @relation(fields: [cohortId], references: [id])
  assignedBy User?  @relation("CohortAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([tutorId, cohortId])
  @@map("tutor_cohort_assignments")
}

model RiskFlag {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String         @map("student_id") @db.Uuid
  cohortId   String?        @map("cohort_id") @db.Uuid
  flagType   String         @map("flag_type") @db.VarChar(80)
  severity   Int            @default(1)
  reason     String?        @db.Text
  status     RiskFlagStatus @default(open)
  detectedAt DateTime       @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz

  student       User           @relation(fields: [studentId], references: [id])
  cohort        Cohort?        @relation(fields: [cohortId], references: [id])
  interventions Intervention[]

  @@index([studentId])
  @@index([cohortId])
  @@index([status])
  @@index([severity])
  @@map("risk_flags")
}

model Intervention {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tutorId             String             @map("tutor_id") @db.Uuid
  studentId           String             @map("student_id") @db.Uuid
  cohortId            String?            @map("cohort_id") @db.Uuid
  riskFlagId          String?            @map("risk_flag_id") @db.Uuid
  recommendedModuleId String?            @map("recommended_module_id") @db.Uuid
  message             String             @db.Text
  status              InterventionStatus @default(drafted)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz
  sentAt              DateTime?          @map("sent_at") @db.Timestamptz
  readAt              DateTime?          @map("read_at") @db.Timestamptz

  tutor             User      @relation("TutorIntervention", fields: [tutorId], references: [id])
  student           User      @relation("StudentIntervention", fields: [studentId], references: [id])
  cohort            Cohort?   @relation(fields: [cohortId], references: [id])
  riskFlag          RiskFlag? @relation(fields: [riskFlagId], references: [id])
  recommendedModule Module?   @relation(fields: [recommendedModuleId], references: [id])

  @@index([tutorId])
  @@index([studentId])
  @@index([status])
