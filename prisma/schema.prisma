}

model ReusableQuestionPackageVersion {
  id               String                                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId        String                                   @map("package_id") @db.Uuid
  sourceBankId     String                                   @map("source_bank_id") @db.Uuid
  subtestId        String?                                  @map("subtest_id") @db.Uuid
  versionNo        Int                                      @map("version_no")
  mode             ReusableQuestionPackageMode              @default(fixed_set)
  definitionDigest String?                                  @map("definition_digest") @db.VarChar(128)
  provenance       ReusableQuestionPackageVersionProvenance @default(authored)
  status           ContentStatus                            @default(draft)
  readyAt          DateTime?                                @map("ready_at") @db.Timestamptz
  createdByUserId  String                                   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                                 @default(now()) @map("created_at") @db.Timestamptz

  package                      ReusableQuestionPackage                       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  sourceBank                   QuestionBank                                  @relation("ReusablePackageVersionSourceBank", fields: [sourceBankId], references: [id], onDelete: Restrict)
  subtest                      Subtest?                                      @relation("ReusablePackageVersionSubtest", fields: [subtestId], references: [id], onDelete: Restrict)
  createdBy                    User                                          @relation("ReusableQuestionPackageVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                        ReusableQuestionPackageVersionItem[]
  bankScopes                   ReusableQuestionPackageVersionBankScope[]
  folderScopes                 ReusableQuestionPackageVersionFolderScope[]
  categoryScopes               ReusableQuestionPackageVersionCategoryScope[]
  rule                         ReusableQuestionPackageVersionRule?
