model VeraMessage {
  id             String           @id @db.VarChar(64)
  conversationId String           @map("conversation_id") @db.Uuid
  role           VeraMessageRole
  parts          Json
  mentions       Json?
  sources        Json?
  effort         VeraEffort?
  credits        Decimal?         @db.Decimal(6, 1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  conversation   VeraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("vera_messages")
}

model VeraUsageEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  kind              VeraUsageKind
  status            VeraUsageStatus @default(reserved)
  effort            VeraEffort?
  model             String          @db.VarChar(80)
  conversationId    String?         @map("conversation_id") @db.Uuid
  messageId         String?         @map("message_id") @db.VarChar(64)
  studioDocumentId  String?         @map("studio_document_id") @db.Uuid
