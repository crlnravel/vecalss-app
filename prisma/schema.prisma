  @@map("vera_message_role")
}

enum VeraUsageKind {
  chat
  studio
  title

  @@map("vera_usage_kind")
}

enum VeraUsageStatus {
  reserved
  settled
  released
  failed

  @@map("vera_usage_status")
}

enum VeraEffort {
  cepat
  seimbang
  mendalam

  @@map("vera_effort")
