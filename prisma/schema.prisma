  cipherVersion      String    @map("cipher_version") @db.VarChar(40)
  state              String    @default("active") @db.VarChar(20)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  destroyedAt        DateTime? @map("destroyed_at") @db.Timestamptz

  @@index([objectId, state])
  @@index([state, destroyedAt])
  @@map("ai_envelope_keys")
}

