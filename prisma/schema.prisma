  extendedBillingAccounts                BillingAccount[]                     @relation("BillingExtendedBy")
  billingAccessEventsAsStudent           BillingAccessEvent[]                 @relation("BillingAccessEventStudent")
  billingAccessEventsAsActor             BillingAccessEvent[]                 @relation("BillingAccessEventActor")
  affiliatorProfile                      AffiliatorProfile?
  packagePurchases                       PackagePurchase[]                    @relation("PackagePurchaseStudent")
  checkoutIntents                        CheckoutIntent[]
  paymentOrders                          PaymentOrder[]                       @relation("PaymentOrderBuyer")
  paymentReceipts                        PaymentReceipt[]                     @relation("PaymentReceiptBuyer")
  fulfillmentUsageEvents                 FulfillmentUsageEvent[]              @relation("FulfillmentUsageStudent")
  disputeExportsRequested                DisputeExport[]                      @relation("DisputeExportRequester")
  riskAccountTier                        RiskAccountTier?
  riskDayBuckets                         RiskDayBucket[]
  riskReservations                       RiskReservation[]
  fraudBlocksAsSubject                   FraudBlock[]                         @relation("FraudBlockSubject")
  fraudBlocksAsOwner                     FraudBlock[]                         @relation("FraudBlockOwner")
  fraudBlocksCreated                     FraudBlock[]                         @relation("FraudBlockCreator")
  fraudBlockEvents                       FraudBlockEvent[]                    @relation("FraudBlockEventActor")
  fraudCasesAsSubject                    FraudCase[]                          @relation("FraudCaseUser")
  fraudCasesAsOwner                      FraudCase[]                          @relation("FraudCaseOwner")
  fraudCaseEvents                        FraudCaseEvent[]                     @relation("FraudCaseEventActor")
  fraudCaseBlocksLinked                  FraudCaseBlock[]                     @relation("FraudCaseBlockLinker")
  mfaFactor                              UserMfaFactor?                       @relation("UserMfaFactor")
  mfaSetupCodes                          MfaSetupCode[]                       @relation("UserMfaSetupCodes")
  mfaFailedAttempts                      MfaFailedAttempt[]                   @relation("UserMfaFailedAttempts")
  updatedSystemConfigs                   SystemConfig[]                       @relation("SystemConfigUpdatedBy")
  draftUpdatedSystemConfigs              SystemConfig[]                       @relation("SystemConfigDraftUpdatedBy")
  publishedSystemConfigs                 SystemConfig[]                       @relation("SystemConfigPublishedBy")
  auditLogs                              AuditLog[]
  enrollmentHandoffs                     EnrollmentHandoff[]                  @relation("EnrollmentHandoffUser")
  createdEnrollmentHandoffs              EnrollmentHandoff[]                  @relation("EnrollmentHandoffCreatedBy")
  createdEnrollmentImports               EnrollmentImport[]                   @relation("EnrollmentImportCreatedBy")
  confirmedEnrollmentImports             EnrollmentImport[]                   @relation("EnrollmentImportConfirmedBy")
  matchedEnrollmentImportRows            EnrollmentImportRow[]                @relation("EnrollmentImportRowMatchedUser")
  resultEnrollmentImportRows             EnrollmentImportRow[]                @relation("EnrollmentImportRowResultUser")
  editLeases                             EditLease[]
  veraConversations                      VeraConversation[]                   @relation("VeraConversations")
  veraUsageEvents                        VeraUsageEvent[]                     @relation("VeraUsageEvents")
  veraStudioDocuments                    VeraStudioDocument[]                 @relation("VeraStudioDocuments")

  @@index([fullName, id], map: "users_directory_full_name_id_idx")
  @@index([createdAt, id], map: "users_directory_created_at_id_idx")
  @@index([status, fullName, id], map: "users_directory_status_full_name_id_idx")
  @@map("users")
}

model AuthSession {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @map("refresh_token_hash") @db.Text
  status           SessionStatus @default(active)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz
  lastSeenAt       DateTime?     @map("last_seen_at") @db.Timestamptz
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.Text
  /// Set from database time when this session last passed a second-factor
  /// check. Privileged roles count only while it is recent and was recorded
  /// under the factor that is still enrolled (see lib/auth/mfa).
  mfaVerifiedAt    DateTime?     @map("mfa_verified_at") @db.Timestamptz
  mfaFactorId      String?       @map("mfa_factor_id") @db.Uuid

  user      User           @relation(fields: [userId], references: [id])
  mfaFactor UserMfaFactor? @relation(fields: [mfaFactorId], references: [id], onDelete: SetNull)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([mfaFactorId])
  @@map("auth_sessions")
}

/// One authenticator-app factor per privileged account (admin, developer). The
/// secret is stored only as an AES-256-GCM envelope bound to the owner. A row
/// with no `confirmedAt` is an enrollment in progress and never authorizes
/// anything; it belongs to the session that presented the setup code.
model UserMfaFactor {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  secretEnvelope   Json      @map("secret_envelope") @db.JsonB
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz
  /// Last accepted 30-second step. A code is accepted only for a later step,
  /// and the update is atomic, so one code can never pass twice.
  lastAcceptedStep Int?      @map("last_accepted_step")
  pendingSessionId String?   @map("pending_session_id") @db.Uuid
  setupCodeId      String?   @unique @map("setup_code_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User              @relation("UserMfaFactor", fields: [userId], references: [id], onDelete: Cascade)
  setupCode     MfaSetupCode?     @relation(fields: [setupCodeId], references: [id], onDelete: SetNull)
  recoveryCodes MfaRecoveryCode[]
  sessions      AuthSession[]

  @@map("user_mfa_factors")
}

/// One-use recovery code, stored as a SHA-256 hash and consumed atomically.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factorId  String    @map("factor_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  factor UserMfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@unique([factorId, codeHash])
  @@map("mfa_recovery_codes")
}

/// Short-lived, one-use code issued by the operator script (never by a web
/// route). Enrollment of a factor requires it, so a stolen password alone
/// cannot enroll one.
model MfaSetupCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  issuedBy  String    @map("issued_by") @db.VarChar(160)
  reason    String    @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User           @relation("UserMfaSetupCodes", fields: [userId], references: [id], onDelete: Cascade)
  factor UserMfaFactor?

  @@index([userId, createdAt])
  @@map("mfa_setup_codes")
}

/// Failed challenge, recovery-code and setup-code attempts, counted per
/// account in Postgres so the limit holds even when Redis is unavailable.
model MfaFailedAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(20)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  user User @relation("UserMfaFailedAttempts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, occurredAt])
  @@map("mfa_failed_attempts")
}

model EditLease {
  resourceType EditLeaseResourceType @map("resource_type")
  resourceId   String                @map("resource_id") @db.VarChar(128)
  holderUserId String                @map("holder_user_id") @db.Uuid
  tokenDigest  String                @map("token_digest") @db.VarChar(64)
  generation   Int
  acquiredAt   DateTime              @map("acquired_at") @db.Timestamptz
  heartbeatAt  DateTime              @map("heartbeat_at") @db.Timestamptz
  expiresAt    DateTime              @map("expires_at") @db.Timestamptz
  releasedAt   DateTime?             @map("released_at") @db.Timestamptz

  holder User @relation(fields: [holderUserId], references: [id], onDelete: Cascade)

  @@id([resourceType, resourceId])
  @@index([expiresAt])
  @@index([holderUserId])
  @@index([releasedAt, expiresAt])
  @@map("edit_leases")
}

/// Handles self-service resets and first-login credential overrides.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  ipAddress   String?   @map("ip_address") @db.Inet

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

/// One row per password reset request that was let through. It feeds the
/// per-email and per-address limits; the email is kept only as a hash.
model PasswordResetRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailHash   String   @map("email_hash") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.Inet
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz

  @@index([emailHash, requestedAt])
  @@index([ipAddress, requestedAt])
  @@index([requestedAt])
  @@map("password_reset_requests")
}

model LoginAttempt {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @db.Text // Note: maps logically to citext compatibility
  userId        String?            @map("user_id") @db.Uuid
  result        LoginAttemptResult
  failureReason String?            @map("failure_reason") @db.Text
  attemptedAt   DateTime           @default(now()) @map("attempted_at") @db.Timestamptz
  ipAddress     String?            @map("ip_address") @db.Inet
  userAgent     String?            @map("user_agent") @db.Text

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([attemptedAt])
  @@map("login_attempts")
}

model RoleAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  role             RoleName
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  /// Set by the database clock. `auth_sessions.mfa_verified_at` is too, so the two
  /// compare on one clock; a client-side default would drift by milliseconds.
  assignedAt       DateTime  @default(dbgenerated("now()")) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

  user       User  @relation("UserRoles", fields: [userId], references: [id])
  assignedBy User? @relation("RolesAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([userId, role])
  @@index([role, revokedAt, userId], map: "role_assignments_directory_role_idx")
  @@map("role_assignments")
}

model MentorReport {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId    String                   @map("author_id") @db.Uuid
  title       String                   @db.VarChar(160)
  feature     MentorReportFeature
  url         String                   @db.VarChar(2048)
  description String                   @db.Text
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  attachments MentorReportAttachment[]

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@map("mentor_reports")
}

model MentorReportAttachment {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reportId    String       @map("report_id") @db.Uuid
  storageKey  String       @map("storage_key") @db.Text
  fileName    String       @map("file_name") @db.VarChar(255)
  contentType String       @map("content_type") @db.VarChar(100)
  sizeBytes   Int          @map("size_bytes")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  report      MentorReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, sortOrder])
  @@map("mentor_report_attachments")
}

/// One-time invite or temporary-password handoff for an enrolled account.
/// The secret is only ever stored as a hash (invite links) or an encrypted
/// envelope that is crypto-shredded on release/completion.
model EnrollmentHandoff {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  createdByUserId   String?                 @map("created_by_user_id") @db.Uuid
  sourceImportRowId String?                 @map("source_import_row_id") @db.Uuid
  method            EnrollmentHandoffMethod
  status            EnrollmentHandoffStatus @default(pending)
  tokenHash         String?                 @unique @map("token_hash") @db.Text
  secretEnvelope    Json?                   @map("secret_envelope") @db.JsonB
  expiresAt         DateTime?               @map("expires_at") @db.Timestamptz
  releasedAt        DateTime?               @map("released_at") @db.Timestamptz
  acknowledgedAt    DateTime?               @map("acknowledged_at") @db.Timestamptz
  completedAt       DateTime?               @map("completed_at") @db.Timestamptz
  revokedAt         DateTime?               @map("revoked_at") @db.Timestamptz
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User                 @relation("EnrollmentHandoffUser", fields: [userId], references: [id], onDelete: Restrict)
  createdByUser   User?                @relation("EnrollmentHandoffCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sourceImportRow EnrollmentImportRow? @relation("EnrollmentHandoffSourceRow", fields: [sourceImportRowId], references: [id], onDelete: SetNull)
  rowLink         EnrollmentImportRow? @relation("EnrollmentImportRowHandoff")

  @@index([userId, status, expiresAt])
  @@index([sourceImportRowId])
  @@index([status, expiresAt])
  @@map("enrollment_handoffs")
}

model EnrollmentImport {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role               EnrollmentImportRole
  status             EnrollmentImportStatus   @default(draft)
  sourceFilename     String                   @map("source_filename") @db.VarChar(120)
  contentHash        String                   @map("content_hash") @db.Text
  templateVersion    String                   @map("template_version") @db.VarChar(40)
  rowCount           Int                      @map("row_count")
  handoffMethod      EnrollmentHandoffMethod? @map("handoff_method")
  createdByUserId    String                   @map("created_by_user_id") @db.Uuid
  confirmedByUserId  String?                  @map("confirmed_by_user_id") @db.Uuid
  dispatchGeneration Int                      @default(0) @map("dispatch_generation")
  lastErrorCode      String?                  @map("last_error_code") @db.VarChar(80)
  lastErrorMessage   String?                  @map("last_error_message") @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt        DateTime?                @map("confirmed_at") @db.Timestamptz
  startedAt          DateTime?                @map("started_at") @db.Timestamptz
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastHeartbeatAt    DateTime?                @map("last_heartbeat_at") @db.Timestamptz

  createdByUser   User                       @relation("EnrollmentImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser User?                      @relation("EnrollmentImportConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  rows            EnrollmentImportRow[]
  dispatches      EnrollmentImportDispatch[]

  @@index([status, updatedAt])
  @@map("enrollment_imports")
}

model EnrollmentImportRow {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId             String                    @map("import_id") @db.Uuid
  rowNumber            Int                       @map("row_number")
  normalizedEmail      String                    @map("normalized_email") @db.Text
  operation            EnrollmentImportOperation @default(none)
  status               EnrollmentImportRowStatus @default(invalid)
  inputJson            Json                      @map("input_json") @db.JsonB
  matchedUserId        String?                   @map("matched_user_id") @db.Uuid
  matchedUserUpdatedAt DateTime?                 @map("matched_user_updated_at") @db.Timestamptz
  resultUserId         String?                   @map("result_user_id") @db.Uuid
  handoffId            String?                   @unique @map("handoff_id") @db.Uuid
  errorCode            String?                   @map("error_code") @db.VarChar(80)
  errorMessage         String?                   @map("error_message") @db.Text
  attemptCount         Int                       @default(0) @map("attempt_count")
  claimToken           String?                   @map("claim_token") @db.Uuid
  claimExpiresAt       DateTime?                 @map("claim_expires_at") @db.Timestamptz
  claimedBy            String?                   @map("claimed_by") @db.VarChar(120)
  processedAt          DateTime?                 @map("processed_at") @db.Timestamptz
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  import         EnrollmentImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedUser    User?               @relation("EnrollmentImportRowMatchedUser", fields: [matchedUserId], references: [id], onDelete: SetNull)
  resultUser     User?               @relation("EnrollmentImportRowResultUser", fields: [resultUserId], references: [id], onDelete: SetNull)
  handoff        EnrollmentHandoff?  @relation("EnrollmentImportRowHandoff", fields: [handoffId], references: [id], onDelete: SetNull)
  sourceHandoffs EnrollmentHandoff[] @relation("EnrollmentHandoffSourceRow")

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@index([importId, normalizedEmail])
  @@index([claimExpiresAt])
  @@map("enrollment_import_rows")
}

model EnrollmentImportDispatch {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId         String                         @map("import_id") @db.Uuid
  generation       Int
  status           EnrollmentImportDispatchStatus @default(pending)
  queueJobId       String                         @map("queue_job_id") @db.VarChar(200)
  attemptCount     Int                            @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?                      @map("next_attempt_at") @db.Timestamptz
  claimToken       String?                        @map("claim_token") @db.Uuid
  claimExpiresAt   DateTime?                      @map("claim_expires_at") @db.Timestamptz
  claimedBy        String?                        @map("claimed_by") @db.VarChar(120)
  enqueuedAt       DateTime?                      @map("enqueued_at") @db.Timestamptz
  lastErrorCode    String?                        @map("last_error_code") @db.VarChar(80)
  lastErrorMessage String?                        @map("last_error_message") @db.Text
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  import EnrollmentImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, generation])
  @@unique([queueJobId])
  @@index([status, nextAttemptAt, claimExpiresAt])
  @@map("enrollment_import_dispatches")
}

