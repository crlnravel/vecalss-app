// ─────────────────────────────────────────────
// Fraud blocks and the case queue (MS-07). Current state lives in guarded rows;
// every change is also an append-only history row and an audit event.
// ─────────────────────────────────────────────

enum FraudBlockType {
  account
  email
  phone
  device
  ip

  @@map("fraud_block_type")
}

enum FraudBlockSource {
  automatic
  manual

  @@map("fraud_block_source")
}

/// `active` is not the same as in force: a block stops counting at `expires_at`
/// whether or not anything has marked it `expired` yet.
enum FraudBlockStatus {
  active
  lifted
  expired

  @@map("fraud_block_status")
}

enum FraudCaseState {
  open
  acknowledged
  escalated
  closed

  @@map("fraud_case_state")
}

enum FraudSeverity {
  low
  medium
  high
  critical

  @@map("fraud_severity")
}

enum FraudAppealState {
  pending
  granted
  denied

  @@map("fraud_appeal_state")
}

/// A typed block. The identifier is never stored: `lookup_token` is an HMAC of
/// the normalized value under a server secret (for an account block, the user
/// id). `hint` is a masked label for the admin list. Rows are never deleted.
model FraudBlock {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockType          FraudBlockType   @map("block_type")
  lookupToken        String           @map("lookup_token") @db.VarChar(64)
  hint               String           @db.VarChar(80)
  subjectUserId      String?          @map("subject_user_id") @db.Uuid
  source             FraudBlockSource
  reasonCode         String           @map("reason_code") @db.VarChar(40)
  reasonNote         String           @map("reason_note") @db.Text
  ownerUserId        String?          @map("owner_user_id") @db.Uuid
  createdByUserId    String?          @map("created_by_user_id") @db.Uuid
  /// Whether this block disabled the account (and so lifting it reactivates it).
  deactivatedAccount Boolean          @default(false) @map("deactivated_account")
  status             FraudBlockStatus @default(active)
  /// Optimistic version: every change adds one and writes a history row with it.
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  /// Null for blocks that last until lifted.
  expiresAt          DateTime?        @map("expires_at") @db.Timestamptz
  /// When a block with no end date must next be reviewed.
  reviewDueAt        DateTime?        @map("review_due_at") @db.Timestamptz
  endedAt            DateTime?        @map("ended_at") @db.Timestamptz
  lastEventId        String?          @map("last_event_id") @db.Uuid
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz

  subjectUser User?             @relation("FraudBlockSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  owner       User?             @relation("FraudBlockOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("FraudBlockCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  events      FraudBlockEvent[]
  cases       FraudCaseBlock[]
  appeal      FraudAppeal?

  @@index([blockType, lookupToken, status])
  @@index([status, expiresAt])
  @@index([subjectUserId])
  @@map("fraud_blocks")
}

/// Append-only history of a block: created, renewed, lifted, expired.
model FraudBlockEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId       String    @map("block_id") @db.Uuid
  blockVersion  Int       @map("block_version")
  kind          String    @db.VarChar(20)
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  /// `owner` or `system`.
  actorKind     String    @map("actor_kind") @db.VarChar(10)
  reason        String    @db.Text
  fromExpiresAt DateTime? @map("from_expires_at") @db.Timestamptz
  toExpiresAt   DateTime? @map("to_expires_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  block FraudBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  actor User?      @relation("FraudBlockEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([blockId, blockVersion])
  @@map("fraud_block_events")
}

/// One case per signal and subject while it is not closed. Evidence holds ids
/// and counts only, never a raw IP, email, phone or device value.
model FraudCase {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signal         String         @db.VarChar(60)
  /// `order`, `user`, `ip`, `device`, `event`, `block` or `system`.
  subjectType    String         @map("subject_type") @db.VarChar(20)
  /// An id, or a lookup token for ip and device. Never a raw identifier.
  subjectKey     String         @map("subject_key") @db.VarChar(100)
  severity       FraudSeverity
  ruleVersion    Int            @map("rule_version")
  /// The purchase-limit policy version in force when the case opened, if relevant.
  policyVersion  Int?           @map("policy_version")
  state          FraudCaseState @default(open)
  version        Int            @default(1)
  ownerUserId    String?        @map("owner_user_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  orderId        String?        @map("order_id") @db.Uuid
  paymentEventId String?        @map("payment_event_id") @db.Uuid
  evidence       Json           @default("{}") @db.JsonB
  hitCount       Int            @default(1) @map("hit_count")
  openedAt       DateTime       @default(now()) @map("opened_at") @db.Timestamptz
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz
  acknowledgedAt DateTime?      @map("acknowledged_at") @db.Timestamptz
  escalatedAt    DateTime?      @map("escalated_at") @db.Timestamptz
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz
  closureReason  String?        @map("closure_reason") @db.VarChar(40)
  lastEventId    String?        @map("last_event_id") @db.Uuid
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz

  user         User?            @relation("FraudCaseUser", fields: [userId], references: [id], onDelete: Restrict)
  owner        User?            @relation("FraudCaseOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  order        PaymentOrder?    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentEvent PaymentEvent?    @relation(fields: [paymentEventId], references: [id], onDelete: Restrict)
  events       FraudCaseEvent[]
  blocks       FraudCaseBlock[]
  appeals      FraudAppeal[]

  @@index([state, severity, openedAt])
  @@index([signal, openedAt])
  @@map("fraud_cases")
}

/// Append-only history of a case: opened, hit, acknowledged, escalated, closed,
/// reopened, note, block_linked, appeal_filed, appeal_decided, appeal_reopened.
model FraudCaseEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  caseVersion Int      @map("case_version")
  kind        String   @db.VarChar(30)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorKind   String   @map("actor_kind") @db.VarChar(10)
  note        String?  @db.Text
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  case  FraudCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor User?     @relation("FraudCaseEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@map("fraud_case_events")
}

/// Append-only link between a case and a block it led to or concerns.
model FraudCaseBlock {
  caseId         String   @map("case_id") @db.Uuid
  blockId        String   @map("block_id") @db.Uuid
  linkedByUserId String?  @map("linked_by_user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at") @db.Timestamptz

  case     FraudCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  block    FraudBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  linkedBy User?      @relation("FraudCaseBlockLinker", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@id([caseId, blockId])
  @@map("fraud_case_blocks")
}

/// One appeal per block. The owner decides; a denied appeal can be reopened
/// once new evidence arrives. Who did what is in the case's event history.
model FraudAppeal {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockId        String           @unique @map("block_id") @db.Uuid
  caseId         String           @map("case_id") @db.Uuid
  state          FraudAppealState @default(pending)
  channel        String           @db.VarChar(30)
  summary        String           @db.Text
  receivedAt     DateTime         @default(now()) @map("received_at") @db.Timestamptz
  /// Three working days after it was received (Asia/Jakarta, no holiday list).
  dueAt          DateTime         @map("due_at") @db.Timestamptz
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz
  decisionReason String?          @map("decision_reason") @db.Text
  reopenCount    Int              @default(0) @map("reopen_count")
  version        Int              @default(1)

  block FraudBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  case  FraudCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([state, dueAt])
  @@map("fraud_appeals")
}


enum FulfillmentDeliveryStatus {
  pending
  delivered

  @@map("fulfillment_delivery_status")
}

/// The durable receipt of one paid order: what was bought, at what price, under
/// which terms, and whether the access it pays for was actually delivered. It is
/// written in the transaction that accepts the payment, as `pending`. Delivery
/// moves to `delivered` once, when the entitlement is granted (`grantEventId`),
/// and never because money arrived. Rows are never deleted.
model PaymentReceipt {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String                    @unique @map("order_id") @db.Uuid
  buyerId           String                    @map("buyer_id") @db.Uuid
  receiptNumber     String                    @unique @map("receipt_number") @db.VarChar(24)
  packageCode       String                    @map("package_code") @db.VarChar(80)
  packageName       String                    @map("package_name") @db.VarChar(220)
  plan              String                    @db.VarChar(20)
  pricingMonth      String                    @map("pricing_month") @db.VarChar(7)
  amountRupiah      Int                       @map("amount_rupiah")
  currency          String                    @default("IDR") @db.VarChar(3)
  termsVersion      String                    @map("terms_version") @db.VarChar(40)
  providerPaymentId String?                   @map("provider_payment_id") @db.VarChar(160)
  paidAt            DateTime                  @map("paid_at") @db.Timestamptz
  deliveryStatus    FulfillmentDeliveryStatus @default(pending) @map("delivery_status")
  /// Why the last grant attempt did not deliver, while delivery is pending.
  pendingReason     String?                   @map("pending_reason") @db.VarChar(60)
  accessPlanCode    String?                   @map("access_plan_code") @db.VarChar(80)
  grantEventId      String?                   @unique @map("grant_event_id") @db.Uuid
  validFrom         DateTime?                 @map("valid_from") @db.Timestamptz
  validUntil        DateTime?                 @map("valid_until") @db.Timestamptz
  grantedAt         DateTime?                 @map("granted_at") @db.Timestamptz
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  order      PaymentOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  buyer      User                 @relation("PaymentReceiptBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  grantEvent BillingAccessEvent?  @relation(fields: [grantEventId], references: [id], onDelete: Restrict)
  deliveries ReceiptDelivery[]

  @@index([deliveryStatus, paidAt])
  @@map("payment_receipts")
}

/// One attempt to tell the buyer about a receipt, and what came of it. The
/// in-app record counts as delivery evidence (G5); the email is the second
/// channel. At most one `sent` row per receipt and channel. Append-only.
model ReceiptDelivery {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId         String   @map("receipt_id") @db.Uuid
  channel           String   @db.VarChar(10)
  outcome           String   @db.VarChar(10)
  /// A short code: a mail failure reason, or why a channel was skipped.
  detail            String?  @db.VarChar(120)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(160)
  notificationId    String?  @map("notification_id") @db.Uuid
  attemptedAt       DateTime @default(now()) @map("attempted_at") @db.Timestamptz

  receipt PaymentReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([receiptId, attemptedAt])
  @@map("receipt_deliveries")
}

/// Real use of a paid surface: at most one row per grant per Asia/Jakarta day,
/// written when the paid-access check passes for a student whose access came
/// from a payment. Never created any other way. Append-only.
model FulfillmentUsageEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantEventId String   @map("grant_event_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  jakartaDay   DateTime @map("jakarta_day") @db.Date
  firstUsedAt  DateTime @default(now()) @map("first_used_at") @db.Timestamptz

  grantEvent BillingAccessEvent @relation(fields: [grantEventId], references: [id], onDelete: Restrict)
  order      PaymentOrder       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  student    User               @relation("FulfillmentUsageStudent", fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([grantEventId, jakartaDay])
  @@index([orderId, jakartaDay])
  @@map("fulfillment_usage_events")
}

/// The log of every dispute export, and the short-lived packet behind its
/// one-use link. The packet is dropped when the link is used or expires; the
/// row, its reason and its digest stay. Rows are never deleted.
model DisputeExport {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  requestedById  String    @map("requested_by_id") @db.Uuid
  reason         String    @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  /// SHA-256 of the one-use download token; the token itself is never stored.
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  digestSha256   String    @map("digest_sha256") @db.VarChar(64)
  packetBytes    Int       @map("packet_bytes")
  packet         String?   @db.Text
  downloadedAt   DateTime? @map("downloaded_at") @db.Timestamptz
  packetPurgedAt DateTime? @map("packet_purged_at") @db.Timestamptz

  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy User         @relation("DisputeExportRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("dispute_exports")
}
