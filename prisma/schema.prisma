/// Unified account table. Credential fields folded directly here to eliminate auth_identities table bloat.
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique
  fullName           String     @map("full_name") @db.VarChar(160)
  passwordHash       String     @map("password_hash") @db.Text
  passwordUpdatedAt  DateTime?  @map("password_updated_at") @db.Timestamptz
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  /// Non-null only for managed system subjects such as the admin student
  /// preview fixture. The value is unique so a purpose can never be claimed
  /// by more than one account.
  previewPurpose     String?    @unique @map("preview_purpose") @db.VarChar(80)
  avatarUrl          String?    @map("avatar_url") @db.Text
  phone              String?    @db.VarChar(40)
  status             UserStatus @default(active)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz
  softDeletedAt      DateTime?  @map("soft_deleted_at") @db.Timestamptz
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  authSessions                           AuthSession[]
  passwordResetTokens                    PasswordResetToken[]
  loginAttempts                          LoginAttempt[]
  roleAssignments                        RoleAssignment[]                     @relation("UserRoles")
  assignedRolesBy                        RoleAssignment[]                     @relation("RolesAssignedBy")
  mentorReports                          MentorReport[]
  studentProfile                         StudentProfile?                      @relation("StudentProfileAccount")
  enrolledStudents                       StudentProfile[]                     @relation("EnrolledBy")
  tutorProfile                           TutorProfile?
  kaptenVideos                           KaptenVideo[]                        @relation("KaptenVideoAuthor")
  createdModules                         Module[]                             @relation("ModuleCreatedBy")
  updatedModules                         Module[]                             @relation("ModuleUpdatedBy")
  moduleProgressions                     ModuleProgress[]
  createdQuestionBanks                   QuestionBank[]                       @relation("QuestionBankCreatedBy")
  updatedQuestionBanks                   QuestionBank[]                       @relation("QuestionBankUpdatedBy")
  questionBankMediaFolderReservations    QuestionBankMediaFolderReservation[] @relation("QuestionBankMediaFolderReservationOwner")
  questionBankXlsxImportAttempts         QuestionBankXlsxImportAttempt[]      @relation("QuestionBankXlsxImportAttemptOwner")
  createdQuestionBankFolders             QuestionBankFolder[]                 @relation("QuestionBankFolderCreatedBy")
  updatedQuestionBankFolders             QuestionBankFolder[]                 @relation("QuestionBankFolderUpdatedBy")
  createdQuestionBankCategories          QuestionBankCategory[]               @relation("QuestionBankCategoryCreatedBy")
  updatedQuestionBankCategories          QuestionBankCategory[]               @relation("QuestionBankCategoryUpdatedBy")
  assignedQuestionBankCategories         QuestionBankCategoryAssignment[]     @relation("QuestionBankCategoryAssignedBy")
  createdQuestions                       Question[]                           @relation("QuestionCreatedBy")
  updatedQuestions                       Question[]                           @relation("QuestionUpdatedBy")
  authoredQuestionRevisions              QuestionRevision[]                   @relation("QuestionRevisionCreatedBy")
  modifiedQuestionRevisions              QuestionRevision[]                   @relation("QuestionRevisionUpdatedBy")
  authoredStandaloneQuizzes              StandaloneQuiz[]                     @relation("StandaloneQuizAuthor")
  publishedStandaloneQuizVersions        StandaloneQuizVersion[]              @relation("StandaloneQuizVersionPublishedBy")
  standaloneQuizParticipations           StandaloneQuizParticipation[]
  standaloneQuizStartCommands            StandaloneQuizStartCommand[]
  quizAttempts                           QuizAttempt[]
  createdTryoutPackages                  TryoutPackage[]                      @relation("TryoutCreatedBy")
  assessmentReleasesCreated              AssessmentRelease[]                  @relation("AssessmentReleaseCreatedBy")
  createdReusableQuestionPackages        ReusableQuestionPackage[]            @relation("ReusableQuestionPackageCreatedBy")
  updatedReusableQuestionPackages        ReusableQuestionPackage[]            @relation("ReusableQuestionPackageUpdatedBy")
  createdReusableQuestionPackageVersions ReusableQuestionPackageVersion[]     @relation("ReusableQuestionPackageVersionCreatedBy")
  tryoutAttempts                         TryoutAttempt[]
  tryoutAdmissions                       TryoutAdmission[]
  tryoutDeliveryAssignmentsCreated       TryoutDeliveryAssignment[]           @relation("TryoutAssignmentCreatedBy")
  tryoutDeliverySessionsCreated          TryoutDeliverySession[]              @relation("TryoutDeliverySessionCreatedBy")
  tryoutDeliverySessionsUpdated          TryoutDeliverySession[]              @relation("TryoutDeliverySessionUpdatedBy")
  tryoutDeliverySessionsReleased         TryoutDeliverySession[]              @relation("TryoutDeliverySessionReleasedBy")
  tryoutDeliveryAudits                   TryoutDeliveryAudit[]
  topicPerformances                      StudentTopicPerformance[]
  subtestPerformances                    StudentSubtestPerformance[]
  learningRecommendations                LearningRecommendation[]
  analyticsEvents                        AnalyticsEvent[]
  missionAssignments                     DailyMissionAssignment[]
  streakFreezes                          StreakFreeze[]
  badges                                 StudentBadge[]
  weaknessAnalyses                       WeaknessAnalysis[]
  ptnStrategySessions                    PtnStrategySession[]
  uploadedAssets                         Asset[]                              @relation("UploadedBy")
  createdMediaFolders                    MediaFolder[]                        @relation("MediaFolderCreatedBy")
  createdAnnouncements                   Announcement[]                       @relation("AnnouncementCreatedBy")
  updatedAnnouncements                   Announcement[]                       @relation("AnnouncementUpdatedBy")
  updatedLandingSections                 LandingPageSection[]                 @relation("LandingSectionUpdatedBy")
  cohortMemberships                      CohortStudent[]
  assignedTutorCohorts                   TutorCohortAssignment[]              @relation("TutorAssigned")
  assignedCohortsBy                      TutorCohortAssignment[]              @relation("CohortAssignedBy")
  riskFlags                              RiskFlag[]
  tutorInterventions                     Intervention[]                       @relation("TutorIntervention")
  studentInterventions                   Intervention[]                       @relation("StudentIntervention")
  notificationPreferences                NotificationPreference?
  notificationsReceived                  Notification[]
  billingAccounts                        BillingAccount[]                     @relation("StudentBilling")
  extendedBillingAccounts                BillingAccount[]                     @relation("BillingExtendedBy")
  affiliatorProfile                      AffiliatorProfile?
  packagePurchases                       PackagePurchase[]                    @relation("PackagePurchaseStudent")
  checkoutIntents                        CheckoutIntent[]
  mfaFactor                              UserMfaFactor?                       @relation("UserMfaFactor")
  mfaSetupCodes                          MfaSetupCode[]                       @relation("UserMfaSetupCodes")
  mfaFailedAttempts                      MfaFailedAttempt[]                   @relation("UserMfaFailedAttempts")
  updatedSystemConfigs                   SystemConfig[]                       @relation("SystemConfigUpdatedBy")
  draftUpdatedSystemConfigs              SystemConfig[]                       @relation("SystemConfigDraftUpdatedBy")
  publishedSystemConfigs                 SystemConfig[]                       @relation("SystemConfigPublishedBy")
  auditLogs                              AuditLog[]
  enrollmentHandoffs                     EnrollmentHandoff[]                  @relation("EnrollmentHandoffUser")
  createdEnrollmentHandoffs              EnrollmentHandoff[]                  @relation("EnrollmentHandoffCreatedBy")
  createdEnrollmentImports               EnrollmentImport[]                   @relation("EnrollmentImportCreatedBy")
  confirmedEnrollmentImports             EnrollmentImport[]                   @relation("EnrollmentImportConfirmedBy")
  matchedEnrollmentImportRows            EnrollmentImportRow[]                @relation("EnrollmentImportRowMatchedUser")
  resultEnrollmentImportRows             EnrollmentImportRow[]                @relation("EnrollmentImportRowResultUser")
  editLeases                             EditLease[]
  veraConversations                      VeraConversation[]                   @relation("VeraConversations")
  veraUsageEvents                        VeraUsageEvent[]                     @relation("VeraUsageEvents")
  veraStudioDocuments                    VeraStudioDocument[]                 @relation("VeraStudioDocuments")

  @@index([fullName, id], map: "users_directory_full_name_id_idx")
  @@index([createdAt, id], map: "users_directory_created_at_id_idx")
  @@index([status, fullName, id], map: "users_directory_status_full_name_id_idx")
  @@map("users")
}

model AuthSession {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  refreshTokenHash String        @map("refresh_token_hash") @db.Text
  status           SessionStatus @default(active)
  issuedAt         DateTime      @default(now()) @map("issued_at") @db.Timestamptz
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz
  lastSeenAt       DateTime?     @map("last_seen_at") @db.Timestamptz
  ipAddress        String?       @map("ip_address") @db.Inet
  userAgent        String?       @map("user_agent") @db.Text
  /// Set from database time when this session last passed a second-factor
  /// check. Privileged roles count only while it is recent and was recorded
  /// under the factor that is still enrolled (see lib/auth/mfa).
  mfaVerifiedAt    DateTime?     @map("mfa_verified_at") @db.Timestamptz
  mfaFactorId      String?       @map("mfa_factor_id") @db.Uuid

  user      User           @relation(fields: [userId], references: [id])
  mfaFactor UserMfaFactor? @relation(fields: [mfaFactorId], references: [id], onDelete: SetNull)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([mfaFactorId])
  @@map("auth_sessions")
}

/// One authenticator-app factor per privileged account (admin, developer). The
/// secret is stored only as an AES-256-GCM envelope bound to the owner. A row
/// with no `confirmedAt` is an enrollment in progress and never authorizes
/// anything; it belongs to the session that presented the setup code.
model UserMfaFactor {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  secretEnvelope   Json      @map("secret_envelope") @db.JsonB
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz
  /// Last accepted 30-second step. A code is accepted only for a later step,
  /// and the update is atomic, so one code can never pass twice.
  lastAcceptedStep Int?      @map("last_accepted_step")
  pendingSessionId String?   @map("pending_session_id") @db.Uuid
  setupCodeId      String?   @unique @map("setup_code_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User              @relation("UserMfaFactor", fields: [userId], references: [id], onDelete: Cascade)
  setupCode     MfaSetupCode?     @relation(fields: [setupCodeId], references: [id], onDelete: SetNull)
  recoveryCodes MfaRecoveryCode[]
  sessions      AuthSession[]

  @@map("user_mfa_factors")
}

/// One-use recovery code, stored as a SHA-256 hash and consumed atomically.
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  factorId  String    @map("factor_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  factor UserMfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@unique([factorId, codeHash])
  @@map("mfa_recovery_codes")
}

/// Short-lived, one-use code issued by the operator script (never by a web
/// route). Enrollment of a factor requires it, so a stolen password alone
/// cannot enroll one.
model MfaSetupCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  issuedBy  String    @map("issued_by") @db.VarChar(160)
  reason    String    @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user   User           @relation("UserMfaSetupCodes", fields: [userId], references: [id], onDelete: Cascade)
  factor UserMfaFactor?

  @@index([userId, createdAt])
  @@map("mfa_setup_codes")
}

/// Failed challenge, recovery-code and setup-code attempts, counted per
/// account in Postgres so the limit holds even when Redis is unavailable.
model MfaFailedAttempt {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  kind       String   @db.VarChar(20)
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  user User @relation("UserMfaFailedAttempts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, occurredAt])
  @@map("mfa_failed_attempts")
}

model EditLease {
  resourceType EditLeaseResourceType @map("resource_type")
  resourceId   String                @map("resource_id") @db.VarChar(128)
  holderUserId String                @map("holder_user_id") @db.Uuid
  tokenDigest  String                @map("token_digest") @db.VarChar(64)
  generation   Int
  acquiredAt   DateTime              @map("acquired_at") @db.Timestamptz
  heartbeatAt  DateTime              @map("heartbeat_at") @db.Timestamptz
  expiresAt    DateTime              @map("expires_at") @db.Timestamptz
  releasedAt   DateTime?             @map("released_at") @db.Timestamptz

  holder User @relation(fields: [holderUserId], references: [id], onDelete: Cascade)

  @@id([resourceType, resourceId])
  @@index([expiresAt])
  @@index([holderUserId])
  @@index([releasedAt, expiresAt])
  @@map("edit_leases")
}

/// Handles self-service resets and first-login credential overrides.
model PasswordResetToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Text
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz
  ipAddress   String?   @map("ip_address") @db.Inet

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

/// One row per password reset request that was let through. It feeds the
/// per-email and per-address limits; the email is kept only as a hash.
model PasswordResetRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emailHash   String   @map("email_hash") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.Inet
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz

  @@index([emailHash, requestedAt])
  @@index([ipAddress, requestedAt])
  @@index([requestedAt])
  @@map("password_reset_requests")
}

model LoginAttempt {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @db.Text // Note: maps logically to citext compatibility
  userId        String?            @map("user_id") @db.Uuid
  result        LoginAttemptResult
  failureReason String?            @map("failure_reason") @db.Text
  attemptedAt   DateTime           @default(now()) @map("attempted_at") @db.Timestamptz
  ipAddress     String?            @map("ip_address") @db.Inet
  userAgent     String?            @map("user_agent") @db.Text

  user User? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([attemptedAt])
  @@map("login_attempts")
}

model RoleAssignment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  role             RoleName
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  assignedAt       DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz

