  moduleId             String         @map("module_id") @db.Uuid
  status               ProgressStatus @default(locked)
  percentComplete      Decimal        @default(0) @map("percent_complete") @db.Decimal(5, 2)
  videoPositionSeconds Int            @default(0) @map("video_position_seconds")
  scrollPosition       Int            @default(0) @map("scroll_position")
  unlockedAt           DateTime?      @map("unlocked_at") @db.Timestamptz
  completedAt          DateTime?      @map("completed_at") @db.Timestamptz
  lastOpenedAt         DateTime?      @map("last_opened_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student User   @relation(fields: [studentId], references: [id])
  module  Module @relation(fields: [moduleId], references: [id])

  @@unique([studentId, moduleId])
  @@index([status])
  @@map("module_progress")
}

