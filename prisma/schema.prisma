  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  packageVersion ReusableQuestionPackageVersion @relation(fields: [packageVersionId], references: [id], onDelete: Cascade)
  questionBank   QuestionBank                   @relation(fields: [questionBankId], references: [id], onDelete: Restrict)

  @@id([packageVersionId, questionBankId])
  @@index([questionBankId, packageVersionId])
  @@map("reusable_question_package_version_bank_scopes")
}

model ReusableQuestionPackageVersionFolderScope {
  packageVersionId String   @map("package_version_id") @db.Uuid
