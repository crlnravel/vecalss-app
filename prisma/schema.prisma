  confirmedByUserId  String?                  @map("confirmed_by_user_id") @db.Uuid
  dispatchGeneration Int                      @default(0) @map("dispatch_generation")
  lastErrorCode      String?                  @map("last_error_code") @db.VarChar(80)
  lastErrorMessage   String?                  @map("last_error_message") @db.Text
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  confirmedAt        DateTime?                @map("confirmed_at") @db.Timestamptz
  startedAt          DateTime?                @map("started_at") @db.Timestamptz
  completedAt        DateTime?                @map("completed_at") @db.Timestamptz
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  lastHeartbeatAt    DateTime?                @map("last_heartbeat_at") @db.Timestamptz

  createdByUser   User                       @relation("EnrollmentImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser User?                      @relation("EnrollmentImportConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  rows            EnrollmentImportRow[]
  dispatches      EnrollmentImportDispatch[]

  @@index([status, updatedAt])
  @@map("enrollment_imports")
}

model EnrollmentImportRow {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId             String                    @map("import_id") @db.Uuid
  rowNumber            Int                       @map("row_number")
  normalizedEmail      String                    @map("normalized_email") @db.Text
  operation            EnrollmentImportOperation @default(none)
  status               EnrollmentImportRowStatus @default(invalid)
  inputJson            Json                      @map("input_json") @db.JsonB
  matchedUserId        String?                   @map("matched_user_id") @db.Uuid
  matchedUserUpdatedAt DateTime?                 @map("matched_user_updated_at") @db.Timestamptz
  resultUserId         String?                   @map("result_user_id") @db.Uuid
  handoffId            String?                   @unique @map("handoff_id") @db.Uuid
  errorCode            String?                   @map("error_code") @db.VarChar(80)
  errorMessage         String?                   @map("error_message") @db.Text
  attemptCount         Int                       @default(0) @map("attempt_count")
  claimToken           String?                   @map("claim_token") @db.Uuid
  claimExpiresAt       DateTime?                 @map("claim_expires_at") @db.Timestamptz
  claimedBy            String?                   @map("claimed_by") @db.VarChar(120)
  processedAt          DateTime?                 @map("processed_at") @db.Timestamptz
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  import         EnrollmentImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedUser    User?               @relation("EnrollmentImportRowMatchedUser", fields: [matchedUserId], references: [id], onDelete: SetNull)
