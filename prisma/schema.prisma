model StudentProfile {
  userId             String           @id @map("user_id") @db.Uuid
  displayName        String?          @map("display_name") @db.VarChar(120)
  onboardingStatus   OnboardingStatus @default(not_started) @map("onboarding_status")
  targetExamEventId  String?          @map("target_exam_event_id") @db.Uuid
  targetUniversityId String?          @map("target_university_id") @db.Uuid
  targetMajorId      String?          @map("target_major_id") @db.Uuid
  currentStreak      Int              @default(0) @map("current_streak")
  longestStreak      Int              @default(0) @map("longest_streak")
  lastStreakDate     DateTime?        @map("last_streak_date") @db.Date
  dailyAiTokenLimit  Int              @default(10000) @map("daily_ai_token_limit")
  timezone           String           @default("Asia/Jakarta") @db.VarChar(64)
  enrolledByUserId   String?          @map("enrolled_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
