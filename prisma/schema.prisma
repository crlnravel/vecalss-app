  updatedBy   User                       @relation("TryoutDeliverySessionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  releasedBy  User?                      @relation("TryoutDeliverySessionReleasedBy", fields: [releasedByUserId], references: [id], onDelete: Restrict)
