  veraSchemaHash   String?  @map("vera_schema_hash") @db.VarChar(128)
  tryoutSessionIds Json?    @map("tryout_session_ids") @db.JsonB
  fallbackUsed     Boolean  @default(false) @map("fallback_used")
  generatedAt      DateTime @default(now()) @map("generated_at") @db.Timestamptz

  student User                    @relation(fields: [studentId], references: [id])
  topics  WeaknessAnalysisTopic[]

  @@index([studentId])
  @@index([generatedAt])
  @@map("weakness_analyses")
}

