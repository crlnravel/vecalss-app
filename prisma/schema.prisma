  sourceHandoffs EnrollmentHandoff[] @relation("EnrollmentHandoffSourceRow")

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@index([importId, normalizedEmail])
  @@index([claimExpiresAt])
  @@map("enrollment_import_rows")
}

model EnrollmentImportDispatch {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId         String                         @map("import_id") @db.Uuid
  generation       Int
  status           EnrollmentImportDispatchStatus @default(pending)
  queueJobId       String                         @map("queue_job_id") @db.VarChar(200)
  attemptCount     Int                            @default(0) @map("attempt_count")
  nextAttemptAt    DateTime?                      @map("next_attempt_at") @db.Timestamptz
  claimToken       String?                        @map("claim_token") @db.Uuid
  claimExpiresAt   DateTime?                      @map("claim_expires_at") @db.Timestamptz
  claimedBy        String?                        @map("claimed_by") @db.VarChar(120)
  enqueuedAt       DateTime?                      @map("enqueued_at") @db.Timestamptz
  lastErrorCode    String?                        @map("last_error_code") @db.VarChar(80)
  lastErrorMessage String?                        @map("last_error_message") @db.Text
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz
