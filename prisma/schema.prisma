// ─────────────────────────────────────────────

/// Envelope DEK wrapping records. The wrapped key material is encrypted by a
/// deployment-provided KMS/root-key provider; plaintext DEKs never persist.
/// Destroying one key only tombstones that keyRef and cannot affect sibling
/// envelopes sharing a caller namespace.

/// Durable learner export package. The operation row is the lifecycle source
/// of truth; this row stores materialization and one-time access state.

/// One server-executed automatic-context call. Arguments and the returned
/// manifest are envelope ciphertexts; digests and bounded aggregates remain
/// available for replay/audit without exposing learner content.

/// Versioned, encrypted local selector trace. A real Respan selector is a
/// network attempt; deterministic fixtures never enter runtime admission.

// ─────────────────────────────────────────────
// CMS & ANNOUNCEMENTS (Unified Banners)
// ─────────────────────────────────────────────

model Asset {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
