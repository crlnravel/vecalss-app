/// code snapshot for historical reporting.
model AffiliatorProfile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  referralCode String   @unique @map("referral_code") @db.VarChar(40)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  packagePurchases PackagePurchase[]

  @@index([isActive, referralCode])
  @@map("affiliator_profiles")
}

enum PackagePurchaseStatus {
  pending
  succeeded
  failed
  refunded
  cancelled

  @@map("package_purchase_status")
}

/// First-party package purchase evidence. Package fields and the referral
/// code are snapshots because catalogues and codes can change later.
model PackagePurchase {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId            String                @map("student_id") @db.Uuid
  packageCode          String                @map("package_code") @db.VarChar(80)
  packageName          String                @map("package_name") @db.VarChar(220)
  status               PackagePurchaseStatus @default(pending)
  affiliatorProfileId  String?               @map("affiliator_profile_id") @db.Uuid
  referralCodeSnapshot String?               @map("referral_code_snapshot") @db.VarChar(40)
  providerReference    String                @unique @map("provider_reference") @db.VarChar(160)
  completedAt          DateTime?             @map("completed_at") @db.Timestamptz
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  student           User               @relation("PackagePurchaseStudent", fields: [studentId], references: [id], onDelete: Restrict)
  affiliatorProfile AffiliatorProfile? @relation(fields: [affiliatorProfileId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([affiliatorProfileId, status, completedAt])
  @@index([status, completedAt])
  @@map("package_purchases")
}

/// A buyer's server-recorded request to start checkout. The quote (month and
/// rupiah amount) is a snapshot taken at submission, and the referral is the
/// normalized active code. `idempotencyKey` is minted when the checkout page
/// renders, so a retried submission reuses one row. Rendering and GET/HEAD
/// never write here. It is not an order: it holds no reservation and no
/// provider session.
model CheckoutIntent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyerId        String   @map("buyer_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  plan           String   @db.VarChar(20)
  pricingMonth   String   @map("pricing_month") @db.VarChar(7)
  amountRupiah   Int      @map("amount_rupiah")
  referralCode   String?  @map("referral_code") @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// A retry may reuse this intent (and its quote) only before this time;
  /// afterwards the buyer must confirm the current price on a fresh page.
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt])
  @@map("checkout_intents")
}

model SystemConfig {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configKey            String    @unique @map("config_key") @db.VarChar(120)
  configValue          Json      @map("config_value") @db.JsonB
  updatedByUserId      String?   @map("updated_by_user_id") @db.Uuid
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  draftValue           Json?     @map("draft_value") @db.JsonB
  draftUpdatedByUserId String?   @map("draft_updated_by_user_id") @db.Uuid
  draftUpdatedAt       DateTime? @map("draft_updated_at") @db.Timestamptz
  publishedByUserId    String?   @map("published_by_user_id") @db.Uuid
  publishedAt          DateTime? @map("published_at") @db.Timestamptz

  updatedBy      User? @relation("SystemConfigUpdatedBy", fields: [updatedByUserId], references: [id])
  draftUpdatedBy User? @relation("SystemConfigDraftUpdatedBy", fields: [draftUpdatedByUserId], references: [id])
  publishedBy    User? @relation("SystemConfigPublishedBy", fields: [publishedByUserId], references: [id])

  @@map("system_configs")
}

model AuditLog {
  /// Audit rows are append-only. The database migration rejects UPDATE,
  /// DELETE, and TRUNCATE so historical evidence cannot be rewritten.
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  targetType  String?  @map("target_type") @db.VarChar(80)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent") @db.Text
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorUserId])
  @@index([action])
  @@index([occurredAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Vera AI (OpenAI rebuild). Usage is recorded per answer, credits follow tokens.
// ─────────────────────────────────────────────

enum VeraMessageRole {
  user
  assistant

  @@map("vera_message_role")
}

enum VeraUsageKind {
  chat
  studio
  title

  @@map("vera_usage_kind")
}

enum VeraUsageStatus {
  reserved
  settled
  released
  failed

  @@map("vera_usage_status")
}

enum VeraEffort {
  cepat
  seimbang
  mendalam

  @@map("vera_effort")
}

enum VeraStudioTool {
  weakness_analysis
  study_route
  wrong_answer_review

  @@map("vera_studio_tool")
}

model VeraConversation {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String        @map("student_id") @db.Uuid
  title      String        @default("Sesi baru") @db.VarChar(120)
  archivedAt DateTime?     @map("archived_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  student    User          @relation("VeraConversations", fields: [studentId], references: [id], onDelete: Cascade)
  messages   VeraMessage[]

  @@index([studentId, updatedAt])
  @@map("vera_conversations")
}

model VeraMessage {
  id             String           @id @db.VarChar(64)
  conversationId String           @map("conversation_id") @db.Uuid
  role           VeraMessageRole
  parts          Json
  mentions       Json?
  sources        Json?
  effort         VeraEffort?
  credits        Decimal?         @db.Decimal(6, 1)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  conversation   VeraConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("vera_messages")
}

model VeraUsageEvent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  kind              VeraUsageKind
  status            VeraUsageStatus @default(reserved)
  effort            VeraEffort?
  model             String          @db.VarChar(80)
  conversationId    String?         @map("conversation_id") @db.Uuid
  messageId         String?         @map("message_id") @db.VarChar(64)
  studioDocumentId  String?         @map("studio_document_id") @db.Uuid
  reservedCredits   Decimal         @map("reserved_credits") @db.Decimal(6, 1)
  credits           Decimal         @default(0) @db.Decimal(6, 1)
  costUsdMicros     BigInt          @default(0) @map("cost_usd_micros")
  reservedUsdMicros BigInt          @map("reserved_usd_micros")
  inputTokens       Int             @default(0) @map("input_tokens")
  cachedInputTokens Int             @default(0) @map("cached_input_tokens")
  outputTokens      Int             @default(0) @map("output_tokens")
  reasoningTokens   Int             @default(0) @map("reasoning_tokens")
  steps             Int             @default(0)
  errorCode         String?         @map("error_code") @db.VarChar(60)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  settledAt         DateTime?       @map("settled_at") @db.Timestamptz
  student           User            @relation("VeraUsageEvents", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([createdAt])
  @@map("vera_usage_events")
}

model VeraStudioDocument {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  tool      VeraStudioTool
  title     String         @db.VarChar(160)
  markdown  String         @db.Text
  sources   Json?
  input     Json?
  credits   Decimal        @default(0) @db.Decimal(6, 1)
  // False for a document whose run was cut off or failed after some text: it is kept, and the card says so.
  complete  Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  student   User           @relation("VeraStudioDocuments", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("vera_studio_documents")
}

model VeraMateriText {
  moduleAssetId String   @id @map("module_asset_id") @db.Uuid
  moduleId      String   @map("module_id") @db.Uuid
  digest        String   @db.VarChar(64)
  text          String   @db.Text
  extractedAt   DateTime @default(now()) @map("extracted_at") @db.Timestamptz

  @@index([moduleId])
  @@map("vera_materi_texts")
}
