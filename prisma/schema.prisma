  questionRevisionPromptAssets                QuestionRevision[]                         @relation("QuestionRevisionPromptAsset")
  questionRevisionExplanationAssets           QuestionRevision[]                         @relation("QuestionRevisionExplanationAsset")
  questionRevisionOptionAssets                QuestionRevisionOption[]                   @relation("QuestionRevisionOptionAsset")
  questionBankXlsxImportAttemptAssets         QuestionBankXlsxImportAttemptAsset[]       @relation("QuestionBankXlsxImportAttemptAsset")
  standaloneQuizItemPromptAssets              StandaloneQuizItem[]                       @relation("StandaloneQuizItemPromptAsset")
  standaloneQuizItemExplanationAssets         StandaloneQuizItem[]                       @relation("StandaloneQuizItemExplanationAsset")
  standaloneQuizItemOptionAssets              StandaloneQuizItemOption[]                 @relation("StandaloneQuizItemOptionAsset")
