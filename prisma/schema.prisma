// Standalone quizzes authored by tutors. These are intentionally independent
// from ModuleQuiz, which remains the one-to-one assessment for a learning module.
model StandaloneQuiz {
  id                       String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String                                @unique @db.VarChar(240)
  title                    String                                @db.VarChar(220)
  description              String?                               @db.Text
  subtestId                String                                @map("subtest_id") @db.Uuid
  sourceBankId             String?                               @map("source_bank_id") @db.Uuid
  status                   ContentStatus                         @default(published)
  isHidden                 Boolean                               @default(false) @map("is_hidden")
  opensAt                  DateTime?                             @map("opens_at") @db.Timestamptz
  closesAt                 DateTime?                             @map("closes_at") @db.Timestamptz
  durationSeconds          Int?                                  @map("duration_seconds")
  attemptsAllowed          Int?                                  @default(1) @map("attempts_allowed")
  scorePolicy              StandaloneQuizScorePolicy             @default(latest) @map("score_policy")
  retryDelaySeconds        Int?                                  @map("retry_delay_seconds")
  formBehavior             StandaloneQuizFormBehavior            @default(same) @map("form_behavior")
  reviewTiming             StandaloneQuizReviewTiming            @default(immediate) @map("review_timing")
  correctAnswerVisibility  StandaloneQuizCorrectAnswerVisibility @default(show) @map("correct_answer_visibility")
  assemblyMode             ReusableQuestionPackageMode?          @map("assembly_mode")
  assemblyPackageVersionId String?                               @map("assembly_package_version_id") @db.Uuid
  assemblyDefinitionDigest String?                               @map("assembly_definition_digest") @db.VarChar(128)
  assemblySeed             String?                               @map("assembly_seed") @db.VarChar(128)
  revision                 Int                                   @default(1)
  idempotencyKey           String?                               @unique @map("idempotency_key") @db.VarChar(120)
