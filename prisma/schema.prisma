  reusablePackageVersionItemExplanationAssets ReusableQuestionPackageVersionItem[]       @relation("ReusablePackageVersionItemExplanationAsset")
  reusablePackageVersionItemOptionAssets      ReusableQuestionPackageVersionItemOption[] @relation("ReusablePackageVersionItemOptionAsset")
  moduleAssets                                ModuleAsset[]                              @relation("ModuleAssetManagedAsset")
