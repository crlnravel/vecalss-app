{
  "name": "vecalss-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "prepare": "node scripts/install-git-hooks.mjs",
    "tokens": "node design-tokens/generate-theme.mjs",
    "dev": "pnpm tokens && next dev",
    "db:generate": "prisma generate",
    "build": "pnpm db:generate && pnpm tokens && next build",
    "start": "next start",
    "db:seed": "node prisma/seed.mjs",
    "db:seed-materi": "node prisma/seed-materi.mjs",
    "db:test-materi-ordering": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.materi-ordering.json scripts/test-materi-ordering.ts",
    "db:verify-materi": "node scripts/verify-materi-catalogue.mjs",
    "db:verify-materi-cutover": "node scripts/verify-materi-catalogue.mjs",
    "verify": "pnpm lint && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
