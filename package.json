{
  "name": "vecalss-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "lint": "eslint",
    "prepare": "node scripts/install-git-hooks.mjs",
    "tokens": "node design-tokens/generate-theme.mjs",
    "dev": "pnpm tokens && next dev --port 5023",
    "db:generate": "prisma generate",
    "build": "pnpm db:generate && pnpm tokens && next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "pnpm db:reset && node prisma/seed.mjs",
    "db:seed-materi": "node prisma/seed-materi.mjs",
    "db:apply-materi-reset": "node prisma/seed-materi.mjs --apply",
    "db:seed-assessment": "node prisma/seed-assessment.mjs",
    "admin:imports-worker": "tsx workers/admin-import-worker.ts",
    "admin:imports-worker:check": "pnpm exec tsc --noEmit -p tsconfig.worker.json",
    "admin:imports-worker:smoke": "tsx scripts/admin-import-worker-smoke.ts",
    "test:admin-import-worker-flap": "tsx scripts/test-admin-import-worker-flap.ts",
    "test:admin-import-worker-readiness": "tsx scripts/test-admin-import-worker-readiness.ts",
    "db:verify-demo": "node scripts/verify-demo-seed.mjs",
    "db:test-materi-ordering": "NODE_OPTIONS=--conditions=react-server tsx --tsconfig tsconfig.materi-ordering.json scripts/test-materi-ordering.ts",
    "test:materi-resource-contract": "tsx scripts/test-materi-resource-contract.ts",
    "test:materi-course-progress": "tsx scripts/test-materi-course-progress.ts",
    "test:materi-progress-server": "tsx scripts/test-materi-progress-server.ts",
    "test:materi-lock-boundary": "tsx scripts/test-materi-lock-boundary.ts",
    "test:materi-builder-validation": "tsx scripts/test-materi-builder-validation.ts",
    "test:media-domain": "tsx scripts/test-media-domain.ts",
    "test:student-banner-validation": "tsx scripts/test-student-banner-validation.ts",
    "test:admin-handoff-envelope": "tsx scripts/test-admin-handoff-envelope.ts",
    "test:admin-handoff-foundation": "tsx scripts/test-admin-handoff-foundation.ts",
    "test:admin-enrollment": "tsx scripts/test-admin-enrollment-contract.ts",
    "test:admin-operations": "tsx scripts/test-admin-operations-contract.ts",
    "test:admin-operations-fixups": "tsx scripts/test-admin-operations-fixups-contract.ts",
    "test:notifications-db": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-notifications-db.ts",
    "test:admin-import-preview": "tsx scripts/test-admin-import-preview.ts",
    "test:admin-import-preview-db": "tsx scripts/test-admin-import-preview-db.ts",
    "test:admin-import-dispatch": "tsx scripts/test-admin-import-dispatch.ts",
    "test:admin-import-dispatch-db": "tsx scripts/test-admin-import-dispatch-db.ts",
    "test:admin-import-processing": "tsx scripts/test-admin-import-processing.ts",
    "test:admin-import-processing-db": "tsx scripts/test-admin-import-processing-db.ts",
    "test:admin-import-ui": "tsx scripts/test-admin-import-ui.ts",
    "test:admin-invite-rate-limit": "NODE_ENV=test NODE_OPTIONS=--conditions=react-server tsx scripts/test-admin-invite-rate-limit.ts",
    "test:scalability": "node scripts/run-two-api-redis-simulation.mjs",
    "test:admin-invite-route": "NODE_OPTIONS=--conditions=react-server tsx scripts/test-admin-invite-route.ts",
    "test:tryout-package-invariants": "node scripts/test-tryout-package-invariants.mjs",
    "test:tryout-release-invariants": "node scripts/test-tryout-release-invariants.mjs",
    "test:tryout-scoring": "tsx scripts/test-tryout-scoring.ts",
    "db:verify-materi": "node scripts/verify-materi-catalogue.mjs",
    "db:verify-materi-cutover": "node scripts/verify-materi-catalogue.mjs",
    "test:materi-demo-reset": "node scripts/test-materi-demo-reset.mjs",
    "db:guard-assessment-prototype-reset": "node scripts/guard-assessment-prototype-reset.mjs",
    "db:apply-assessment-prototype-reset": "node scripts/guard-assessment-prototype-reset.mjs --apply",
    "test:guard-assessment-prototype-reset": "node scripts/test-guard-assessment-prototype-reset.mjs",
    "test:guard-assessment-prototype-reset-concurrency": "node scripts/test-guard-assessment-prototype-reset-concurrency.mjs",
    "test:guard-assessment-prototype-reset-prelock": "node scripts/test-guard-assessment-prototype-reset-concurrency.mjs pre",
    "test:guard-assessment-prototype-reset-postlock": "node scripts/test-guard-assessment-prototype-reset-concurrency.mjs post",
    "verify": "pnpm lint && pnpm build",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@base-ui/react": "^1.5.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/view": "^6.43.8",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-table": "^9.1.0",
    "@types/mdx": "^2.0.14",
    "@uiw/react-codemirror": "^4.25.11",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "next": "16.2.9",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-pdf": "10.4.1",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
