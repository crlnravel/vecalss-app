DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:3000

# Optional local-only account switcher in the avatar menu. It is disabled by
# default and only works when NODE_ENV=development and DEBUG=true.
# DEBUG=true

# Multi-instance deployments must use one shared 16/24/32-byte base64 key for
# Next Server Actions. The scalability compose harness supplies a local test
# key automatically.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# The web process and `pnpm admin:imports-worker` are independently
# restartable processes. For each release, install production dependencies,
# generate Prisma, run `prisma migrate deploy` once, then start web and worker.
# The web security limiter and worker both require the shared REDIS_URL; they
# fail closed when Redis is unavailable. The worker also requires DATABASE_URL,
# APP_BASE_URL, and the handoff key ring; secrets are never placed in payloads.

# Optional, dedicated target for `pnpm test:admin-invite-rate-limit`. The test
# skips when this is absent, never falls back to REDIS_URL, and uses a random
# key namespace. Non-local targets additionally require
# ADMIN_INVITE_RATE_LIMIT_TEST_REDIS_DISPOSABLE=1.
# ADMIN_INVITE_RATE_LIMIT_TEST_REDIS_URL=redis://127.0.0.1:6379/15
# ADMIN_INVITE_RATE_LIMIT_TEST_REDIS_DISPOSABLE=1

# `pnpm test:scalability` generates this per-run when it is absent. Direct
# docker compose use requires an explicit non-default value of at least 32
# characters.
# SCALABILITY_SIMULATION_SECRET=

# JSON map of key IDs to base64-encoded 32-byte AES-GCM keys. The active key
# is used for new handoff envelopes; older keys remain for decrypt-only
# rotation until no unreleased envelope references them.
ENROLLMENT_HANDOFF_KEY_RING={"local-v1":""}
ENROLLMENT_HANDOFF_ACTIVE_KEY_ID=local-v1

# Optional local Materi demo fixture origin/path overrides. The default route
# is /api/materi-demo/test.pdf and reads the supplied tmp/test.pdf fixture.
MATERI_DEMO_PDF_BASE_URL=http://localhost:5023
MATERI_DEMO_PDF_URL=

# Private Cloudflare R2 credentials. Never expose these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
