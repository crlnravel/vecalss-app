DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
APP_BASE_URL=http://localhost:3000

# The web process and `pnpm admin:imports-worker` are independently
# restartable processes. For each release, install production dependencies,
# generate Prisma, run `prisma migrate deploy` once, then start web and worker.
# The worker fails closed unless DATABASE_URL, REDIS_URL, APP_BASE_URL, and the
# handoff key ring are all present; secrets are never placed in queue payloads.

# JSON map of key IDs to base64-encoded 32-byte AES-GCM keys. The active key
# is used for new handoff envelopes; older keys remain for decrypt-only
# rotation until no unreleased envelope references them.
ENROLLMENT_HANDOFF_KEY_RING={"local-v1":""}
ENROLLMENT_HANDOFF_ACTIVE_KEY_ID=local-v1

# Optional local Materi demo fixture origin/path overrides. The default route
# is /api/materi-demo/test.pdf and reads the supplied tmp/test.pdf fixture.
MATERI_DEMO_PDF_BASE_URL=http://localhost:5023
MATERI_DEMO_PDF_URL=

# Private Cloudflare R2 credentials. Never expose these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
