# =============================================================================
# PTN Pro – Environment Variables
# =============================================================================
# Copy this file to .env and .env.local, then fill in the values.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://vecalss:vecalss@127.0.0.1:55432/vecalss_dev?schema=public
REDIS_URL=redis://127.0.0.1:56379/0
APP_BASE_URL=http://localhost:5023

# ---------------------------------------------------------------------------
# Debug & Feature Flags
# ---------------------------------------------------------------------------

# Local-only account switcher in the avatar menu.
# Only works when NODE_ENV=development and DEBUG=true.
# DEBUG=true

# Admin-only student preview toggle.
# Enabled by default after the managed preview fixture is seeded.
# ADMIN_STUDENT_PREVIEW_ENABLED=true

# Optional server log threshold: debug, info, warn, error, or off.
# Defaults to debug outside production and error in production.
# APP_LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Auth / Encryption
# ---------------------------------------------------------------------------

# Multi-instance deployments must use one shared 16/24/32-byte base64 key for
# Next Server Actions. The scalability compose harness supplies a local test
# key automatically.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Number of reverse proxies in front of the app that append to
# X-Forwarded-For. The sign-in throttle and login audit trail only trust the
# client address that many entries from the right; with 0 (the default) the
# header is ignored. Vercel is detected automatically (1 hop).
# TRUSTED_PROXY_COUNT=1

# JSON map of key IDs → base64-encoded 32-byte AES-GCM keys.
# The active key is used for new handoff envelopes; older keys remain for
# decrypt-only rotation until no unreleased envelope references them.
ENROLLMENT_HANDOFF_KEY_RING={"local-v1":""}
ENROLLMENT_HANDOFF_ACTIVE_KEY_ID=local-v1

# Two-step verification for admin and developer accounts. Same shape as the
# handoff key ring above but a separate key: it seals each account's
# authenticator secret (AES-256-GCM, bound to the account). Generate a key with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without a usable key ring, admin and developer access stays closed (it never
# falls back to password-only). To rotate, add a new key ID, point
# MFA_ACTIVE_KEY_ID at it and keep the old key until no secret uses it.
# There is no setting that turns this off. Local seeded accounts also need it:
# see docs/agent-app-testing-guide.md.
MFA_KEY_RING={"local-v1":""}
MFA_ACTIVE_KEY_ID=local-v1

# ---------------------------------------------------------------------------
# Materi Demo Fixtures
# ---------------------------------------------------------------------------
MATERI_DEMO_PDF_URL=http://localhost:5023/api/materi-demo/test.pdf
MATERI_ALLOW_LOCAL_PDF_URL=1
MATERI_SEED_TUTOR_EMAIL=tutor@vecalss.local

# Affiliator demo seed (the dashboard reads durable package purchase evidence)
SEED_AFFILIATOR_EMAIL=affiliator@vecalss.local
SEED_AFFILIATOR_CODE=SALSA2027
# Shared secret for the first-party checkout success webhook. Keep this
# server-only; the signed event is the only writer for successful purchases.
AFFILIATOR_PURCHASE_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Cloudflare R2 (private – never expose with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_TOKEN_VALUE=

# Exact HTTPS hostnames allowed for retained legacy URL-only banner images.
# Leave empty to disable remote URL delivery; managed R2 images do not use this.
BANNER_TRUSTED_IMAGE_HOSTS=

# ---------------------------------------------------------------------------
# Vera – Disposable Test Targets
# ---------------------------------------------------------------------------
# Dedicated database & Redis for guarded integration tests.
# VERA_DISPOSABLE_DATABASE_URL=postgresql://vecalss:vecalss@127.0.0.1:55432/vera_test?schema=public
# VERA_DISPOSABLE_REDIS_URL=redis://127.0.0.1:56379/15
# VERA_DISPOSABLE_DB_ACK=1

# ---------------------------------------------------------------------------
# Vera AI – OpenAI (server-only, never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Without a key, Vera shows an unavailable state instead of crashing.
# OPENAI_API_KEY=
# VERA_OPENAI_MODEL=gpt-6-luna
# USD per 1M tokens. Reasoning tokens bill as output. Confirm against OpenAI pricing at deploy time.
# VERA_PRICE_INPUT_USD_PER_M=0.10
# VERA_PRICE_CACHED_INPUT_USD_PER_M=0.01
# VERA_PRICE_OUTPUT_USD_PER_M=0.50

# ---------------------------------------------------------------------------
# Obscura – Headless Browser Engine (Automated / Playwright Testing)
# ---------------------------------------------------------------------------
# Default CDP WebSocket endpoint for Playwright tests and automated checks.
# OBSCURA_WS_ENDPOINT=ws://127.0.0.1:9222
# OBSCURA_PORT=9222
# OBSCURA_ALLOW_PRIVATE_NETWORK=1

# Pricing page checkout. The checkout service origin and the package codes are
# not defaulted: leave them empty and /pricing shows prices with purchase
# disabled. Each code must be a package code the purchase webhook can resolve.
CHECKOUT_BASE_URL=
PRICING_PACKAGE_CODE_MONTHLY=
PRICING_PACKAGE_CODE_FULL_UTBK=
PRICING_PACKAGE_CODE_FULL_MANDIRI=

# ---------------------------------------------------------------------------
# Email (Resend) – password reset
# ---------------------------------------------------------------------------
# RESEND_API_KEY should be a send-only key. EMAIL_FROM must be an address on a
# domain verified in the Resend dashboard (for example
# "Vecalss <no-reply@vecalss.id>"); until then production sends are rejected and
# logged, and the user still sees the normal message. Never commit real values.
RESEND_API_KEY=
EMAIL_FROM=
# Optional reply-to address.
# EMAIL_REPLY_TO=
# Outside production, mail is only sent when this is set, and every message then
# goes to this address instead of the real recipient (the subject names the
# intended one). Resend's test inbox "delivered@resend.dev" works with the
# default "onboarding@resend.dev" sender. Ignored in production.
# EMAIL_DEV_REDIRECT=delivered@resend.dev

# ---------------------------------------------------------------------------
# Paid access (built, switched off)
# ---------------------------------------------------------------------------
# When on (1, true, on or yes), students need running paid access to use the
# learning pages and actions; others see a "not in your package" page. Anything
# else, including a typo or an empty value, leaves everything open as it is
# today. Admins grant access on the student page either way.
PAID_ACCESS_ENFORCED=
# The last day of Full Access for each exam target, as YYYY-MM-DD (Jakarta
# time). Deliberately not defaulted: these are product decisions. Until they are
# set, the Full Access plans cannot be granted.
FULL_ACCESS_ENDS_ON_UTBK=
FULL_ACCESS_ENDS_ON_MANDIRI=
