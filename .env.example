# =============================================================================
# Vecalss – Environment Variables
# =============================================================================
# Copy this file to .env and .env.local, then fill in the values.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://vecalss:vecalss@127.0.0.1:55432/vecalss_dev?schema=public
REDIS_URL=redis://127.0.0.1:56379/0
APP_BASE_URL=http://localhost:5023

# ---------------------------------------------------------------------------
# Debug & Feature Flags
# ---------------------------------------------------------------------------

# Local-only account switcher in the avatar menu.
# Only works when NODE_ENV=development and DEBUG=true.
# DEBUG=true

# Admin-only student preview toggle.
# Enabled by default after the managed preview fixture is seeded.
# ADMIN_STUDENT_PREVIEW_ENABLED=true

# ---------------------------------------------------------------------------
# Auth / Encryption
# ---------------------------------------------------------------------------

# Multi-instance deployments must use one shared 16/24/32-byte base64 key for
# Next Server Actions. The scalability compose harness supplies a local test
# key automatically.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# JSON map of key IDs → base64-encoded 32-byte AES-GCM keys.
# The active key is used for new handoff envelopes; older keys remain for
# decrypt-only rotation until no unreleased envelope references them.
ENROLLMENT_HANDOFF_KEY_RING={"local-v1":""}
ENROLLMENT_HANDOFF_ACTIVE_KEY_ID=local-v1

# ---------------------------------------------------------------------------
# Materi Demo Fixtures
# ---------------------------------------------------------------------------
MATERI_DEMO_PDF_URL=http://localhost:5023/api/materi-demo/test.pdf
MATERI_ALLOW_LOCAL_PDF_URL=1
MATERI_SEED_TUTOR_EMAIL=tutor@vecalss.local

# Affiliator demo seed (the dashboard reads durable package purchase evidence)
SEED_AFFILIATOR_EMAIL=affiliator@vecalss.local
SEED_AFFILIATOR_CODE=SALSA2027
# Shared secret for the first-party checkout success webhook. Keep this
# server-only; the signed event is the only writer for successful purchases.
AFFILIATOR_PURCHASE_WEBHOOK_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Cloudflare R2 (private – never expose with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_TOKEN_VALUE=

# Exact HTTPS hostnames allowed for retained legacy URL-only banner images.
# Leave empty to disable remote URL delivery; managed R2 images do not use this.
BANNER_TRUSTED_IMAGE_HOSTS=

# ---------------------------------------------------------------------------
# Vera – Disposable Test Targets
# ---------------------------------------------------------------------------
# Dedicated database & Redis for guarded integration tests.
# VERA_DISPOSABLE_DATABASE_URL=postgresql://vecalss:vecalss@127.0.0.1:55432/vera_test?schema=public
# VERA_DISPOSABLE_REDIS_URL=redis://127.0.0.1:56379/15
# VERA_DISPOSABLE_DB_ACK=1
